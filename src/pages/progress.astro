---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import { getCollection } from 'astro:content';
import { getNav, getQuestionBank } from '../lib/learn';
import { getExam } from '../data/exams';
const exam = getExam();

const nav = await getNav();
const published = nav.filter((t) => t.published);
const moduleKeys = Object.fromEntries(exam.modules.map((m) => [m.slug, published.filter((t) => t.module.slug === m.slug).map((t) => t.key)]));
const topics = published.map((t) => ({ key: t.key, title: t.title, url: t.url, module: t.module.slug }));
const entries = await getCollection('tutorials', (e) => e.id.startsWith(`${exam.slug}/`));
const bank = (await getQuestionBank(exam.slug)).map((q) => ({ id: q.id, domain: q.domain, topic: q.topic }));
const lessons = published.map((t) => ({ key: t.key, title: t.title, url: t.url, domain: t.module.domain, minutes: entries.find((e) => e.id === t.key)?.data.readingMinutes ?? 8 }));
const weights = Object.fromEntries(exam.modules.map((m) => [m.domain, m.weightMid]));
const payload = JSON.stringify({ moduleKeys, topics, modules: exam.modules.map((m) => ({ slug: m.slug, title: m.shortTitle, domain: m.domain })), cert: exam.slug, bank, lessons, weights }).replace(/</g, '\\u003c');
---
<Base breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'My progress', url: '/progress/' }]} title="My Progress | MSDEVBUILD Azure" description="Your AZ-900 learning progress, knowledge-check scores, mock exam history and achievement badges, saved privately in your browser." noindex>
  <script type="application/json" id="pg-data" set:html={payload} />
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="flex flex-wrap items-center gap-4">
      <Mascot size={72} mood="cheer" />
      <div>
        <p class="eyebrow">Your learning journey</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight">My progress</h1>
      </div>
    </div>
    <p class="mt-3 text-sm text-muted">Saved only in this browser. No account and no tracking. Clearing site data or switching device starts fresh.</p>

    <section class="band-navy mt-8 rounded-2xl p-5 sm:p-6" aria-label="Level">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="text-2xl font-bold"><span id="pg-lv-icon"></span> <span id="pg-lv-name"></span></p>
        <p class="text-lg"><strong id="pg-xp">0</strong> XP · 🔥 <strong id="pg-streak">0</strong>-day streak</p>
      </div>
      <div class="bar mt-3 !border-white/20 !bg-white/10"><span id="pg-lv-bar" style="width:0;background:#ffd75e"></span></div>
      <p id="pg-lv-next" class="mt-1.5 text-sm text-white/75"></p>
    </section>

    <section class="mt-4 grid gap-4 sm:grid-cols-3" aria-label="Summary">
      <div class="card p-5"><p class="text-sm text-muted">Topics completed</p><p class="text-3xl font-bold" id="pg-done">0</p><div class="bar mt-2"><span id="pg-done-bar" style="width:0"></span></div></div>
      <div class="card p-5"><p class="text-sm text-muted">Knowledge checks taken</p><p class="text-3xl font-bold" id="pg-quiz">0</p></div>
      <div class="card p-5"><p class="text-sm text-muted">Best mock exam</p><p class="text-3xl font-bold" id="pg-mock">–</p></div>
    </section>

    <section class="mt-4 grid gap-4 md:grid-cols-2" aria-label="Readiness and today's plan">
      <a href={`/${exam.slug}/practice/`} class="card card-link p-5">
        <p class="text-sm text-muted">{exam.code} exam readiness</p>
        <p class="text-3xl font-bold"><span id="pg-ready">0</span>% <span id="pg-ready-l" class="text-base font-semibold"></span></p>
        <div class="bar mt-2"><span id="pg-ready-bar" style="width:0"></span></div>
        <p class="mt-2 text-sm"><span id="pg-due">0</span> reviews due today · <span class="font-semibold text-accent">Smart practice ❯</span></p>
      </a>
      <a href={`/${exam.slug}/study-plan/`} class="card card-link p-5">
        <p class="text-sm text-muted">📅 Today's plan</p>
        <ul id="pg-today" class="mt-2 space-y-1 text-sm"><li class="text-muted">No study plan yet. Pick your exam date and get a day-by-day schedule.</li></ul>
        <p class="mt-2 text-sm font-semibold text-accent" id="pg-plan-cta">Make my plan ❯</p>
      </a>
    </section>

    <a id="pg-cert" href="/certificate/" class="mt-4 flex flex-wrap items-center gap-4 rounded-2xl border-2 border-[#ffb900] bg-[var(--pastel-yellow)] p-5 hover:ring-2 hover:ring-[var(--accent)]">
      <span id="pg-cert-badge" class="w-16 shrink-0" aria-hidden="true"></span>
      <span class="min-w-0 flex-1"><span id="pg-cert-t" class="block text-lg font-bold">AZ-900 Ready certificate</span><span id="pg-cert-s" class="block text-sm">Pass the full mock exam (≈ 700/1000) to earn a free, shareable certificate.</span></span>
      <span class="nav-btn shrink-0" id="pg-cert-cta">Get it »</span>
    </a>

    <section class="mt-10" aria-labelledby="badges-h">
      <h2 id="badges-h" class="text-xl font-bold">Achievement badges</h2>
      <div id="pg-badges" class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></div>
    </section>

    <section class="mt-10" aria-labelledby="topics-h">
      <h2 id="topics-h" class="text-xl font-bold">Topics</h2>
      <div id="pg-topics" class="mt-4 space-y-6"></div>
    </section>

    <section class="mt-10" aria-labelledby="mocks-h">
      <h2 id="mocks-h" class="text-xl font-bold">Mock exam history</h2>
      <div id="pg-mocks" class="mt-4 space-y-2 text-sm"></div>
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/az-900/games/" class="btn btn-accent">🎮 Play &amp; Learn</a>
      <a href="/az-900/revision/" class="btn btn-outline">Revision flashcards</a>
      <button type="button" id="pg-reset" class="btn btn-outline">Reset my progress</button>
    </div>
  </div>
</Base>
<script>
  import { load, badges, reset, levelFor, streak, today } from '../lib/progress';
  import { loadCert, bestFullMock, badgeSvg } from '../lib/certificate';
  import { readiness } from '../lib/review';
  import { loadPlan, buildSchedule } from '../lib/plan';
  const data = JSON.parse(document.getElementById('pg-data')!.textContent!) as {
    cert: string; bank: { id: string; domain: number; topic?: string }[]; weights: Record<number, number>;
    lessons: { key: string; title: string; url: string; minutes: number; domain: number }[];
    moduleKeys: Record<string, string[]>; topics: { key: string; title: string; url: string; module: string }[]; modules: { slug: string; title: string; domain: number }[];
  };
  const $ = (id: string) => document.getElementById(id)!;
  const paint = () => {
    const s = load();
    const lv = levelFor(s.xp);
    $('pg-lv-icon').textContent = lv.icon;
    $('pg-lv-name').textContent = `Level ${lv.level}: ${lv.name}`;
    $('pg-xp').textContent = String(s.xp);
    $('pg-streak').textContent = String(streak(s));
    ($('pg-lv-bar') as HTMLElement).style.width = `${lv.pct}%`;
    $('pg-lv-next').textContent = lv.next ? `${lv.next.min - s.xp} XP to ${lv.next.icon} ${lv.next.name}` : 'Top level reached. Legendary!';
    const done = data.topics.filter((t) => s.done[t.key]).length;
    $('pg-done').textContent = `${done} / ${data.topics.length}`;
    ($('pg-done-bar') as HTMLElement).style.width = `${data.topics.length ? (done / data.topics.length) * 100 : 0}%`;
    $('pg-quiz').textContent = String(Object.keys(s.quizzes).length);
    {
      const r = readiness(data.cert, data.bank, data.weights, s.mocks);
      $('pg-ready').textContent = String(r.percent);
      $('pg-ready-l').textContent = r.label;
      ($('pg-ready-bar') as HTMLElement).style.width = `${r.percent}%`;
      $('pg-due').textContent = String(r.due);
      const plan = loadPlan(data.cert);
      if (plan) {
        const days = buildSchedule(plan, data.lessons, new Set(Object.keys(s.done)), `/${data.cert}/`).days;
        const day = days.find((d) => d.date === today());
        const esc = (x: string) => x.replace(/&/g, '&amp;').replace(/</g, '&lt;');
        $('pg-today').innerHTML = !day && days[0] ? `<li class="text-muted">A day off today. Next study day: ${new Date(`${days[0].date}T00:00:00`).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}.</li>` : day ? day.items.map((it) => `<li>${it.kind === 'lesson' && s.done[it.key!] ? '✅' : '•'} ${esc(it.title)}${it.minutes ? ` <span class="text-muted">(${it.minutes} min)</span>` : ''}</li>`).join('') : '<li class="text-muted">Your exam date has passed. Set a new one.</li>';
        $('pg-plan-cta').textContent = 'Open my plan ❯';
      }
    }
    $('pg-mock').textContent = s.mocks.length ? `${Math.max(...s.mocks.map((m) => m.percent))}%` : '–';
    {
      const cert = loadCert();
      const best = bestFullMock(s.mocks);
      $('pg-cert-badge').innerHTML = badgeSvg(64);
      $('pg-cert-badge').style.filter = cert || best ? '' : 'grayscale(1) opacity(.5)';
      if (cert) { $('pg-cert-t').textContent = `🏆 ${cert.name} is AZ-900 Ready`; $('pg-cert-s').textContent = `${cert.percent}% · ${cert.id}. View, download or share it.`; $('pg-cert-cta').textContent = 'View »'; }
      else if (best) { $('pg-cert-t').textContent = '🎉 You earned the AZ-900 Ready certificate'; $('pg-cert-s').textContent = 'Add your name and claim it.'; $('pg-cert-cta').textContent = 'Claim »'; }
    }
    $('pg-badges').innerHTML = badges(s, data.moduleKeys).map((b) =>
      `<div class="badge-tile card p-4 text-center" data-earned="${b.earned}"><p class="text-3xl" aria-hidden="true">${b.icon}</p><p class="mt-2 font-semibold">${b.title}</p><p class="text-xs text-muted">${b.text}</p><p class="mt-1 text-xs font-semibold ${b.earned ? 'verdict-ok' : 'text-muted'}">${b.earned ? 'Earned' : 'Locked'}</p></div>`).join('');
    $('pg-topics').innerHTML = data.modules.map((m) => {
      const ts = data.topics.filter((t) => t.module === m.slug);
      if (!ts.length) return `<div><p class="font-semibold">Domain ${m.domain}: ${m.title}</p><p class="text-sm text-muted">Tutorials coming soon.</p></div>`;
      return `<div><p class="font-semibold">Domain ${m.domain}: ${m.title}</p><ul class="mt-2 grid gap-2 sm:grid-cols-2">${ts.map((t) => {
        const q = s.quizzes[t.key];
        return `<li><a href="${t.url}" class="flex items-center gap-3 rounded-xl border border-default bg-[var(--card)] px-3 py-2 text-sm hover:border-[var(--accent)]"><span>${s.done[t.key] ? '✅' : '⬜'}</span><span class="flex-1">${t.title}</span>${q ? `<span class="chip">${q.score}/${q.total}</span>` : ''}</a></li>`;
      }).join('')}</ul></div>`;
    }).join('');
    $('pg-mocks').innerHTML = s.mocks.length
      ? s.mocks.map((m) => `<div class="flex flex-wrap items-center gap-3 rounded-xl border border-default bg-[var(--card)] px-3 py-2"><span class="font-semibold">${m.percent}%</span><span class="text-muted">${m.score}/${m.total} · ${m.mode} · ${new Date(m.at).toLocaleString()}</span></div>`).join('')
      : '<p class="text-muted">No mock exams yet. <a class="text-accent underline" href="/az-900/mock-exam/">Take one now</a>.</p>';
  };
  paint();
  window.addEventListener('progress-change', paint);
  $('pg-reset').addEventListener('click', () => { if (confirm('Reset all progress, scores and badges in this browser?')) reset(); });
</script>
