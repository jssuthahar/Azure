---
import GameLayout from '../../../layouts/GameLayout.astro';
import { SORT_SETS } from '../../../data/az-900/games';
import { getNav } from '../../../lib/learn';

const nav = await getNav();
const sets = SORT_SETS.map((s) => ({ ...s, topicUrl: nav.find((t) => t.slug === s.topic && t.published)?.url }));
const payload = JSON.stringify(sets).replace(/</g, '\\u003c');
---
<GameLayout title="Sort It!" seoTitle="Sort It! AZ-900 Cloud Sorting Game | MSDEVBUILD" description="A fun AZ-900 sorting game: tap each card into IaaS, PaaS or SaaS, CapEx or OpEx, public, private or hybrid, and more. Instant feedback and XP." icon="🗂️" intro="Tap the bucket where each card belongs. Get them all right for a perfect round!">
  <script type="application/json" id="sort-data" set:html={payload} />

  <section id="pick">
    <h2 class="text-xl font-semibold">Choose a round</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {sets.map((s, i) => (
        <button type="button" data-set={i} class="card card-link flex items-center gap-4 p-4 text-left">
          <span class="text-4xl" aria-hidden="true">{s.icon}</span>
          <span><span class="block text-lg font-semibold">{s.title}</span><span class="block text-sm text-muted">{s.items.length} cards · {s.buckets.length} buckets</span></span>
        </button>
      ))}
    </div>
  </section>

  <section id="play" class="hidden" aria-live="polite">
    <div class="flex items-center justify-between text-sm">
      <p id="round-title" class="font-semibold"></p>
      <p><span id="card-n"></span> · Score <strong id="score">0</strong> <span id="combo" class="ml-1"></span></p>
    </div>
    <div class="bar mt-2"><span id="progress" style="width:0"></span></div>

    <div id="card" class="mx-auto mt-8 flex min-h-[9rem] max-w-xl items-center justify-center rounded-2xl border-2 border-[var(--accent)] bg-[var(--card)] p-6 text-center text-2xl font-semibold shadow-md"></div>
    <p id="feedback" class="mx-auto mt-4 min-h-[3rem] max-w-xl text-center text-lg"></p>

    <div id="buckets" class="mx-auto mt-4 grid max-w-2xl gap-3"></div>
  </section>

  <section id="done" class="hidden text-center">
    <p id="done-emoji" class="text-7xl"></p>
    <h2 id="done-title" class="mt-3 text-3xl font-bold"></h2>
    <p id="done-text" class="mt-2 text-lg text-muted"></p>
    <ul id="done-missed" class="mx-auto mt-6 max-w-xl space-y-2 text-left"></ul>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button type="button" id="again" class="big-btn">Play again</button>
      <button type="button" id="other" class="big-btn big-btn-light">Choose another round</button>
      <a id="revise" class="big-btn big-btn-light hidden">Revise the lesson</a>
    </div>
  </section>
</GameLayout>
<script>
  import { shuffle, confetti } from '../../../lib/fun';
  import { saveGame } from '../../../lib/progress';
  type Set = { title: string; icon: string; buckets: string[]; items: { text: string; bucket: number; why: string }[]; topicUrl?: string };
  const sets: Set[] = JSON.parse(document.getElementById('sort-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const colors = ['#0078d4', '#107c10', '#8764b8', '#ca5010'];
  let set: Set, idx = 0, items: Set['items'] = [], score = 0, combo = 0, mistakes: Set['items'] = [], busy = false, setIndex = 0;

  const show = (id: string) => ['pick', 'play', 'done'].forEach((s) => $(s).classList.toggle('hidden', s !== id));

  function start(i: number) {
    setIndex = i;
    set = sets[i];
    items = shuffle(set.items);
    idx = 0; score = 0; combo = 0; mistakes = [];
    $('round-title').textContent = `${set.icon} ${set.title}`;
    const b = $('buckets');
    b.className = `mx-auto mt-4 grid max-w-2xl gap-3 ${set.buckets.length === 2 ? 'grid-cols-2' : set.buckets.length === 3 ? 'grid-cols-3' : 'grid-cols-2 sm:grid-cols-4'}`;
    b.innerHTML = set.buckets.map((name, bi) => `<button type="button" data-b="${bi}" class="rounded-xl px-3 py-5 text-lg font-bold text-white shadow transition-transform active:scale-95" style="background:${colors[bi]}">${name}</button>`).join('');
    show('play');
    next();
  }

  function next() {
    busy = false;
    if (idx >= items.length) return finish();
    $('card').textContent = items[idx].text;
    $('card').style.borderColor = 'var(--accent)';
    $('feedback').innerHTML = '';
    $('card-n').textContent = `Card ${idx + 1} of ${items.length}`;
    ($('progress') as HTMLElement).style.width = `${(idx / items.length) * 100}%`;
    $('score').textContent = String(score);
    $('combo').textContent = combo >= 2 ? `🔥 x${combo}` : '';
  }

  $('buckets').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-b]');
    if (!btn || busy) return;
    busy = true;
    const it = items[idx];
    const ok = Number(btn.dataset.b) === it.bucket;
    const card = $('card');
    if (ok) {
      combo++;
      score += 10 + (combo >= 3 ? 5 : 0);
      card.style.borderColor = 'var(--ok)';
      $('feedback').innerHTML = `<span class="font-bold verdict-ok">✓ Correct!</span> ${it.why}`;
    } else {
      combo = 0;
      mistakes.push(it);
      card.style.borderColor = 'var(--bad)';
      card.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(-10px)' }, { transform: 'translateX(10px)' }, { transform: 'translateX(0)' }], { duration: 300 });
      $('feedback').innerHTML = `<span class="font-bold verdict-bad">✕ It's ${set.buckets[it.bucket]}.</span> ${it.why}`;
    }
    $('score').textContent = String(score);
    idx++;
    setTimeout(next, ok ? 1100 : 2200);
  });

  function finish() {
    const perfect = mistakes.length === 0;
    const best = saveGame('sort', score, Math.round(score / 2), { perfectSort: perfect });
    show('done');
    $('done-emoji').textContent = perfect ? '🏆' : mistakes.length <= 2 ? '🎉' : '💪';
    $('done-title').textContent = perfect ? 'Perfect round!' : `${items.length - mistakes.length} of ${items.length} correct`;
    $('done-text').textContent = `Score ${score}${best ? ' · New personal best!' : ''}`;
    $('done-missed').innerHTML = mistakes.map((m) => `<li class="rounded-lg bg-[var(--pastel-yellow)] px-4 py-2.5"><strong>${m.text}</strong> → ${set.buckets[m.bucket]}<br><span class="text-sm">${m.why}</span></li>`).join('');
    const rev = $('revise') as HTMLAnchorElement;
    rev.classList.toggle('hidden', !set.topicUrl || perfect);
    if (set.topicUrl) rev.href = set.topicUrl;
    if (perfect) confetti();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-set]').forEach((b) => b.addEventListener('click', () => start(Number(b.dataset.set))));
  $('again').addEventListener('click', () => start(setIndex));
  $('other').addEventListener('click', () => show('pick'));
</script>
