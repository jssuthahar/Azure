---
import Base from '../../../layouts/Base.astro';
import Mascot from '../../../components/Mascot.astro';
import { LABS, SANDBOX } from '../../../lib/sim/labs';
const bands = ['band-blue', 'band-green', 'band-yellow', 'band-lilac'];
---
<Base title="Azure Practice Labs: Free Simulator, No Account | MSDEVBUILD" description="Practise Azure hands-on in a free simulator: create resource groups, VMs, storage and web apps in a mock portal and Cloud Shell. No Azure account needed." breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'AZ-900', url: '/az-900/' }, { name: 'Practice labs', url: '/az-900/labs/' }]}>
  <section class="band-navy px-4 py-12 sm:py-16">
    <div class="mx-auto grid max-w-6xl items-center gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div class="text-center lg:text-left">
        <p class="text-sm font-bold tracking-widest text-[#ffd75e] uppercase">Try it yourself</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight sm:text-6xl">Azure Practice Labs</h1>
        <p class="mt-4 text-lg text-white/90">A safe, simulated Azure portal and Cloud Shell right in your browser. Click through real-looking screens, type real Azure CLI commands, and learn by doing.</p>
        <ul class="mt-5 flex flex-wrap justify-center gap-2 text-sm lg:justify-start">
          {['✅ No Azure account', '✅ No credit card', '✅ Nothing to install', '✅ Zero cost, zero risk'].map((t) => <li class="rounded-full bg-white/10 px-3 py-1">{t}</li>)}
        </ul>
        <div class="mt-7 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href={`/az-900/labs/${LABS[0].id}/`} class="big-btn !bg-[#ffd75e] !text-[#0b1020]">Start lab 1 ❯</a>
          <a href="/az-900/labs/sandbox/" class="big-btn big-btn-light">🎛️ Free sandbox</a>
        </div>
      </div>
      <div class="rounded-2xl bg-[#0b1020] p-4 font-mono text-[0.8rem] leading-relaxed text-[#e6edf3] shadow-2xl">
        <p class="text-[#8fcbf7]">Azure Cloud Shell (practice)</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> az group create -n rg-learn -l westeurope</p>
        <p class="text-white/80">{'{ "name": "rg-learn", "location": "westeurope",'}<br />{'  "properties": { "provisioningState": "Succeeded" } }'}</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> az vm create -g rg-learn -n web01 --image Ubuntu2204</p>
        <p class="text-white/80">{'{ "powerState": "VM running", "publicIpAddress": "20.61.8.42" }'}</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> <span class="animate-pulse">▌</span></p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex items-center gap-3"><Mascot size={52} /><h2 class="text-2xl font-bold">Guided labs</h2></div>
    <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {LABS.map((l, i) => (
        <a href={`/az-900/labs/${l.id}/`} class={`${bands[i % bands.length]} group flex flex-col rounded-2xl p-6 transition-transform hover:-translate-y-1`} data-lab={l.id}>
          <div class="flex items-start justify-between"><span class="text-5xl transition-transform group-hover:scale-110" aria-hidden="true">{l.icon}</span><span class="lab-done hidden rounded-full bg-[var(--ok)] px-2.5 py-1 text-xs font-bold text-white">✓ Done</span></div>
          <p class="mt-3 text-xs font-bold tracking-wide uppercase text-muted">Lab {i + 1} · {l.level} · ⏱ {l.minutes} min · {l.start === 'shell' ? '⌨️ Cloud Shell' : '🖥️ Portal'}</p>
          <h3 class="mt-1 text-xl font-bold">{l.title}</h3>
          <p class="mt-1.5 flex-1 text-[0.95rem] leading-relaxed">{l.intro}</p>
          <span class="nav-btn mt-5 self-start">Start lab ❯</span>
        </a>
      ))}
      <a href="/az-900/labs/sandbox/" class="flex flex-col rounded-2xl border-2 border-dashed border-default p-6 hover:border-[var(--accent)]">
        <span class="text-5xl" aria-hidden="true">{SANDBOX.icon}</span>
        <h3 class="mt-3 text-xl font-bold">{SANDBOX.title}</h3>
        <p class="mt-1.5 flex-1 text-[0.95rem] leading-relaxed">{SANDBOX.intro}</p>
        <span class="nav-btn mt-5 self-start">Open sandbox ❯</span>
      </a>
    </div>
    <div class="callout callout-note mt-10">
      <p class="callout-title">Ready for the real thing?</p>
      <p>The simulator teaches the ideas and the clicks. When you want to try real Azure, Microsoft Learn's free AZ-900 training modules include hands-on exercises. <a class="underline" href="https://learn.microsoft.com/en-us/training/courses/az-900t00" rel="noopener">Explore Microsoft Learn</a>.</p>
    </div>
  </div>
</Base>
<script>
  import { load } from '../../../lib/progress';
  const s = load();
  document.querySelectorAll<HTMLElement>('[data-lab]').forEach((c) => { if (s.labs[c.dataset.lab!]) c.querySelector('.lab-done')?.classList.remove('hidden'); });
</script>
