---
import Base from '../../../layouts/Base.astro';
import { SERVICES, SERVICE_CATS } from '../../../data/az-900/services';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'AZ-900', url: '/az-900/' }, { name: 'Service reference', url: '/az-900/services/' }];
---
<Base title="Azure Service Reference: Every Service in 60 Seconds" description="Every Azure service in 60 seconds: VMs, App Service, Functions, Blob, VNet, Entra ID, Policy and more, with price feel in your currency and a simulation." breadcrumbs={crumbs}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
    <p class="text-sm font-bold tracking-[0.14em] text-accent uppercase">Reference</p>
    <h1 class="mt-1 text-4xl font-semibold tracking-tight">Azure services in 60 seconds</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">Look up any Azure service: what it is, when to use it, how much it roughly costs in your currency, and a simulation to feel it.</p>
    <label class="mt-6 block max-w-md"><span class="sr-only">Filter services</span>
      <input id="svc-q" type="search" placeholder="Filter… e.g. storage, firewall, S3" class="w-full rounded-full border border-default bg-[var(--pastel-grey)] px-5 py-2.5 outline-none focus:border-[var(--accent)]" /></label>
    {SERVICE_CATS.map((cat) => (
      <section class="svc-cat mt-10">
        <h2 class="text-2xl font-semibold">{cat}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {SERVICES.filter((s) => s.cat === cat).map((s) => (
            <li class="svc-item" data-q={`${s.name} ${s.aws} ${s.cat} ${s.model}`.toLowerCase()}>
              <a href={`/az-900/services/${s.slug}/`} class="flex h-full gap-3 rounded-xl border border-default bg-[var(--card)] p-4 hover:border-[var(--accent)]">
                <span class="text-3xl" aria-hidden="true">{s.icon}</span>
                <span><span class="block font-semibold">{s.name}</span><span class="mt-1 block text-sm text-muted">{s.model} · AWS: {s.aws}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
<script>
  const q = document.getElementById('svc-q') as HTMLInputElement;
  q.addEventListener('input', () => {
    const v = q.value.trim().toLowerCase();
    document.querySelectorAll<HTMLElement>('.svc-item').forEach((li) => (li.hidden = !!v && !li.dataset.q!.includes(v)));
    document.querySelectorAll<HTMLElement>('.svc-cat').forEach((s) => (s.hidden = !s.querySelector('.svc-item:not([hidden])')));
  });
</script>
