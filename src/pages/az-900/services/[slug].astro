---
import Base from '../../../layouts/Base.astro';
import Datacenter3D from '../../../components/mdx/Datacenter3D.astro';
import PortalTour from '../../../components/mdx/PortalTour.astro';
import CurrencySelect from '../../../components/CurrencySelect.astro';
import { SERVICES, serviceBySlug, type Service } from '../../../data/az-900/services';
import { comparisonBySlug } from '../../../data/az-900/compare';
import { getNav, inlineMd } from '../../../lib/learn';
import { priceHtml } from '../../../lib/prices';
import { SITE } from '../../../config';

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Service };
const nav = await getNav();
const lesson = nav.find((t) => t.slug === s.lesson && t.published);
const cmp = s.compare ? comparisonBySlug(s.compare) : undefined;
const similar = s.similar.map(serviceBySlug).filter(Boolean);
const url = new URL(Astro.url.pathname, SITE.url).href;
const short = s.name.replace(/^Azure |^Microsoft /, '');
const title = `${s.name} in 60 Seconds: What, When, Cost`;
const description = `${s.name} explained in 60 seconds: what it is, when to use it and when not to, price feel in your currency, a simulation and similar services.`.slice(0, 165);
const crumbs = [{ name: 'Home', url: '/' }, { name: 'AZ-900', url: '/az-900/' }, { name: 'Service reference', url: '/az-900/services/' }, { name: s.name, url: Astro.url.pathname }];
const schema = [
  { '@type': 'TechArticle', '@id': `${url}#article`, headline: `${s.name} in 60 seconds`, description, url, inLanguage: 'en', author: { '@id': `${SITE.url}/#author` }, publisher: { '@id': `${SITE.url}/#organization` }, about: { '@type': 'SoftwareApplication', name: s.name, applicationCategory: s.cat, operatingSystem: 'Cloud' } },
  { '@type': 'FAQPage', mainEntity: [[`What is ${s.name}?`, s.what], [`When should I use ${short}?`, s.use.join('; ') + '.'], [`What is the AWS equivalent of ${s.name}?`, s.aws + '.']].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
const feelLabel = ['', 'Free or very cheap', 'Low', 'Medium', 'Premium'][s.feel];
---
<Base title={title.length > 62 ? `${s.name} in 60 Seconds` : title} description={description} type="article" schema={schema} breadcrumbs={crumbs}>
  <article class="mx-auto max-w-[960px] px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a class="hover:underline" href="/az-900/services/">Service reference</a> › <span class="text-[var(--text)]">{s.cat}</span></nav>
    <div class="mt-3 flex items-center gap-4">
      <span class="grid size-16 shrink-0 place-items-center rounded-2xl bg-[var(--pastel-blue)] text-4xl" aria-hidden="true">{s.icon}</span>
      <div><h1 class="text-[2rem] leading-tight font-semibold tracking-tight sm:text-[2.4rem]">{s.name} <span class="text-muted font-normal">in 60 seconds</span></h1>
        <p class="mt-1 flex flex-wrap gap-2 text-xs"><span class="chip">{s.cat}</span><span class="chip chip-muted">{s.model}</span><span class="chip chip-muted">AWS: {s.aws}</span></p></div>
    </div>

    <div class="answer-box mt-6" data-speakable>
      <p class="flex items-center gap-3 text-sm font-bold text-accent">What it is <button type="button" class="speak-btn" aria-label="Listen">🔊 Listen</button></p>
      <p class="mt-1 text-[1.08rem] leading-relaxed" set:html={inlineMd(s.what)} />
      {s.sim && <a href="#simulate" class="mt-3 inline-flex items-center gap-2 rounded-md bg-[#107c10] px-5 py-2.5 font-semibold !text-white !no-underline hover:bg-[#0b5a0b]"><span aria-hidden="true">▶</span> Simulate it »</a>}
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <section class="rounded-xl bg-[var(--pastel-green)] p-5"><h2 class="font-semibold">✅ Use it when</h2><ul class="mt-2 list-disc space-y-1 pl-5">{s.use.map((u) => <li>{u}</li>)}</ul></section>
      <section class="rounded-xl bg-[var(--bad-soft)] p-5"><h2 class="font-semibold">🚫 Not the best fit when</h2><ul class="mt-2 list-disc space-y-1 pl-5">{s.avoid.map((u) => <li>{u}</li>)}</ul></section>
    </div>

    <section class="mt-6 rounded-xl border border-default bg-[var(--card)] p-5" aria-labelledby="price">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="price" class="font-semibold">💰 Price feel: <span class="text-accent">{'●'.repeat(s.feel)}<span class="text-muted">{'○'.repeat(4 - s.feel)}</span></span> <span class="text-sm font-normal text-muted">{feelLabel}</span></h2>
        <CurrencySelect />
      </div>
      <p class="mt-2 leading-relaxed" set:html={priceHtml(s.price)} />
      <p class="mt-2 text-xs text-muted">Illustrative pay-as-you-go list prices at approximate exchange rates. Use the Azure pricing calculator for real quotes.</p>
    </section>

    {s.sim && (
      <section id="simulate" class="mt-8 scroll-mt-28" aria-labelledby="sim-h">
        <h2 id="sim-h" class="text-2xl font-semibold">Simulate it</h2>
        {s.sim.mode ? <Datacenter3D mode={s.sim.mode} start={s.sim.start ?? 0} intro={s.sim.intro} /> : <PortalTour id={s.sim.tour!} intro={s.sim.intro} />}
      </section>
    )}

    <section class="mt-8 flex flex-wrap gap-2">
      {lesson && <a href={lesson.url} class="nav-btn">📘 Full lesson: {lesson.title} ❯</a>}
      {cmp && <a href={`/az-900/compare/${cmp.slug}/`} class="nav-btn">⚖️ {cmp.title} ❯</a>}
    </section>

    {similar.length > 0 && (
      <section class="mt-8" aria-labelledby="similar">
        <h2 id="similar" class="text-xl font-semibold">Similar services</h2>
        <ul class="mt-3 grid gap-3 sm:grid-cols-3">{similar.map((x) => <li><a href={`/az-900/services/${x!.slug}/`} class="flex items-center gap-3 rounded-xl border border-default bg-[var(--card)] p-3 hover:border-[var(--accent)]"><span class="text-2xl" aria-hidden="true">{x!.icon}</span><span class="font-semibold">{x!.name}</span></a></li>)}</ul>
      </section>
    )}
  </article>
</Base>
