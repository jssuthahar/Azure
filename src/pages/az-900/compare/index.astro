---
import { SITE } from '../../../config';
import Base from '../../../layouts/Base.astro';
import { COMPARISONS } from '../../../data/az-900/compare';
import { inlineMd } from '../../../lib/learn';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'AZ-900', url: '/az-900/' }, { name: 'Compare', url: '/az-900/compare/' }];
const itemList = [{ '@type': 'ItemList', name: 'Azure service comparisons', numberOfItems: COMPARISONS.length, itemListElement: COMPARISONS.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: `${SITE.url}${`/az-900/compare/${c.slug}/`}` })) }];
---
<Base schema={itemList} title="Azure Comparisons: Which Service Should I Use? | AZ-900" description="Side-by-side Azure comparisons: Blob vs Files vs Disk, VM vs App Service vs Functions, LRS vs GRS, Azure vs AWS names and more, each with a live simulation." breadcrumbs={crumbs}>
  <div class="mx-auto max-w-[1000px] px-4 py-10 sm:px-6">
    <p class="text-sm font-bold tracking-[0.14em] text-accent uppercase">Compare</p>
    <h1 class="mt-1 text-4xl font-semibold tracking-tight">Which Azure service should I use?</h1>
    <p class="mt-3 max-w-2xl text-lg text-muted">The questions everyone searches, answered side by side in 30 seconds, then simulated so you can feel the difference.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {COMPARISONS.map((c) => (
        <li><a href={`/az-900/compare/${c.slug}/`} class="block h-full rounded-xl border border-default bg-[var(--card)] p-5 hover:border-[var(--accent)]">
          <p class="text-lg font-semibold text-accent">{c.title}</p>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-muted" set:html={inlineMd(c.answer.split('. ')[0] + '.')} />
        </a></li>
      ))}
    </ul>
  </div>
</Base>
