---
import Base from '../../../layouts/Base.astro';
import Datacenter3D from '../../../components/mdx/Datacenter3D.astro';
import PortalTour from '../../../components/mdx/PortalTour.astro';
import CurrencySelect from '../../../components/CurrencySelect.astro';
import { COMPARISONS, type Comparison } from '../../../data/az-900/compare';
import { getNav, inlineMd } from '../../../lib/learn';
import { priceHtml } from '../../../lib/prices';
import { SITE } from '../../../config';

export function getStaticPaths() {
  return COMPARISONS.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}
const { c } = Astro.props as { c: Comparison };
const nav = await getNav();
const lessons = c.lessons.map((s) => nav.find((t) => t.slug === s && t.published)).filter(Boolean);
const others = COMPARISONS.filter((x) => x.slug !== c.slug);
const url = new URL(Astro.url.pathname, SITE.url).href;
const plain = (s: string) => s.replace(/\*\*|`/g, '');
const crumbs = [{ name: 'Home', url: '/' }, { name: 'AZ-900', url: '/az-900/' }, { name: 'Compare', url: '/az-900/compare/' }, { name: c.title, url: Astro.url.pathname }];
const schema = [
  { '@type': 'TechArticle', '@id': `${url}#article`, headline: c.title, description: c.description, url, inLanguage: 'en', author: { '@id': `${SITE.url}/#author` }, publisher: { '@id': `${SITE.url}/#organization` }, about: c.cols.map((n) => ({ '@type': 'Thing', name: n })) },
  { '@type': 'FAQPage', mainEntity: [[`What is the difference between ${c.cols.join(' and ')}?`, c.answer], ...c.faq].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: plain(a) } })) },
];
---
<Base title={c.seoTitle} description={c.description} type="article" schema={schema} breadcrumbs={crumbs}>
  <article class="mx-auto max-w-[1000px] px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        {crumbs.slice(0, -1).map((b) => <li class="flex items-center gap-1.5"><a class="hover:underline" href={b.url}>{b.name}</a><span aria-hidden="true">›</span></li>)}
        <li aria-current="page" class="text-[var(--text)]">{c.title}</li>
      </ol>
    </nav>
    <p class="mt-4 text-sm font-bold tracking-[0.14em] text-accent uppercase">Compare</p>
    <h1 class="mt-1 text-[2rem] leading-tight font-semibold tracking-tight sm:text-[2.5rem]">{c.title}</h1>

    <div class="answer-box mt-5" data-speakable>
      <p class="flex items-center gap-3 text-sm font-bold text-accent">30-second answer <button type="button" class="speak-btn" aria-label="Listen to the answer">🔊 Listen</button></p>
      <p class="mt-1 text-[1.05rem] leading-relaxed" set:html={inlineMd(c.answer)} />
      {c.sim && <a href="#simulate" class="mt-3 inline-flex items-center gap-2 rounded-md bg-[#107c10] px-5 py-2.5 font-semibold !text-white !no-underline hover:bg-[#0b5a0b]"><span aria-hidden="true">▶</span> Simulate it »</a>}
    </div>

    <section class="mt-8" aria-labelledby="side-by-side">
      <div class="flex flex-wrap items-end justify-between gap-2">
        <h2 id="side-by-side" class="text-2xl font-semibold">Side by side</h2>
        <CurrencySelect />
      </div>
      <div class="mt-3 overflow-x-auto rounded-xl border border-default">
        <table class="cmp-table w-full text-left text-[0.95rem]">
          <thead><tr><th scope="col">{c.rowHead ?? ''}</th>{c.cols.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{c.rows.map(([label, ...cells]) => <tr><th scope="row" set:html={inlineMd(label)} />{cells.map((x) => <td set:html={priceHtml(x)} />)}</tr>)}</tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-muted">Prices are illustrative pay-as-you-go list prices converted at approximate rates, for "price feel" only. Check the Azure pricing calculator for real quotes.</p>
    </section>

    <section class="mt-8" aria-labelledby="pick">
      <h2 id="pick" class="text-2xl font-semibold">Which one should I pick?</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {c.pick.map(([item, when]) => <li class="rounded-xl border border-default bg-[var(--card)] p-4"><p class="font-semibold text-accent">{item}</p><p class="mt-1 leading-relaxed">Pick it when <span set:html={priceHtml(when)} /></p></li>)}
      </ul>
    </section>

    {c.sim && (
      <section id="simulate" class="mt-8 scroll-mt-28" aria-labelledby="sim-h">
        <h2 id="sim-h" class="text-2xl font-semibold">Simulate it</h2>
        {c.sim.mode ? <Datacenter3D mode={c.sim.mode} start={c.sim.start ?? 0} intro={c.sim.intro} /> : <PortalTour id={c.sim.tour!} intro={c.sim.intro} />}
      </section>
    )}

    <aside class="mt-8 rounded-xl border-l-[5px] border-[#c19c00] bg-[var(--pastel-yellow)] p-4" aria-label="Exam tip">
      <p class="text-sm font-bold">🎯 AZ-900 exam tip</p>
      <p class="mt-1 leading-relaxed" set:html={inlineMd(c.examTip)} />
    </aside>

    <section class="mt-8" aria-labelledby="faq">
      <h2 id="faq" class="text-2xl font-semibold">Questions people ask</h2>
      <div class="mt-3 space-y-2">
        {c.faq.map(([q, a]) => <details class="rounded-xl border border-default bg-[var(--card)] p-4"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-2 leading-relaxed" set:html={priceHtml(a)} /></details>)}
      </div>
    </section>

    {lessons.length > 0 && (
      <section class="mt-8" aria-labelledby="learn">
        <h2 id="learn" class="text-2xl font-semibold">Learn each one properly</h2>
        <div class="mt-3 flex flex-wrap gap-2">{lessons.map((l) => <a href={l!.url} class="nav-btn">{l!.title} ❯</a>)}</div>
      </section>
    )}

    <section class="mt-10 border-t border-default pt-6" aria-labelledby="more">
      <h2 id="more" class="text-xl font-semibold">More comparisons</h2>
      <ul class="mt-3 grid gap-2 text-[0.95rem] sm:grid-cols-2">{others.map((o) => <li><a class="text-accent hover:underline" href={`/az-900/compare/${o.slug}/`}>{o.title}</a></li>)}</ul>
    </section>
  </article>
</Base>

<style is:global>
  .cmp-table th, .cmp-table td { padding: .65rem .8rem; border-bottom: 1px solid var(--card-line); vertical-align: top; }
  .cmp-table thead th { background: var(--pastel-blue); font-weight: 700; white-space: nowrap; }
  .cmp-table tbody th { font-weight: 600; background: var(--pastel-grey); min-width: 9rem; }
  .cmp-table tbody tr:last-child > * { border-bottom: 0; }
</style>
