---
import Base from '../layouts/Base.astro';
import Mascot from '../components/Mascot.astro';
import { getNav } from '../lib/learn';
import { liveExams } from '../data/exams';

/** Everything "Save for offline" downloads: every lesson plus the pages that work without a server. */
const exams = liveExams();
const offline: string[] = ['/', '/progress/', '/certificate/', '/simulator/'];
let lessons = 0;
for (const exam of exams) {
  const nav = (await getNav(exam.slug)).filter((t) => t.published);
  lessons += nav.length;
  offline.push(`/${exam.slug}/`, ...exam.modules.map((m) => `/${exam.slug}/${m.slug}/`), ...nav.map((t) => t.url));
  offline.push(...['mock-exam', 'revision', 'glossary', 'interview', 'games', 'games/daily', 'games/sort', 'games/match', 'games/lightning', 'games/who-am-i'].map((p) => `/${exam.slug}/${p}/`));
  offline.push(...exam.whatIfs.map((w) => `/simulator/${w.slug}/`));
}
const urls = [...new Set(offline)];
const payload = JSON.stringify({ urls, lessons: exams.map((e) => e.slug) }).replace(/</g, '\\u003c');

const faqs = [
  { q: 'Is the MSDEVBUILD Azure app free?', a: 'Yes. It is the same free website, installed on your device. There is no App Store or Play Store download, no account and no payment.' },
  { q: 'Which devices can install it?', a: 'Android phones and tablets (Chrome, Edge, Samsung Internet), iPhone and iPad (Safari, iOS 16.4 or later also from Chrome and Edge), Windows, macOS, Linux and ChromeOS (Chrome or Edge), and Mac Safari 17 or later with Add to Dock.' },
  { q: 'Does it work offline?', a: `Every page you open is kept for offline use. To study on a flight or with patchy data, use “Save the whole course” below: it downloads all ${lessons} lessons, the mock exam, flashcards, glossary and games.` },
  { q: 'Will my progress move into the app?', a: 'On Android, Windows and Mac the app shares progress with the browser. On iPhone and iPad, Apple keeps a home-screen app separate from Safari, so progress starts fresh inside the app; keep using the app from then on.' },
  { q: 'How do I update or remove it?', a: 'Updates are automatic: new lessons appear the next time you open it online. To remove it, long-press the icon and choose Remove App (iPhone, iPad, Android), or open the app menu and choose Uninstall (Windows, Mac, ChromeOS).' },
];
const schema = [{ '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];

const devices = [
  { icon: '🤖', name: 'Android phone or tablet', steps: ['Open this site in Chrome', 'Tap <strong>Install</strong> above, or menu <strong>⋮ → Install app</strong>', 'Tap <strong>Install</strong>'] },
  { icon: '📱', name: 'iPhone', steps: ['Open this site in Safari', 'Tap <strong>Share</strong> (bottom bar)', 'Tap <strong>Add to Home Screen → Add</strong>'] },
  { icon: '📲', name: 'iPad', steps: ['Open this site in Safari', 'Tap <strong>Share</strong> (top right)', 'Tap <strong>Add to Home Screen → Add</strong>'] },
  { icon: '💻', name: 'Windows, Mac, Chromebook', steps: ['Open this site in Chrome or Edge', 'Click the install icon in the address bar', 'Click <strong>Install</strong>'] },
];
---
<Base
  title="Install MSDEVBUILD Azure on Android, iPhone & iPad (Free)"
  description={`Install MSDEVBUILD Azure on Android, iPhone, iPad, Windows or Mac in two taps. Free, no account, works offline: all ${lessons} AZ-900 lessons, mock exam and flashcards.`}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Install the app', url: '/app/' }]}
  schema={schema}
>
  <script type="application/json" id="app-data" set:html={payload} />
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href="/">Home</a> / <span class="text-[var(--text)]">Install the app</span></nav>

    <section class="mt-6 grid items-center gap-8 md:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow">Free app · no store needed</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Install MSDEVBUILD Azure on your phone, iPad or laptop</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">Open your lessons from the home screen, full screen, and keep studying without internet. Same free site, no account, nothing to pay.</p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button type="button" id="app-install" class="btn btn-accent !px-7 !py-3.5 text-base" data-install>📲 Install the app</button>
          <a href="#offline" class="btn btn-outline">✈️ Save for offline</a>
        </div>
        <p id="app-state" class="mt-3 text-sm text-muted" aria-live="polite"></p>
      </div>
      <div class="flex justify-center">
        <div class="app-phone" aria-hidden="true">
          <div class="app-phone-screen">
            <img src="/icons/icon-192.png" alt="" width="72" height="72" class="rounded-2xl shadow-lg" />
            <p class="mt-2 text-xs font-semibold text-white">MSDEVBUILD</p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="how">
      <h2 id="how" class="text-2xl font-bold">How to install, on any device</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {devices.map((d) => (
          <div class="card p-5">
            <p class="text-3xl" aria-hidden="true">{d.icon}</p>
            <h3 class="mt-2 font-semibold">{d.name}</h3>
            <ol class="mt-2 list-decimal space-y-1 pl-5 text-sm leading-relaxed">{d.steps.map((s) => <li set:html={s} />)}</ol>
          </div>
        ))}
      </div>
    </section>

    <section id="offline" class="band-navy mt-12 scroll-mt-28 rounded-2xl p-5 sm:p-7" aria-labelledby="off-h">
      <div class="flex flex-wrap items-start gap-4">
        <Mascot size={64} mood="cheer" class="hidden shrink-0 sm:block" />
        <div class="min-w-0 flex-1">
          <h2 id="off-h" class="text-2xl font-bold">Study offline: save the whole course</h2>
          <p class="mt-2 text-white/80">Downloads all {lessons} lessons with their 3D and portal simulations, plus the mock exam, flashcards, glossary, games and simulator ({urls.length} pages). Best on Wi-Fi. Your quiz answers and progress keep saving while offline.</p>
          <div class="mt-4 flex flex-wrap items-center gap-3">
            <button type="button" id="off-save" class="btn !bg-[#ffd75e] !text-[#0b1020] hover:!bg-[#ffcd2e]">⬇ Save the whole course</button>
            <button type="button" id="off-clear" class="btn btn-outline !border-white/40 !bg-transparent !text-white" hidden>Remove offline copies</button>
          </div>
          <div class="bar mt-4 !border-white/20 !bg-white/10" id="off-bar-wrap" hidden><span id="off-bar" style="width:0;background:#ffd75e"></span></div>
          <p id="off-status" class="mt-2 text-sm text-white/80" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <section class="mt-12" aria-labelledby="faq">
      <h2 id="faq" class="text-2xl font-bold">Questions</h2>
      <div class="mt-4 space-y-3">
        {faqs.map((f) => (
          <details class="card p-4">
            <summary class="cursor-pointer font-semibold">{f.q}</summary>
            <p class="mt-2 leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
  .app-phone { width: 190px; height: 360px; border-radius: 34px; padding: 10px; background: #0b1020; box-shadow: 0 30px 60px rgb(0 40 90 / .35), inset 0 0 0 2px #2a3550; }
  .app-phone-screen { height: 100%; border-radius: 26px; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(circle at 30% 20%, #3aa0ff, #0058a3 60%, #06213f); }
</style>

<script>
  import { isStandalone, canPrompt, isIOS, savedPaths, saveForOffline, clearOffline, storageUsedMB } from '../lib/pwa';

  const data = JSON.parse(document.getElementById('app-data')!.textContent!) as { urls: string[] };
  const $ = (id: string) => document.getElementById(id)!;

  const paintInstall = () => {
    const btn = $('app-install') as HTMLButtonElement;
    const st = $('app-state');
    if (isStandalone()) { btn.textContent = '✅ Installed'; btn.disabled = true; st.textContent = 'You are using the installed app.'; return; }
    try { if (localStorage.getItem('msdb-app-installed') === '1' && !canPrompt()) st.textContent = 'Already installed on this device? Open it from your home screen, Start menu or Dock.'; } catch {}
    if (isIOS()) st.textContent = 'On iPhone and iPad this shows the two taps Safari needs.';
  };
  paintInstall();
  addEventListener('pwa-change', paintInstall);

  const save = $('off-save') as HTMLButtonElement;
  const clear = $('off-clear') as HTMLButtonElement;
  const status = $('off-status');
  const barWrap = $('off-bar-wrap');
  const bar = $('off-bar');

  async function paintOffline() {
    if (!('serviceWorker' in navigator) || !('caches' in window)) {
      save.disabled = true;
      status.textContent = 'This browser cannot save pages for offline use. Try Chrome, Edge or Safari.';
      return;
    }
    const have = await savedPaths();
    const n = data.urls.filter((u) => have.has(u)).length;
    const mb = await storageUsedMB();
    clear.hidden = have.size === 0;
    status.textContent = n === 0 ? 'Nothing saved yet. Pages you open are kept automatically.'
      : `${n} of ${data.urls.length} pages saved on this device${mb ? ` · about ${mb} MB used` : ''}.`;
    if (n === data.urls.length) save.textContent = '✅ Course saved · refresh copies';
  }
  paintOffline();

  save.addEventListener('click', async () => {
    if (!navigator.onLine) { status.textContent = 'You are offline. Connect to the internet to download the course.'; return; }
    save.disabled = true;
    barWrap.hidden = false;
    bar.style.width = '0';
    status.textContent = 'Starting download…';
    try {
      const r = await saveForOffline(data.urls, (done, total) => {
        bar.style.width = `${Math.round((done / total) * 100)}%`;
        status.textContent = `Saving… ${done} of ${total} pages`;
      });
      bar.style.width = '100%';
      await paintOffline();
      if (r.failed) status.textContent += ` (${r.failed} could not be saved; try again later.)`;
    } catch (e) {
      status.textContent = (e as Error).message;
    } finally {
      save.disabled = false;
    }
  });

  clear.addEventListener('click', async () => {
    await clearOffline();
    barWrap.hidden = true;
    save.textContent = '⬇ Save the whole course';
    await paintOffline();
    status.textContent = 'Offline copies removed. Your progress and certificate are untouched.';
  });
</script>
