---
import Base from '../../../layouts/Base.astro';
import Simulator from '../../../components/Simulator.astro';
import { sandboxFor, labsForExam, type Lab } from '../../../lib/sim/labs';
import { getNav } from '../../../lib/learn';
import { getExam, liveExams } from '../../../data/exams';

export function getStaticPaths() {
  return liveExams().flatMap((exam) => [...labsForExam(exam.slug), sandboxFor(exam.slug)].map((lab) => ({ params: { cert: exam.slug, lab: lab.id }, props: { lab } })));
}
const exam = getExam(Astro.params.cert);
const { lab } = Astro.props as { lab: Lab };
const nav = await getNav(exam.slug);
const related = lab.topics.map((t) => nav.find((n) => n.slug === t && n.published)).filter(Boolean);
const examLabs = [...labsForExam(exam.slug), sandboxFor(exam.slug)];
const idx = examLabs.findIndex((l) => l.id === lab.id);
const next = examLabs[idx + 1];
const title = lab.id === 'sandbox' ? (exam.course.hubs?.sandboxTitle ?? 'Azure Sandbox Simulator: Practise Free | MSDEVBUILD') : `${lab.title} · ${lab.kind === 'challenge' ? 'Azure Troubleshooting Lab' : 'Free Azure Lab'}`.slice(0, 65);
const description = (lab.id === 'sandbox' && exam.course.labs ? `Free ${exam.code} sandbox: explore a simulated Azure portal, Microsoft Foundry and Cloud Shell with no tasks and no rules. Nothing here costs real money.` : lab.id === 'gh-sandbox' ? `Free ${exam.code} sandbox: a simulated terminal with GitHub Copilot CLI, git and gh. No tasks, no account, nothing leaves your browser.` : `${lab.intro}`).slice(0, 155);
---
<Base title={title} description={description} breadcrumbs={[{ name: 'Home', url: '/' }, { name: `${exam.code}`, url: `/${exam.slug}/` }, { name: 'Practice labs', url: `/${exam.slug}/labs/` }, { name: lab.title, url: Astro.url.pathname }]}>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a class="hover:underline" href={`/${exam.slug}/labs/`}>❮ Practice labs</a></nav>
    <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl"><span aria-hidden="true">{lab.icon}</span> {lab.title}</h1>
        <p class="mt-1 max-w-3xl text-lg text-muted">{lab.intro}</p>
        {lab.symptom && <p class="lab-ticket mt-3 max-w-3xl"><span aria-hidden="true">🎫</span> <span><strong>Troubleshooting challenge.</strong> {lab.symptom}</span></p>}
      </div>
      {next && <a href={`/${exam.slug}/labs/${next.id}/`} class="nav-btn">Next: {next.title} ❯</a>}
    </div>
    {lab.learn.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-2 text-sm"><span class="font-semibold">You will learn:</span>{lab.learn.map((l) => <span class="chip chip-muted">{l}</span>)}</p>
    )}
    <div class="mt-6"><Simulator lab={lab} /></div>
    {related.length > 0 && (
      <p class="mt-8 text-sm"><span class="font-semibold">Related lessons:</span> {related.map((r, i) => <>{i > 0 && ' · '}<a class="text-accent underline" href={r!.url}>{r!.title}</a></>)}</p>
    )}
  </div>
</Base>

<style>
  .lab-ticket { display: flex; gap: .6rem; padding: .75rem .9rem; border-radius: 12px; border: 1px solid #d97706; background: #fff8ec; color: #3d2600; line-height: 1.5; }
  :global([data-theme="dark"]) .lab-ticket { background: #2b1d08; color: #ffe3b5; }
</style>
