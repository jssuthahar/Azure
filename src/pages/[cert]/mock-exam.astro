---
import Base from '../../layouts/Base.astro';
import Mascot from '../../components/Mascot.astro';
import { SITE } from '../../config';
import { getQuestionBank, getNav } from '../../lib/learn';
import { getExam, examStaticPaths } from '../../data/exams';

export function getStaticPaths() {
  return examStaticPaths();
}
const exam = getExam(Astro.params.cert);

const bank = await getQuestionBank(exam.slug);
const nav = await getNav(exam.slug);
const topicTitle = Object.fromEntries(nav.filter((t) => t.published).map((t) => [t.slug, { title: t.title, url: t.url }]));
const domains = exam.modules.map((m) => ({ domain: m.domain, title: m.title, short: m.shortTitle, count: bank.filter((q) => q.domain === m.domain).length + exam.examItems.filter((x) => x.domain === m.domain).length }));
const choice = bank.map((q) => ({ kind: q.type, id: q.id, domain: q.domain, topic: q.topic, scenario: q.scenario, question: q.question, options: q.options, answer: q.answer, explanation: q.explanation }));
const weights = Object.fromEntries(exam.modules.map((m) => [m.domain, m.weightMid]));
const payload = JSON.stringify({ choice, domains, topicTitle, items: exam.examItems, weights, code: exam.code, name: exam.name }).replace(/</g, '\\u003c');
const total = bank.length + exam.examItems.length;

const title = `${exam.code} Mock Exam: Real Exam Experience, Free`;
const description = `Free ${exam.code} practice exam that feels like the real Microsoft exam: timer, review screen, drag and drop, Yes/No and drop-down items, score report and certificate.`;
const crumbs = [{ name: 'Home', url: '/' }, { name: `${exam.code}`, url: `/${exam.slug}/` }, { name: 'Mock exam', url: `/${exam.slug}/mock-exam/` }];
---
<Base title={title} description={description} breadcrumbs={crumbs}>
  <script type="application/json" id="exam-data" set:html={payload} />
  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <!-- ============ SETUP ============ -->
    <section id="setup">
      <nav aria-label="Breadcrumb" class="text-sm text-muted"><a href="/">Home</a> / <a href={`/${exam.slug}/`}>{exam.code}</a> / <span class="text-[var(--text)]">Mock exam</span></nav>
      <div class="mt-6 grid gap-8 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <p class="eyebrow">Real exam experience</p>
          <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{exam.code} mock exam</h1>
          <p class="mt-4 text-lg leading-relaxed text-muted">Sit it like the real Microsoft exam: a full-screen exam room with the same flow (welcome, agreement, exam features, then the sections), a countdown timer you can hide, zoom and high contrast, <strong>Mark for review</strong>, a review grid, and the same item types: multiple choice, multiple response, <strong>drag and drop</strong>, <strong>build a list</strong>, <strong>drop-down</strong> and a final <strong>Yes/No</strong> section you can’t go back to. Scored on the 1–1000 scale (700 to pass), with a full report and your MSDEVBUILD certificate.</p>
          <div class="mt-5 rounded-xl border-l-[5px] border-[#0078d4] bg-[var(--pastel-blue)] p-4 text-[0.95rem] leading-relaxed">
            <p class="font-bold text-accent">✍️ Original practice questions</p>
            <p>All {total} questions were written for this site from the official {exam.code} skills outline. None are real, recalled or leaked Microsoft exam questions (sharing those breaks Microsoft’s exam agreement). This is a practice simulation, not affiliated with Microsoft or any exam delivery provider, and a good score here doesn’t guarantee a pass on the real exam.</p>
          </div>
        </div>
        <div class="card flex items-center gap-4 p-5">
          <Mascot size={72} mood="thinking" />
          <div class="text-sm leading-relaxed">
            <p class="font-semibold">Nimbus's exam-room tips</p>
            <p class="mt-1 text-muted">Read the last line first. Answer everything (there’s no penalty for guessing). Mark tricky ones and use the review screen. In the Yes/No section you can’t go back, so check each statement before you press Next.</p>
          </div>
        </div>
      </div>

      <form id="setup-form" class="mt-8 grid gap-4 md:grid-cols-3">
        <label class="md:col-span-3 flex max-w-md flex-col gap-1 text-sm font-semibold">Candidate name <span class="font-normal text-muted">(shown on your score report and certificate)</span>
          <input name="name" id="cand-name" maxlength="60" placeholder="Your full name" class="rounded-lg border border-default bg-[var(--bg)] px-3 py-2 text-base font-normal" />
        </label>
        <label class="opt min-w-0 flex-col !gap-1 p-5">
          <span class="flex items-center gap-2"><input type="radio" name="mode" value="full" checked /><span class="font-semibold">Full exam (certificate)</span></span>
          <span class="text-sm text-muted">45 questions · 45 minutes · 2 sections · all item types · earns the certificate at 700+.</span>
        </label>
        <label class="opt min-w-0 flex-col !gap-1 p-5">
          <span class="flex items-center gap-2"><input type="radio" name="mode" value="quick" /><span class="font-semibold">Quick practice</span></span>
          <span class="text-sm text-muted">12 questions · 15 minutes · a short warm-up with every item type.</span>
        </label>
        <label class="opt min-w-0 flex-col !gap-1 p-5">
          <span class="flex items-center gap-2"><input type="radio" name="mode" value="domain" /><span class="font-semibold">Practise one domain</span></span>
          <span class="text-sm text-muted">15 questions · 18 minutes · focus on a weak area.</span>
          <select name="domain" class="mt-2 w-full max-w-full min-w-0 rounded-lg border border-default bg-[var(--bg)] px-2 py-1.5 text-sm" aria-label="Domain">
            {domains.map((d) => <option value={d.domain}>Domain {d.domain}: {d.short} ({d.count} questions)</option>)}
          </select>
        </label>
        <div class="flex flex-wrap items-center gap-3 md:col-span-3">
          <button type="submit" class="btn btn-accent">Enter the exam room</button>
          <button type="button" id="resume" class="btn btn-outline hidden">Resume unfinished exam</button>
          <label class="flex items-center gap-2 text-sm text-muted"><input type="checkbox" name="untimed" /> Practice without a timer</label>
        </div>
      </form>
    </section>

    <!-- ============ RESULTS ============ -->
    <section id="results" class="hidden" aria-labelledby="sr-title"></section>
  </div>

  <!-- ============ EXAM ROOM (full screen) ============ -->
  <div id="xs" class="xs" hidden role="application" aria-label={`${exam.code} practice exam`} data-brand={SITE.brandLine}>
    <header class="xs-top">
      <span class="xs-brand">
        <img src={SITE.authorImageSmall} alt="" width="30" height="30" />
        <span class="xs-brand-txt"><strong>MSDEVBUILD</strong><small>{SITE.orgFull}</small></span>
      </span>
      <span class="xs-title">{exam.name} ({exam.code}) · Practice exam</span>
      <span class="xs-cand" id="xs-cand"></span>
      <span class="xs-clock">
        <span class="xs-time" id="xs-time" role="timer" aria-live="off"></span>
        <button type="button" class="xs-tool xs-tool-dark" data-tool="time" id="xs-hide-time">Hide time</button>
      </span>
    </header>
    <div class="xs-sub">
      <span id="xs-pos" class="xs-pos"></span>
      <span class="xs-tools">
        <button type="button" class="xs-tool xs-markbtn" data-tool="mark" id="xs-mark" aria-pressed="false"><span aria-hidden="true">⚑</span><span class="xs-lbl">Mark for review</span></button>
        <span class="xs-zoom" role="group" aria-label="Zoom">
          <button type="button" class="xs-tool" data-zoom="-1"><span aria-hidden="true">−</span><span class="xs-lbl xs-sr">Zoom out</span></button>
          <span id="xs-zoom-pct" class="xs-zoom-pct" aria-live="polite">100%</span>
          <button type="button" class="xs-tool" data-zoom="1"><span aria-hidden="true">+</span><span class="xs-lbl xs-sr">Zoom in</span></button>
        </span>
        <button type="button" class="xs-tool" data-tool="contrast" id="xs-contrast" aria-pressed="false"><span aria-hidden="true">◐</span><span class="xs-lbl">Contrast</span></button>
        <button type="button" class="xs-tool" data-tool="help"><span aria-hidden="true">?</span><span class="xs-lbl">Help</span></button>
      </span>
    </div>
    <main class="xs-body" id="xs-body" tabindex="0" aria-label="Question area"></main>
    <footer class="xs-foot" id="xs-foot"></footer>
    <div class="xs-modal" id="xs-modal" hidden><div class="xs-dialog" role="alertdialog" aria-modal="true" aria-labelledby="xs-dlg-title" id="xs-dialog"></div></div>
  </div>
</Base>

<style is:global>
  .xs { --xs-bg: #fff; --xs-fg: #1a1a1a; --xs-muted: #444; --xs-bar: #e9e9e9; --xs-line: #bdbdbd; --xs-head: #ececec; --xs-soft: #f4f4f4; --xs-hover: #f3f8fd; --xs-acc: #0067b8; --xs-acc-fg: #fff; --xs-sel: #eef5fc; --xs-top: #1b2a3d; --xs-top-fg: #fff; --xs-warn-bg: #fff4ce; --xs-warn-line: #c19c00;
    position: fixed; inset: 0; z-index: 300; display: flex; flex-direction: column; background: var(--xs-bg); color: var(--xs-fg); font: 15px/1.5 'Segoe UI', var(--font-sans); --xs-scale: 1; }
  .xs.hc { --xs-bg: #000; --xs-fg: #fff; --xs-muted: #e6e6e6; --xs-bar: #1a1a1a; --xs-line: #8a8a8a; --xs-head: #222; --xs-soft: #141414; --xs-hover: #262626; --xs-acc: #ffd75e; --xs-acc-fg: #000; --xs-sel: #2a2400; --xs-top: #000; --xs-warn-bg: #2a2400; --xs-warn-line: #ffd75e; }
  .xs[hidden] { display: none; }
  .xs button { font: inherit; cursor: pointer; color: inherit; }
  .xs :focus-visible { outline: 3px solid var(--xs-acc); outline-offset: 2px; }
  .xs-top { flex: none; display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1.1rem; padding: .45rem 1rem; padding-top: max(.45rem, env(safe-area-inset-top)); background: var(--xs-top); color: var(--xs-top-fg); border-bottom: 3px solid #0078d4; }
  .xs-brand { display: inline-flex; align-items: center; gap: .5rem; padding-right: 1rem; border-right: 1px solid rgb(255 255 255 / .25); }
  .xs-brand img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; border: 2px solid #0078d4; }
  .xs-brand-txt { display: flex; flex-direction: column; line-height: 1.1; }
  .xs-brand-txt strong { letter-spacing: .04em; }
  .xs-brand-txt small { font-size: .72rem; color: #c9d6e6; }
  .xs.hc .xs-brand-txt small { color: #fff; }
  .xs-title { font-weight: 600; }
  .xs-cand { font-size: .9rem; color: #dfe7f1; }
  .xs.hc .xs-cand { color: #fff; }
  .xs-clock { margin-left: auto; display: inline-flex; align-items: center; gap: .5rem; }
  .xs-time { font-variant-numeric: tabular-nums; font-weight: 600; padding: .2rem .6rem; border-radius: 4px; background: #2e4560; }
  .xs-time[hidden] { display: none; }
  .xs-time.low { background: #c50f1f; }
  .xs-sub { flex: none; display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem; padding: .35rem 1rem; background: var(--xs-bar); border-bottom: 1px solid var(--xs-line); }
  .xs-pos { font-weight: 600; }
  .xs-tools { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-left: auto; }
  .xs-tool { display: inline-flex; align-items: center; justify-content: center; gap: .35rem; min-height: 36px; min-width: 36px; padding: .2rem .7rem; border: 1px solid var(--xs-line); border-radius: 3px; background: var(--xs-bg); font-weight: 600; }
  .xs-tool:hover { border-color: var(--xs-acc); }
  .xs-tool[hidden] { display: none; }
  .xs-tool[aria-pressed='true'] { background: var(--xs-acc); border-color: var(--xs-acc); color: var(--xs-acc-fg); }
  .xs-tool-dark { background: transparent; color: #fff; border-color: rgb(255 255 255 / .5); font-weight: 500; font-size: .85rem; }
  .xs-zoom { display: inline-flex; align-items: center; gap: 2px; }
  .xs-zoom-pct { min-width: 3.2rem; text-align: center; font-variant-numeric: tabular-nums; font-weight: 600; }
  .xs-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .xs-body { flex: 1; min-height: 0; overflow: auto; padding: 1.4rem clamp(1rem, 4vw, 3rem) 2rem; font-size: calc(1rem * var(--xs-scale)); }
  .xs-body:focus:not(:focus-visible) { outline: none; }
  .xs-body:focus-visible { outline-offset: -3px; }
  .xs-foot { flex: none; display: flex; align-items: center; gap: .6rem; justify-content: space-between; padding: .55rem 1rem; padding-bottom: max(.55rem, env(safe-area-inset-bottom)); background: var(--xs-bar); border-top: 1px solid var(--xs-line); }
  .xs-foot .xs-mid { display: flex; gap: .6rem; }
  .xs-btn { min-height: 38px; white-space: nowrap; padding: .45rem 1.2rem; border-radius: 3px; border: 1px solid var(--xs-line); background: var(--xs-bg); color: var(--xs-fg); font-weight: 600; }
  .xs-btn:hover { border-color: var(--xs-acc); }
  .xs-btn:disabled { opacity: .45; cursor: default; }
  .xs-btn.primary { background: var(--xs-acc); border-color: var(--xs-acc); color: var(--xs-acc-fg); }
  .xs-q { max-width: 980px; }
  .xs-q h2 { font-size: 1.05em; font-weight: 600; margin: 0 0 .8rem; }
  .xs-note { color: var(--xs-muted); font-size: .93em; margin: .2rem 0 .9rem; }
  .xs-scn { background: var(--xs-soft); border-left: 4px solid var(--xs-line); padding: .7rem 1rem; margin-bottom: 1rem; }
  .xs-opts { display: grid; gap: .45rem; margin-top: .6rem; }
  .xs-opt { display: flex; gap: .7rem; align-items: flex-start; padding: .55rem .8rem; border: 1px solid var(--xs-line); border-radius: 3px; cursor: pointer; }
  .xs-opt:hover { background: var(--xs-hover); }
  .xs-opt:has(input:checked) { border-color: var(--xs-acc); background: var(--xs-sel); }
  .xs-opt input { margin-top: .3rem; accent-color: var(--xs-acc); }
  .xs-yn { border-collapse: collapse; width: 100%; max-width: 980px; }
  .xs-yn th, .xs-yn td { border: 1px solid var(--xs-line); padding: .6rem .8rem; vertical-align: middle; }
  .xs-yn th { background: var(--xs-head); text-align: left; }
  .xs-yn td.c { text-align: center; width: 5rem; }
  .xs-yn input { width: 1.15rem; height: 1.15rem; accent-color: var(--xs-acc); }
  .xs-cols { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(0, 2fr); gap: 1.4rem; align-items: start; }
  .xs-panel { border: 1px solid var(--xs-line); }
  .xs-panel > p { margin: 0; padding: .45rem .7rem; background: var(--xs-head); font-weight: 600; border-bottom: 1px solid var(--xs-line); }
  .xs-panel .xs-in { padding: .6rem; display: grid; gap: .45rem; min-height: 3rem; }
  .xs-tile { padding: .45rem .7rem; border: 1px solid var(--xs-line); border-radius: 3px; background: var(--xs-bg); text-align: left; cursor: grab; }
  .xs-tile[aria-pressed='true'] { outline: 3px solid var(--xs-acc); outline-offset: 1px; }
  .xs-target { display: grid; grid-template-columns: minmax(150px, 1fr) minmax(0, 1.3fr); gap: .6rem; align-items: center; }
  .xs-slot { min-height: 2.4rem; padding: .35rem .6rem; border: 2px dashed var(--xs-line); border-radius: 3px; background: var(--xs-soft); text-align: left; }
  .xs-slot.filled { border-style: solid; border-color: var(--xs-acc); background: var(--xs-sel); font-weight: 600; }
  .xs-slot.over { background: var(--xs-hover); }
  .xs-order-row { display: flex; gap: .4rem; align-items: center; }
  .xs-order-row .xs-tile { flex: 1; }
  .xs-mini { min-width: 36px; min-height: 36px; padding: .2rem .5rem; border: 1px solid var(--xs-line); border-radius: 3px; background: var(--xs-bg); }
  .xs-arrows { display: grid; gap: .4rem; align-content: center; justify-items: center; }
  .xs-sent { font-size: 1.05em; line-height: 2.4; max-width: 900px; }
  .xs-sent select { font: inherit; padding: .2rem .4rem; border: 1px solid var(--xs-acc); border-radius: 3px; background: var(--xs-bg); color: var(--xs-fg); max-width: 100%; }
  .xs-rev { max-width: 1040px; }
  .xs-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: .5rem; }
  .xs-cell { display: grid; grid-template-columns: 1fr auto; gap: .1rem .4rem; align-content: start; min-height: 3.6rem; padding: .5rem .7rem; text-align: left; border: 1px solid var(--xs-line); border-left-width: 5px; border-radius: 3px; background: var(--xs-bg); }
  .xs-cell:hover { background: var(--xs-hover); }
  .xs-cell b { font-weight: 600; }
  .xs-cell .st { grid-column: 1 / -1; font-size: .82em; color: var(--xs-muted); }
  .xs-cell[data-a='all'] { border-left-color: #107c10; }
  .xs-cell[data-a='some'], .xs-cell[data-a='none'] { border-left-color: #c50f1f; }
  .xs-cell[data-a='some'] .st, .xs-cell[data-a='none'] .st { color: var(--xs-fg); }
  .xs-cell .fl { color: var(--xs-acc); font-weight: 700; }
  .xs.hc .xs-cell[data-a='all'] { border-left-color: #6ccb5f; } .xs.hc .xs-cell[data-a='some'], .xs.hc .xs-cell[data-a='none'] { border-left-color: #ff99a4; }
  .xs-legend { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin: 0 0 .8rem; font-size: .88em; color: var(--xs-muted); }
  .xs-legend i { display: inline-block; width: .8rem; height: .8rem; margin-right: .35rem; vertical-align: -1px; border-radius: 2px; }
  .xs-filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: .4rem 0 1rem; }
  .xs-filters button[aria-pressed='true'] { background: var(--xs-acc); color: var(--xs-acc-fg); border-color: var(--xs-acc); }
  .xs-modal { position: absolute; inset: 0; background: rgb(0 0 0 / .45); display: grid; place-items: center; padding: 1rem; }
  .xs-modal[hidden] { display: none; }
  .xs-dialog { width: min(560px, 100%); max-height: calc(100% - 2rem); overflow: auto; background: var(--xs-bg); border: 1px solid var(--xs-line); box-shadow: 0 12px 40px rgb(0 0 0 / .3); }
  .xs-dialog h3 { position: sticky; top: 0; margin: 0; padding: .6rem 1rem; background: var(--xs-top); color: #fff; font-size: 1rem; font-weight: 600; }
  .xs-dialog .xs-dbody { padding: 1rem; }
  .xs-dialog .xs-dbody ul { list-style: disc; padding-left: 1.2rem; display: grid; gap: .3rem; }
  .xs-dialog .xs-dfoot { display: flex; justify-content: flex-end; gap: .6rem; padding: .7rem 1rem; background: var(--xs-bar); }
  .xs-kbd { display: inline-block; padding: 0 .35rem; border: 1px solid var(--xs-line); border-radius: 3px; background: var(--xs-soft); font: .85em ui-monospace, monospace; }
  .xs-welcome { max-width: 860px; }
  .xs-welcome h1 { font-size: 1.5em; font-weight: 600; margin-bottom: .6rem; }
  .xs-welcome h2 { font-size: 1.1em; font-weight: 600; margin: 1rem 0 .3rem; }
  .xs-welcome ul { list-style: disc; padding-left: 1.3rem; display: grid; gap: .35rem; margin: .6rem 0 1rem; }
  .xs-welcome ol { list-style: decimal; padding-left: 1.3rem; display: grid; gap: .45rem; margin: .6rem 0 1rem; }
  .xs-facts { display: grid; grid-template-columns: max-content 1fr; gap: .35rem 1.2rem; margin: 1rem 0; padding: .9rem 1rem; border: 1px solid var(--xs-line); background: var(--xs-soft); }
  .xs-facts dt { font-weight: 600; }
  .xs-box { border: 1px solid var(--xs-line); background: var(--xs-soft); padding: .9rem 1rem; margin: 1rem 0; }
  .xs-terms { max-height: 46vh; overflow: auto; }
  .xs-brandline { margin-top: 1.4rem; padding-top: .8rem; border-top: 1px solid var(--xs-line); font-size: .85em; color: var(--xs-muted); }
  .xs-lock { background: var(--xs-warn-bg); border: 1px solid var(--xs-warn-line); padding: .7rem 1rem; margin-bottom: 1rem; }
  .xs-steps { display: flex; flex-wrap: wrap; gap: .3rem; margin-bottom: 1rem; font-size: .82em; }
  .xs-steps span { padding: .15rem .6rem; border-radius: 999px; border: 1px solid var(--xs-line); color: var(--xs-muted); }
  .xs-steps span[aria-current='step'] { background: var(--xs-acc); border-color: var(--xs-acc); color: var(--xs-acc-fg); font-weight: 600; }
  @media (max-width: 720px) { .xs-cols { grid-template-columns: 1fr !important; } .xs-target { grid-template-columns: 1fr; } .xs-title { font-size: .85rem; flex-basis: 100%; order: 3; } .xs-cand { display: none; } .xs-arrows { grid-auto-flow: column; } .xs-brand { border: 0; padding: 0; } .xs-brand-txt small { display: none; } .xs-btn { padding: .45rem .8rem; } }
  @media (max-width: 420px) { .xs-btn { padding: .45rem .55rem; } .xs-foot { gap: .35rem; } }
  @media (max-width: 560px) { .xs-lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } .xs-tools { margin-left: 0; } .xs-facts { grid-template-columns: 1fr; } .xs-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); } }
  /* score report (site look) */
  .sr-scale { position: relative; height: 14px; border-radius: 999px; background: linear-gradient(90deg, #f3b6b8 0 69.9%, #b7e3b4 70% 100%); }
  .sr-scale .sr-pass { position: absolute; top: -6px; bottom: -6px; left: 70%; width: 2px; background: #1a1a1a; }
  .sr-scale .sr-you { position: absolute; top: 50%; width: 18px; height: 18px; margin: -9px 0 0 -9px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 2px #0078d4; background: #0078d4; }
  .sr-item { border: 1px solid var(--card-line); border-radius: 12px; background: var(--card); padding: 1rem 1.2rem; }
  .sr-item table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .sr-item th, .sr-item td { border-bottom: 1px solid var(--card-line); padding: .4rem .5rem; text-align: left; vertical-align: top; }
  .sr-ok { color: var(--ok); font-weight: 700; } .sr-bad { color: var(--bad); font-weight: 700; } .sr-part { color: var(--warn); font-weight: 700; }
  .sr-badge { display: inline-flex; padding: .15rem .6rem; border-radius: 999px; font-size: .8rem; font-weight: 700; }
  .sr-badge.ok { background: var(--ok-soft); color: var(--ok); } .sr-badge.bad { background: var(--bad-soft); color: var(--bad); } .sr-badge.part { background: var(--warn-soft); color: var(--warn); } .sr-badge.none { background: var(--pastel-grey); color: var(--text-muted); }
</style>

<script>
  import type { FormatItem } from '../../data/az-900/exam-items';
  import { buildPaper, emptyResponse, answered, score, result, KIND_LABEL, type Item, type ChoiceItem, type Response, type Paper } from '../../lib/exam';
  import { saveMock, type MockResult } from '../../lib/progress';
  import { recordAnswers } from '../../lib/review';
  import { issueCert, loadCert } from '../../lib/certificate';
  import { confetti } from '../../lib/fun';

  const data = JSON.parse(document.getElementById('exam-data')!.textContent!) as {
    choice: ChoiceItem[]; items: FormatItem[]; weights: Record<number, number>; code: string; name: string; domains: { domain: number; title: string; short: string }[]; topicTitle: Record<string, { title: string; url: string }>;
  };
  const SKEY = 'msdb-azure-exam-v2';
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;').replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>').replace(/`(.+?)`/g, '<code>$1</code>');
  const domainTitle = (d: number) => data.domains.find((x) => x.domain === d)?.title ?? `Domain ${d}`;

  type Screen = 'welcome' | 'agree' | 'intro' | 'start' | 'q' | 'review' | 'sec2';
  interface State { paper: Paper; responses: Response[]; flags: boolean[]; cur: number; screen: Screen; endsAt: number | null; started: boolean; name: string; section: 1 | 2; scale: number; filter: 'all' | 'incomplete' | 'marked'; contrast?: boolean; hideTime?: boolean }
  const BRAND = $('xs').dataset.brand ?? '';
  const PRE: [Screen, string][] = [['welcome', 'Welcome'], ['agree', 'Agreement'], ['intro', 'Exam features'], ['start', 'Start']];
  const steps = (cur: Screen) => `<p class="xs-steps" aria-label="Before the exam">${PRE.map(([k, l], i) => `<span ${k === cur ? 'aria-current="step"' : ''}>${i + 1}. ${l}</span>`).join('')}</p>`;
  const brandFoot = () => `<p class="xs-brandline">Practice exam by ${esc(BRAND)}. Not affiliated with Microsoft or any exam delivery provider.</p>`;
  const tools = () => `<ul>
          <li><strong>Previous</strong> and <strong>Next</strong> move between questions. <strong>Review screen</strong> shows every question in the section.</li>
          <li><strong>⚑ Mark for review</strong> flags a question so you can find it fast on the review screen.</li>
          <li><strong>− / +</strong> zooms the question text from 90% to 180%.</li>
          <li><strong>◐ Contrast</strong> switches to white text on black.</li>
          <li><strong>Hide time</strong> hides the countdown. It shows again in the last 5 minutes.</li>
          <li><strong>? Help</strong> opens these instructions at any time.</li>
          <li>Keyboard: <span class="xs-kbd">Alt+N</span> next, <span class="xs-kbd">Alt+P</span> previous, <span class="xs-kbd">Alt+R</span> review screen, <span class="xs-kbd">Alt+M</span> mark for review.</li>
        </ul>`;
  let st: State | null = null;
  let tick = 0;
  let pick: number | null = null; // selected tile (click-to-place drag and drop)

  const persist = () => { try { if (st) sessionStorage.setItem(SKEY, JSON.stringify(st)); else sessionStorage.removeItem(SKEY); } catch {} };
  const item = () => st!.paper.items[st!.cur];
  const sec1Count = () => st!.paper.section2Start;
  const hasSec2 = () => st!.paper.items.length > st!.paper.section2Start;

  /* ---------- rendering one item in the exam room ---------- */
  function renderItem(q: Item, r: Response): string {
    const scn = 'scenario' in q && q.scenario ? `<div class="xs-scn">${esc(q.scenario)}</div>` : '';
    switch (q.kind) {
      case 'single':
      case 'multi': {
        const multi = q.kind === 'multi';
        const n = q.answer.length;
        const note = multi ? `<p class="xs-note">Each correct answer presents part of the solution. <strong>Select ${n === 2 ? 'two' : n === 3 ? 'three' : n}.</strong> NOTE: Each correct selection is worth one point.</p>` : '';
        return `${scn}<h2>${esc(q.question)}</h2>${note}<div class="xs-opts" role="${multi ? 'group' : 'radiogroup'}">${q.options.map((o, i) => `<label class="xs-opt"><input type="${multi ? 'checkbox' : 'radio'}" name="opt" value="${i}" ${(r as number[]).includes(i) ? 'checked' : ''}><span><strong>${String.fromCharCode(65 + i)}.</strong> ${esc(o.text)}</span></label>`).join('')}</div>`;
      }
      case 'yesno':
        return `${scn}<h2>For each of the following statements, select Yes if the statement is true. Otherwise, select No.</h2><p class="xs-note">NOTE: Each correct selection is worth one point.</p>
          <table class="xs-yn"><thead><tr><th>Statements</th><th class="c">Yes</th><th class="c">No</th></tr></thead><tbody>${q.statements.map((s, i) => `<tr><td>${esc(s.text)}</td><td class="c"><input type="radio" name="yn${i}" value="1" aria-label="Yes" ${(r as (boolean | null)[])[i] === true ? 'checked' : ''}></td><td class="c"><input type="radio" name="yn${i}" value="0" aria-label="No" ${(r as (boolean | null)[])[i] === false ? 'checked' : ''}></td></tr>`).join('')}</tbody></table>`;
      case 'match': {
        const resp = r as (number | null)[];
        return `${scn}<h2>${esc(q.question)}</h2><p class="xs-note">NOTE: Each correct match is worth one point. Drag an item onto a box, or click an item and then click a box. Click a filled box to clear it.</p>
          <div class="xs-cols"><div class="xs-panel"><p>${esc(q.itemsLabel)}</p><div class="xs-in">${q.items.map((it, i) => `<button type="button" class="xs-tile" draggable="true" data-tile="${i}" aria-pressed="${pick === i}">${esc(it)}</button>`).join('')}</div></div>
          <div class="xs-panel"><p>Answer Area</p><div class="xs-in">${q.targets.map((t, i) => `<div class="xs-target"><span>${esc(t.text)}</span><button type="button" class="xs-slot ${resp[i] !== null ? 'filled' : ''}" data-slot="${i}" aria-label="Answer for: ${esc(t.text)}">${resp[i] !== null ? esc(q.items[resp[i]!]) : '&nbsp;'}</button></div>`).join('')}</div></div></div>`;
      }
      case 'order': {
        const seq = r as number[];
        const left = q.actions.map((_, i) => i).filter((i) => !seq.includes(i));
        return `${scn}<h2>${esc(q.question)}</h2><p class="xs-note">Select an action and use the arrows, or drag actions into the Answer Area and put them in order.</p>
          <div class="xs-cols" style="grid-template-columns:minmax(0,1fr) auto minmax(0,1fr)"><div class="xs-panel"><p>Actions</p><div class="xs-in" data-drop="actions">${left.map((i) => `<button type="button" class="xs-tile" draggable="true" data-act-i="${i}" aria-pressed="${pick === i}">${esc(q.actions[i])}</button>`).join('') || '<span class="xs-note">All actions moved.</span>'}</div></div>
          <div class="xs-arrows"><button type="button" class="xs-mini" data-ord="add" title="Move selected action to the answer area" aria-label="Move to answer area">›</button><button type="button" class="xs-mini" data-ord="remove" title="Move selected action back" aria-label="Move back to actions">‹</button></div>
          <div class="xs-panel"><p>Answer Area</p><div class="xs-in" data-drop="answer">${seq.map((i, k) => `<div class="xs-order-row"><span>${k + 1}.</span><button type="button" class="xs-tile" draggable="true" data-seq="${k}" aria-pressed="${pick === i}">${esc(q.actions[i])}</button><button type="button" class="xs-mini" data-ord="up" data-k="${k}" aria-label="Move up" ${k === 0 ? 'disabled' : ''}>▲</button><button type="button" class="xs-mini" data-ord="down" data-k="${k}" aria-label="Move down" ${k === seq.length - 1 ? 'disabled' : ''}>▼</button></div>`).join('') || '<span class="xs-note">Move actions here.</span>'}</div></div></div>`;
      }
      case 'dropdown': {
        let b = -1;
        return `${scn}<h2>${esc(q.question)}</h2><p class="xs-note">NOTE: Each correct selection is worth one point.</p><div class="xs-panel"><p>Answer Area</p><div class="xs-in xs-sent">${q.parts.map((p) => {
          if (typeof p === 'string') return esc(p);
          b++;
          const v = (r as (number | null)[])[b];
          return `<select data-blank="${b}" aria-label="Choose an option"><option value="" ${v === null ? 'selected' : ''}>▼</option>${p.options.map((o, i) => `<option value="${i}" ${v === i ? 'selected' : ''}>${esc(o)}</option>`).join('')}</select>`;
        }).join('')}</div></div>`;
      }
    }
  }

  /* ---------- exam room screens ---------- */
  function paint() {
    const s = st!;
    const body = $('xs-body');
    const foot = $('xs-foot');
    $('xs-cand').textContent = s.name ? `Candidate: ${s.name}` : '';
    $('xs').style.setProperty('--xs-scale', String(s.scale));
    $('xs').classList.toggle('hc', !!s.contrast);
    $('xs-contrast').setAttribute('aria-pressed', String(!!s.contrast));
    $('xs-zoom-pct').textContent = `${Math.round(s.scale * 100)}%`;
    $('xs-mark').hidden = !(s.screen === 'q' && s.section === 1);
    $('xs-mark').setAttribute('aria-pressed', String(s.flags[s.cur] ?? false));
    $('xs-hide-time').hidden = s.endsAt === null;
    const n1 = sec1Count();
    if (s.screen === 'welcome') {
      $('xs-pos').textContent = 'Welcome';
      body.innerHTML = `<div class="xs-welcome">${steps('welcome')}<h1>Welcome to the MSDEVBUILD practice exam${s.name ? `, ${esc(s.name)}` : ''}</h1>
        <p>This screen works like the one you'll see on exam day. Take a moment to check the details below before you go on.</p>
        <dl class="xs-facts"><dt>Exam</dt><dd>${esc(data.name)} (${esc(data.code)}) practice exam</dd>
          <dt>Candidate</dt><dd>${s.name ? esc(s.name) : 'Not given'}</dd>
          <dt>Questions</dt><dd>${s.paper.items.length}${hasSec2() ? ` in 2 sections (${n1} + ${s.paper.items.length - n1})` : ''}</dd>
          <dt>Time</dt><dd>${s.endsAt === null ? 'No time limit' : `${s.paper.minutes} minutes. The timer starts when you start the section.`}</dd>
          <dt>Passing score</dt><dd>700 on a scale of 1 to 1000</dd></dl>
        <p>Select <strong>Next</strong> to read the practice agreement.</p>${brandFoot()}</div>`;
      foot.innerHTML = `<button class="xs-btn" data-x="quit">Exit</button><button class="xs-btn primary" data-x="screen" data-s="agree">Next ▶</button>`;
      persist();
      return;
    }
    if (s.screen === 'agree') {
      $('xs-pos').textContent = 'Practice agreement';
      body.innerHTML = `<div class="xs-welcome">${steps('agree')}<h1>Practice agreement and terms of use</h1>
        <div class="xs-box xs-terms" tabindex="0" aria-label="Agreement text"><ol>
          <li>Every question in this exam was written by MSDEVBUILD from the official ${esc(data.code)} skills outline. None are real, recalled or leaked Microsoft exam questions.</li>
          <li>This is a practice simulation for learning. It isn't affiliated with, endorsed by or delivered by Microsoft or any exam delivery provider.</li>
          <li>Your score is a rough indication. A pass here doesn't guarantee a pass on the real exam, and the MSDEVBUILD certificate isn't a Microsoft credential.</li>
          <li>Your answers, score and certificate stay in this browser. Nothing is sent anywhere, and there's no sign-in.</li>
          <li>On the real exam you sign a non-disclosure agreement and can't share its questions. Please don't post real exam content here or anywhere else.</li>
        </ol></div>
        <p>Select <strong>Accept</strong> to continue, or <strong>Decline</strong> to leave the exam.</p>${brandFoot()}</div>`;
      foot.innerHTML = `<button class="xs-btn" data-x="screen" data-s="welcome">◀ Previous</button><span class="xs-mid"><button class="xs-btn" data-x="decline">Decline</button><button class="xs-btn primary" data-x="screen" data-s="intro">Accept ▶</button></span>`;
      persist();
      return;
    }
    if (s.screen === 'intro') {
      $('xs-pos').textContent = 'Exam features';
      body.innerHTML = `<div class="xs-welcome">${steps('intro')}<h1>How this exam works</h1>
        <h2>Question types</h2><ul>
          <li><strong>Multiple choice / multiple response</strong>: select one answer, or the number of answers asked for.</li>
          <li><strong>Drag and drop</strong>: drag each item to a box in the Answer Area, or select an item and then select a box.</li>
          <li><strong>Build list</strong>: move the right actions into the Answer Area and put them in order.</li>
          <li><strong>Drop-down</strong>: complete the sentence by choosing from each list.</li>
          ${hasSec2() ? '<li><strong>Yes/No statements</strong> (Section 2): once you answer a question and select Next, you <strong>can\'t</strong> return to it.</li>' : ''}
        </ul>
        <h2>Tools on screen</h2>${tools()}
        <div class="xs-box">Questions can be worth more than one point. There's no penalty for a wrong answer, so answer every question.</div>${brandFoot()}</div>`;
      foot.innerHTML = `<button class="xs-btn" data-x="screen" data-s="agree">◀ Previous</button><button class="xs-btn primary" data-x="screen" data-s="start">Next ▶</button>`;
      persist();
      return;
    }
    if (s.screen === 'start') {
      $('xs-pos').textContent = hasSec2() ? 'Section 1 of 2' : 'Start';
      body.innerHTML = `<div class="xs-welcome">${steps('start')}<h1>${hasSec2() ? 'Section 1 of 2' : 'Ready to start'}</h1>
        <p>This ${hasSec2() ? 'section' : 'exam'} contains <strong>${n1} questions</strong>. You can mark questions, go back and change answers until you finish ${hasSec2() ? 'the section' : 'the exam'} from the review screen.</p>
        ${s.endsAt === null ? '<p>There is no time limit.</p>' : `<p>You have <strong>${s.paper.minutes} minutes</strong> for the whole exam. The timer starts when you select <strong>Start</strong>.</p>`}
        <p>Good luck. Read the last line of each question first.</p>${brandFoot()}</div>`;
      foot.innerHTML = `<button class="xs-btn" data-x="screen" data-s="intro">◀ Previous</button><button class="xs-btn primary" data-x="start">Start ▶</button>`;
      persist();
      return;
    }
    if (s.screen === 'sec2') {
      $('xs-pos').textContent = 'Section 2';
      body.innerHTML = `<div class="xs-welcome"><h1>Section 2: Yes/No questions</h1><div class="xs-lock">⚠️ After you answer a question in this section, you will <strong>NOT</strong> be able to return to it. As a result, these questions will not appear in the review screen.</div><p>This section contains <strong>${s.paper.items.length - n1}</strong> questions. Each has several statements; select Yes or No for each one.</p></div>`;
      foot.innerHTML = `<span></span><button class="xs-btn primary" data-x="sec2go">Next ▶</button>`;
      persist();
      return;
    }
    if (s.screen === 'review') {
      $('xs-pos').textContent = hasSec2() ? 'Review screen · Section 1 of 2' : 'Review screen';
      const rows = s.paper.items.slice(0, n1).map((q, i) => ({ i, a: answered(q, s.responses[i]), m: s.flags[i] }))
        .filter((x) => s.filter === 'all' || (s.filter === 'marked' ? x.m : x.a !== 'all'));
      const inc = s.paper.items.slice(0, n1).filter((q, i) => answered(q, s.responses[i]) !== 'all').length;
      const marked = s.flags.slice(0, n1).filter(Boolean).length;
      const label = (a: string) => (a === 'all' ? 'Answered' : a === 'some' ? 'Incomplete' : 'Unanswered');
      body.innerHTML = `<div class="xs-rev"><h2 style="font-size:1.1em;font-weight:600">Review your answers</h2>
        <p class="xs-note">Select a question to go back to it. <strong>${inc}</strong> incomplete · <strong>${marked}</strong> marked for review.${hasSec2() ? ' Section 2 questions don\'t appear here.' : ''}</p>
        <div class="xs-filters" role="group" aria-label="Filter questions">${(['all', 'incomplete', 'marked'] as const).map((f) => `<button class="xs-btn" data-filter="${f}" aria-pressed="${s.filter === f}">Review ${f}</button>`).join('')}</div>
        <p class="xs-legend"><span><i style="background:#107c10"></i>Answered</span><span><i style="background:#c50f1f"></i>Incomplete or unanswered</span><span>⚑ Marked for review</span></p>
        <div class="xs-grid">${rows.map((x) => `<button type="button" class="xs-cell" data-goto="${x.i}" data-a="${x.a}"><b>Question ${x.i + 1}</b>${x.m ? '<span class="fl" aria-label="Marked for review">⚑</span>' : '<span></span>'}<span class="st">${label(x.a)} · ${KIND_LABEL[s.paper.items[x.i].kind]}</span></button>`).join('') || '<p>Nothing to show for this filter.</p>'}</div></div>`;
      foot.innerHTML = `<button class="xs-btn" data-x="resume-q">◀ Back to question ${s.cur + 1}</button><button class="xs-btn primary" data-x="finish1">${hasSec2() ? 'Finish section 1' : 'End exam'}</button>`;
      persist();
      return;
    }
    const q = item();
    $('xs-pos').textContent = s.section === 1 ? `Question ${s.cur + 1} of ${n1}${hasSec2() ? ' · Section 1 of 2' : ''}` : `Question ${s.cur - n1 + 1} of ${s.paper.items.length - n1} · Section 2 of 2`;
    body.innerHTML = `<div class="xs-q">${renderItem(q, s.responses[s.cur])}</div>`;
    if (s.section === 1) {
      const last = s.cur === n1 - 1;
      foot.innerHTML = `<button class="xs-btn" data-x="prev" ${s.cur === 0 ? 'disabled' : ''}>◀ Previous</button><span class="xs-mid"><button class="xs-btn" data-x="review">Review screen</button></span><button class="xs-btn primary" data-x="next">${last ? 'Review ▶' : 'Next ▶'}</button>`;
    } else {
      const last = s.cur === s.paper.items.length - 1;
      foot.innerHTML = `<span></span><button class="xs-btn primary" data-x="next2">${last ? 'Next ▶ (end exam)' : 'Next ▶'}</button>`;
    }
    persist();
  }

  const dialog = (title: string, html: string, buttons: [string, string, boolean?][]) => {
    $('xs-dialog').innerHTML = `<h3 id="xs-dlg-title">${esc(title)}</h3><div class="xs-dbody">${html}</div><div class="xs-dfoot">${buttons.map(([l, x, primary]) => `<button class="xs-btn ${primary ? 'primary' : ''}" data-x="${x}">${esc(l)}</button>`).join('')}</div>`;
    $('xs-modal').hidden = false;
    $('xs-dialog').querySelector<HTMLElement>('.primary')?.focus();
  };
  const closeDialog = () => { $('xs-modal').hidden = true; $('xs-body').focus({ preventScroll: true }); };
  const setResp = (r: Response) => { st!.responses[st!.cur] = r; persist(); };
  const go = (i: number) => { st!.cur = i; st!.screen = 'q'; pick = null; paint(); $('xs-body').scrollTop = 0; $('xs-body').focus(); };

  /* ---------- events ---------- */
  $('xs').addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const x = t.closest<HTMLElement>('[data-x]')?.dataset.x;
    const s = st;
    if (!s) return;
    if (x) {
      const n1 = sec1Count();
      switch (x) {
        case 'quit': return dialog('Exit exam', '<p>Leave the exam room? You can resume this exam until you close this browser tab.</p>', [['Stay', 'close', true], ['Exit', 'exit']]);
        case 'exit': closeDialog(); return closeRoom();
        case 'close': return closeDialog();
        case 'screen': s.screen = t.closest<HTMLElement>('[data-s]')!.dataset.s as Screen; paint(); $('xs-body').scrollTop = 0; return $('xs-body').focus();
        case 'decline': return dialog('Decline agreement', '<p>You need to accept the practice agreement to sit this exam. Decline and leave the exam room?</p>', [['Back to agreement', 'close', true], ['Leave exam', 'exit']]);
        case 'resume-q': return go(s.cur);
        case 'start':
          s.started = true;
          if (s.endsAt !== null) s.endsAt = Date.now() + s.paper.minutes * 60_000;
          startTimer();
          return go(0);
        case 'prev': return go(Math.max(0, s.cur - 1));
        case 'next': if (s.cur < n1 - 1) return go(s.cur + 1); s.screen = 'review'; s.filter = 'all'; return paint();
        case 'review': s.screen = 'review'; s.filter = 'all'; return paint();
        case 'finish1': {
          const inc = s.paper.items.slice(0, n1).filter((q, i) => answered(q, s.responses[i]) !== 'all').length;
          return dialog(hasSec2() ? 'Finish section 1' : 'End exam', `<p>${inc ? `<strong>${inc}</strong> question${inc > 1 ? 's are' : ' is'} incomplete. ` : 'All questions answered. '}${hasSec2() ? 'Once you finish this section, you <strong>cannot return</strong> to it.' : 'Once you end the exam you cannot change your answers.'}</p>`, [['Return to review', 'close'], [hasSec2() ? 'Finish section' : 'End exam', hasSec2() ? 'to-sec2' : 'end', true]]);
        }
        case 'to-sec2': closeDialog(); s.section = 2; s.screen = 'sec2'; s.cur = n1; return paint();
        case 'sec2go': return go(n1);
        case 'next2': {
          const incomplete = answered(item(), s.responses[s.cur]) !== 'all';
          const last = s.cur === s.paper.items.length - 1;
          if (incomplete) return dialog('Incomplete answer', '<p>You have not answered every statement. After you continue you <strong>cannot return</strong> to this question.</p>', [['Go back', 'close', true], ['Continue', last ? 'end-ask' : 'next2go']]);
          if (last) return dialog('End exam', '<p>This is the last question. End the exam and see your score report?</p>', [['Cancel', 'close'], ['End exam', 'end', true]]);
          return go(s.cur + 1);
        }
        case 'next2go': closeDialog(); return go(s.cur + 1);
        case 'end-ask': return dialog('End exam', '<p>End the exam and see your score report?</p>', [['Cancel', 'close'], ['End exam', 'end', true]]);
        case 'end': closeDialog(); return finish();
      }
      return;
    }
    const z = t.closest<HTMLElement>('[data-zoom]');
    if (z) { s.scale = Math.round(Math.min(1.8, Math.max(0.9, s.scale + Number(z.dataset.zoom) * 0.1)) * 10) / 10; $('xs').style.setProperty('--xs-scale', String(s.scale)); $('xs-zoom-pct').textContent = `${Math.round(s.scale * 100)}%`; persist(); return; }
    const tool = t.closest<HTMLElement>('[data-tool]')?.dataset.tool;
    if (tool === 'mark') { s.flags[s.cur] = !s.flags[s.cur]; $('xs-mark').setAttribute('aria-pressed', String(s.flags[s.cur])); persist(); return; }
    if (tool === 'contrast') { s.contrast = !s.contrast; $('xs').classList.toggle('hc', s.contrast); $('xs-contrast').setAttribute('aria-pressed', String(s.contrast)); persist(); return; }
    if (tool === 'time') { s.hideTime = !s.hideTime; persist(); return updTime(); }
    if (tool === 'help') return dialog('Help', `<p>This is the ${esc(data.code)} practice exam by MSDEVBUILD.</p>${tools()}`, [['Close', 'close', true]]);
    const f = t.closest<HTMLElement>('[data-filter]');
    if (f) { s.filter = f.dataset.filter as State['filter']; return paint(); }
    const g = t.closest<HTMLElement>('[data-goto]');
    if (g) return go(Number(g.dataset.goto));
    const q = s.screen === 'q' ? item() : null;
    if (!q) return;
    if (q.kind === 'match') {
      const tile = t.closest<HTMLElement>('[data-tile]');
      const slot = t.closest<HTMLElement>('[data-slot]');
      if (tile) { const i = Number(tile.dataset.tile); pick = pick === i ? null : i; return paint(); }
      if (slot) {
        const k = Number(slot.dataset.slot);
        const r = [...(s.responses[s.cur] as (number | null)[])];
        if (pick !== null) { r[k] = pick; pick = null; } else r[k] = null;
        setResp(r);
        return paint();
      }
    }
    if (q.kind === 'order') {
      const seq = [...(s.responses[s.cur] as number[])];
      const a = t.closest<HTMLElement>('[data-act-i]');
      const sq = t.closest<HTMLElement>('[data-seq]');
      const ord = t.closest<HTMLElement>('[data-ord]');
      if (a) { const i = Number(a.dataset.actI); pick = pick === i ? null : i; return paint(); }
      if (sq) { const i = seq[Number(sq.dataset.seq)]; pick = pick === i ? null : i; return paint(); }
      if (ord) {
        const op = ord.dataset.ord;
        if (op === 'add' && pick !== null && !seq.includes(pick)) { seq.push(pick); pick = null; }
        else if (op === 'remove' && pick !== null && seq.includes(pick)) { seq.splice(seq.indexOf(pick), 1); pick = null; }
        else if (op === 'up' || op === 'down') { const k = Number(ord.dataset.k), j = op === 'up' ? k - 1 : k + 1; [seq[k], seq[j]] = [seq[j], seq[k]]; }
        setResp(seq);
        return paint();
      }
    }
  });

  $('xs').addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement | HTMLSelectElement;
    const s = st;
    if (!s) return;
    const q = item();
    if (q.kind === 'single') setResp([Number(t.value)]);
    if (q.kind === 'multi') setResp([...$('xs-body').querySelectorAll<HTMLInputElement>('input[name="opt"]:checked')].map((x) => Number(x.value)));
    if (q.kind === 'yesno') { const r = [...(s.responses[s.cur] as (boolean | null)[])]; r[Number(t.name.slice(2))] = t.value === '1'; setResp(r); }
    if (q.kind === 'dropdown') { const r = [...(s.responses[s.cur] as (number | null)[])]; r[Number((t as HTMLSelectElement).dataset.blank)] = t.value === '' ? null : Number(t.value); setResp(r); }
  });

  document.addEventListener('keydown', (e) => {
    const s = st;
    if (!s || $('xs').hidden) return;
    const modalOpen = !$('xs-modal').hidden;
    if (e.key === 'Escape' && modalOpen) { const c = $('xs-dialog').querySelector<HTMLElement>('[data-x="close"]'); if (c) { e.preventDefault(); closeDialog(); } return; }
    if (!e.altKey || modalOpen) return;
    const press = (sel: string) => { const b = document.querySelector<HTMLButtonElement>(sel); if (b && !b.disabled && !b.hidden) { e.preventDefault(); b.click(); } };
    if (e.code === 'KeyN') press('#xs-foot .xs-btn.primary');
    else if (e.code === 'KeyP') press('#xs-foot [data-x="prev"], #xs-foot [data-x="screen"]:first-child');
    else if (e.code === 'KeyR') press('#xs-foot [data-x="review"]');
    else if (e.code === 'KeyM') press('#xs-mark');
  });

  // HTML5 drag and drop (mouse); click-to-place works everywhere, including touch.
  let dragFrom: { tile?: number; seq?: number } | null = null;
  $('xs').addEventListener('dragstart', (e) => {
    const t = e.target as HTMLElement;
    if (t.dataset.tile) dragFrom = { tile: Number(t.dataset.tile) };
    else if (t.dataset.actI) dragFrom = { tile: Number(t.dataset.actI) };
    else if (t.dataset.seq) dragFrom = { seq: Number(t.dataset.seq) };
    e.dataTransfer?.setData('text/plain', 'x');
  });
  $('xs').addEventListener('dragover', (e) => {
    const zone = (e.target as HTMLElement).closest<HTMLElement>('[data-slot], [data-drop]');
    if (zone && dragFrom) { e.preventDefault(); zone.classList.add('over'); }
  });
  $('xs').addEventListener('dragleave', (e) => { (e.target as HTMLElement).closest('[data-slot]')?.classList.remove('over'); });
  $('xs').addEventListener('drop', (e) => {
    e.preventDefault();
    const s = st, from = dragFrom;
    dragFrom = null;
    if (!s || !from) return;
    const q = item();
    const t = e.target as HTMLElement;
    if (q.kind === 'match') {
      const slot = t.closest<HTMLElement>('[data-slot]');
      if (slot && from.tile !== undefined) { const r = [...(s.responses[s.cur] as (number | null)[])]; r[Number(slot.dataset.slot)] = from.tile; setResp(r); }
    }
    if (q.kind === 'order') {
      const seq = [...(s.responses[s.cur] as number[])];
      const zone = t.closest<HTMLElement>('[data-drop]')?.dataset.drop;
      const overSeq = t.closest<HTMLElement>('[data-seq]');
      const moving = from.tile ?? seq[from.seq!];
      if (zone === 'answer') {
        if (seq.includes(moving)) seq.splice(seq.indexOf(moving), 1);
        const at = overSeq ? Number(overSeq.dataset.seq) : seq.length;
        seq.splice(Math.min(at, seq.length), 0, moving);
      } else if (zone === 'actions' && seq.includes(moving)) seq.splice(seq.indexOf(moving), 1);
      setResp(seq);
    }
    pick = null;
    paint();
  });

  /* ---------- timer, open/close, finish ---------- */
  const fmt = (ms: number) => { const t = Math.max(0, Math.round(ms / 1000)); const h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60; return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`; };
  function updTime() {
    if (!st) return;
    const el = $('xs-time');
    const btn = $('xs-hide-time');
    if (st.endsAt === null) { el.hidden = false; el.textContent = 'Untimed practice'; return; }
    const left = st.started ? st.endsAt - Date.now() : st.paper.minutes * 60_000;
    const low = st.started && left < 5 * 60_000;
    el.hidden = !!st.hideTime && !low;
    btn.textContent = el.hidden ? 'Show time' : 'Hide time';
    btn.hidden = low;
    el.textContent = `Time remaining: ${fmt(left)}`;
    el.classList.toggle('low', low);
    if (st.started && left <= 0) { clearInterval(tick); dialog('Time is up', '<p>The exam time has ended. Your answers will now be scored.</p>', [['See score report', 'end', true]]); }
  }
  function startTimer() {
    clearInterval(tick);
    updTime();
    tick = window.setInterval(updTime, 1000);
  }
  function openRoom() {
    $('xs').hidden = false;
    document.documentElement.style.overflow = 'hidden';
    startTimer();
    paint();
  }
  function closeRoom() {
    clearInterval(tick);
    $('xs').hidden = true;
    document.documentElement.style.overflow = '';
  }
  function finish() {
    const s = st!;
    closeRoom();
    const r = result(s.paper.items, s.responses);
    const mock: MockResult = { score: r.earned, total: r.possible, percent: r.percent, scaled: r.scaled, mode: s.paper.mode, domains: r.domains, at: new Date().toISOString() };
    saveMock(mock);
    // Every answered item feeds spaced repetition; full marks count as right.
    recordAnswers(location.pathname.split('/')[1], s.paper.items.map((q, i) => ({ q, i, sc: score(q, s.responses[i]) })).filter(({ q, i }) => answered(q, s.responses[i]) !== 'none').map(({ q, sc }) => ({ id: q.id, ok: sc.earned === sc.possible })));
    st = null;
    persist();
    report(s, r, mock);
  }

  /* ---------- score report ---------- */
  function reviewItem(q: Item, resp: Response, i: number, flagged: boolean): string {
    const sc = score(q, resp);
    const a = answered(q, resp);
    const state = a === 'none' ? 'none' : sc.earned === sc.possible ? 'ok' : sc.earned > 0 ? 'part' : 'bad';
    const badge = { ok: '✓ Correct', part: `◐ Partially correct (${sc.earned}/${sc.possible})`, bad: '✕ Incorrect', none: '○ Not answered' }[state];
    const mark = (ok: boolean) => (ok ? '<span class="sr-ok">✓</span>' : '<span class="sr-bad">✕</span>');
    let detail = '';
    switch (q.kind) {
      case 'single': case 'multi': {
        const picks = resp as number[];
        detail = `<div class="mt-3 space-y-2">${q.options.map((o, k) => { const isAns = q.answer.includes(k), picked = picks.includes(k); const s2 = isAns ? (picked ? 'correct' : 'missed') : picked ? 'wrong' : ''; return `<div class="opt" data-state="${s2}" style="cursor:default"><span class="w-4 font-bold">${isAns ? '✓' : picked ? '✕' : ''}</span><span class="flex-1"><span class="block">${esc(o.text)}</span><span class="why mt-1 block">${esc(o.why)}</span></span></div>`; }).join('')}</div>`;
        break;
      }
      case 'yesno': { const rr = resp as (boolean | null)[]; detail = `<table class="mt-3"><thead><tr><th>Statement</th><th>Your answer</th><th>Correct</th></tr></thead><tbody>${q.statements.map((s, k) => `<tr><td>${esc(s.text)}</td><td>${rr[k] === null ? '—' : rr[k] ? 'Yes' : 'No'} ${rr[k] === null ? '' : mark(rr[k] === s.answer)}</td><td><strong>${s.answer ? 'Yes' : 'No'}</strong></td></tr>`).join('')}</tbody></table>`; break; }
      case 'match': { const rr = resp as (number | null)[]; detail = `<table class="mt-3"><thead><tr><th>Answer area</th><th>Your answer</th><th>Correct</th></tr></thead><tbody>${q.targets.map((t, k) => `<tr><td>${esc(t.text)}</td><td>${rr[k] === null ? '—' : esc(q.items[rr[k]!])} ${rr[k] === null ? '' : mark(rr[k] === t.answer)}</td><td><strong>${esc(q.items[t.answer])}</strong></td></tr>`).join('')}</tbody></table>`; break; }
      case 'order': { const seq = resp as number[]; detail = `<div class="mt-3 grid gap-3 sm:grid-cols-2"><div><p class="text-sm font-semibold">Your order</p><ol class="mt-1 list-decimal space-y-1 pl-5">${seq.map((x, k) => `<li>${esc(q.actions[x])} ${mark(q.answer[k] === x)}</li>`).join('') || '<li class="text-muted">Nothing placed</li>'}</ol></div><div><p class="text-sm font-semibold">Correct order</p><ol class="mt-1 list-decimal space-y-1 pl-5">${q.answer.map((x) => `<li><strong>${esc(q.actions[x])}</strong></li>`).join('')}</ol></div></div>`; break; }
      case 'dropdown': { const rr = resp as (number | null)[]; let b = -1; detail = `<p class="mt-3 leading-loose">${q.parts.map((p) => { if (typeof p === 'string') return esc(p); b++; const v = rr[b]; return v === p.answer ? `<span class="sr-badge ok">${esc(p.options[v])}</span>` : `${v === null ? '<span class="sr-badge none">—</span>' : `<s class="sr-badge bad">${esc(p.options[v])}</s>`} <span class="sr-badge ok">${esc(p.options[p.answer])}</span>`; }).join('')}</p>`; break; }
    }
    const topic = q.kind === 'single' || q.kind === 'multi' ? q.topic : undefined;
    const study = topic && data.topicTitle[topic] ? `<a class="text-sm text-accent underline" href="${data.topicTitle[topic].url}">Study: ${data.topicTitle[topic].title}</a>` : '';
    const text = q.kind === 'yesno' ? 'For each statement, select Yes if it is true. Otherwise, select No.' : q.question;
    return `<li class="sr-item" data-state="${state}" data-flagged="${flagged}">
      <div class="flex flex-wrap items-center gap-2 text-sm"><span class="sr-badge ${state}">${badge}</span><span class="text-muted">Question ${i + 1} · ${KIND_LABEL[q.kind]} · Domain ${q.domain}</span>${flagged ? '<span class="chip">⚑ marked</span>' : ''}</div>
      ${'scenario' in q && q.scenario ? `<p class="mt-2 rounded-xl bg-subtle p-3">${esc(q.scenario)}</p>` : ''}
      <p class="mt-2 font-semibold">${esc(text)}</p>${detail}
      <p class="mt-3 rounded-xl border border-default bg-[var(--bg)] p-3 text-[0.95rem]"><strong>Explanation:</strong> ${esc(q.explanation)}</p>${study ? `<div class="mt-2">${study}</div>` : ''}</li>`;
  }

  function report(s: State, r: ReturnType<typeof result>, mock: MockResult) {
    $('setup').classList.add('hidden');
    const out = $('results');
    out.classList.remove('hidden');
    const counts = { ok: 0, part: 0, bad: 0, none: 0 };
    s.paper.items.forEach((q, i) => { const sc = score(q, s.responses[i]); const a = answered(q, s.responses[i]); counts[a === 'none' ? 'none' : sc.earned === sc.possible ? 'ok' : sc.earned > 0 ? 'part' : 'bad']++; });
    const full = s.paper.mode === 'full';
    const certOk = full && r.passed;
    const existing = loadCert();
    const date = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    out.innerHTML = `
      <div class="card overflow-hidden">
        <div class="flex flex-wrap items-center gap-4 border-b border-default p-6">
          <div class="min-w-0 flex-1"><p class="text-sm font-bold tracking-[0.12em] text-accent uppercase">Score report</p>
            <h2 id="sr-title" class="mt-1 text-2xl font-bold">${data.name} (${data.code}) · Practice exam</h2>
            <p class="mt-1 text-sm text-muted">${s.name ? `Candidate: <strong class="text-[var(--text)]">${esc(s.name)}</strong> · ` : ''}${date} · ${full ? 'Full exam' : s.paper.mode === 'quick' ? 'Quick practice' : 'Domain practice'} · ${s.paper.items.length} questions</p></div>
          <span class="sr-badge ${r.passed ? 'ok' : 'bad'}" style="font-size:1.4rem;padding:.4rem 1.2rem">${r.passed ? 'PASS' : 'FAIL'}</span>
        </div>
        <div class="grid gap-8 p-6 md:grid-cols-2">
          <div>
            <p class="text-sm text-muted">Your score</p><p class="text-5xl font-bold">${r.scaled}</p><p class="text-sm text-muted">Passing score: <strong>700</strong> · ${r.earned} of ${r.possible} points (${r.percent}%)</p>
            <div class="sr-scale mt-5" aria-hidden="true"><span class="sr-pass"></span><span class="sr-you" style="left:${r.scaled / 10}%"></span></div>
            <div class="relative mt-1 h-4 text-xs text-muted"><span class="absolute left-0">1</span><span class="absolute left-[70%] -translate-x-1/2 font-semibold">700 pass</span><span class="absolute right-0">1000</span></div>
            <div class="mt-5 grid grid-cols-4 gap-2 text-center text-sm">
              <div class="rounded-lg bg-[var(--ok-soft)] p-2"><p class="text-xl font-bold sr-ok">${counts.ok}</p>Correct</div>
              <div class="rounded-lg bg-[var(--warn-soft)] p-2"><p class="text-xl font-bold sr-part">${counts.part}</p>Partial</div>
              <div class="rounded-lg bg-[var(--bad-soft)] p-2"><p class="text-xl font-bold sr-bad">${counts.bad}</p>Incorrect</div>
              <div class="rounded-lg bg-[var(--pastel-grey)] p-2"><p class="text-xl font-bold">${counts.none}</p>Unanswered</div>
            </div>
          </div>
          <div>
            <h3 class="font-semibold">Skills measured · your performance</h3>
            <div class="mt-3 space-y-4">${Object.entries(r.domains).sort().map(([d, v]) => { const p = Math.round((v.ok / Math.max(1, v.total)) * 100); return `<div><div class="flex justify-between gap-2 text-sm"><span>${esc(domainTitle(Number(d)))}</span><span class="font-semibold">${p}%</span></div><div class="bar mt-1"><span style="width:${p}%;background:${p >= 70 ? 'var(--ok)' : 'var(--bad)'}"></span></div><p class="mt-0.5 text-xs text-muted">${p >= 80 ? 'Strong' : p >= 70 ? 'Passing range' : 'Needs work: review this domain'}</p></div>`; }).join('')}</div>
            <p class="mt-4 text-xs text-muted">The 1–1000 figure is a rough indication on Microsoft’s reporting scale. Real exam scoring is not a simple percentage.</p>
          </div>
        </div>
      </div>

      <div class="mt-6 rounded-2xl border-2 ${certOk ? 'border-[#ffb900] bg-[var(--pastel-yellow)]' : 'border-default bg-[var(--card)]'} p-6">
        ${certOk ? `<div class="flex flex-wrap items-center gap-4"><span class="text-5xl" aria-hidden="true">🏆</span><div class="min-w-0 flex-1"><p class="text-xl font-bold">You passed! Get your MSDEVBUILD certificate</p><p class="text-sm">Your ${data.code} Ready certificate and badge, ready to share on LinkedIn, X and WhatsApp.</p></div></div>
          <form id="sr-cert-form" class="mt-4 flex flex-col gap-3 sm:flex-row"><label class="flex-1"><span class="sr-only">Name on certificate</span><input id="sr-cert-name" required maxlength="60" value="${esc(s.name || existing?.name || '')}" placeholder="Your full name" class="w-full rounded-md border border-default bg-[var(--bg)] px-4 py-3 text-lg" /></label><button class="rounded-md bg-[#107c10] px-6 py-3 font-semibold text-white hover:bg-[#0b5a0b]">Get my certificate »</button></form>`
        : `<div class="flex flex-wrap items-center gap-4"><span class="text-4xl" aria-hidden="true">🎓</span><div class="min-w-0 flex-1"><p class="font-bold">${full ? 'Score 700 or more to earn your MSDEVBUILD certificate' : 'Take the full exam to earn your MSDEVBUILD certificate'}</p><p class="text-sm text-muted">${full ? 'Review the questions below, study the domains marked “Needs work”, and try again.' : 'Practice runs don’t issue certificates. The full 45-question exam does, at a score of 700+.'}</p></div><button id="sr-again-top" class="btn btn-accent">${full ? 'Retake the exam' : 'Take the full exam'}</button></div>`}
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-2">
        <h3 class="mr-auto text-xl font-bold">Answer summary</h3>
        <div role="group" aria-label="Filter answers" class="flex flex-wrap gap-1 text-sm">
          <button type="button" class="btn btn-outline btn-sm" data-rf="all">All (${s.paper.items.length})</button>
          <button type="button" class="btn btn-outline btn-sm" data-rf="wrong">Incorrect, partial or unanswered (${counts.bad + counts.part + counts.none})</button>
          <button type="button" class="btn btn-outline btn-sm" data-rf="ok">Correct (${counts.ok})</button>
          <button type="button" class="btn btn-outline btn-sm" data-rf="marked">Marked</button>
        </div>
      </div>
      <ol id="sr-list" class="mt-4 space-y-4">${s.paper.items.map((q, i) => reviewItem(q, s.responses[i], i, s.flags[i])).join('')}</ol>
      <div class="mt-8 flex flex-wrap gap-3"><button type="button" id="sr-again" class="btn btn-accent">Take another exam</button><a href="/progress/" class="btn btn-outline">See my progress</a></div>`;
    scrollTo(0, 0);
    if (r.passed) confetti(220);
    const again = () => { out.classList.add('hidden'); $('setup').classList.remove('hidden'); scrollTo(0, 0); };
    $('sr-again').addEventListener('click', again);
    document.getElementById('sr-again-top')?.addEventListener('click', again);
    out.querySelectorAll<HTMLButtonElement>('[data-rf]').forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.rf;
      out.querySelectorAll<HTMLElement>('#sr-list > li').forEach((li) => {
        li.hidden = f === 'wrong' ? li.dataset.state === 'ok' : f === 'ok' ? li.dataset.state !== 'ok' : f === 'marked' ? li.dataset.flagged !== 'true' : false;
      });
    }));
    document.getElementById('sr-cert-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = ($('sr-cert-name') as HTMLInputElement).value.trim();
      if (!name) return;
      issueCert(name, mock);
      location.href = '/certificate/';
    });
  }

  /* ---------- setup ---------- */
  try { ($('cand-name') as HTMLInputElement).value = localStorage.getItem('msdb-exam-name') ?? loadCert()?.name ?? ''; } catch {}
  $('setup-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(e.target as HTMLFormElement);
    const name = String(fd.get('name') ?? '').trim();
    try { localStorage.setItem('msdb-exam-name', name); } catch {}
    const paper = buildPaper(String(fd.get('mode')), Number(fd.get('domain')), data.choice, data.items, data.weights);
    st = { paper, responses: paper.items.map(emptyResponse), flags: paper.items.map(() => false), cur: 0, screen: 'welcome', endsAt: fd.get('untimed') === 'on' ? null : 0, started: false, name, section: 1, scale: 1, filter: 'all' };
    persist();
    openRoom();
  });
  try {
    const saved = sessionStorage.getItem(SKEY);
    if (saved) {
      const r = $('resume');
      r.classList.remove('hidden');
      r.addEventListener('click', () => { st = JSON.parse(saved); openRoom(); });
    }
  } catch {}
</script>
