---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LearnShell from '../../../components/LearnShell.astro';
import LessonTools from '../../../components/LessonTools.astro';
import LessonHero from '../../../components/LessonHero.astro';
import ProblemSolution from '../../../components/ProblemSolution.astro';
import { labsForTopic, ALL_LABS } from '../../../lib/sim/labs';
import LessonSimulations from '../../../components/LessonSimulations.astro';
import { ogImagePath } from '../../../lib/og-pages';
import { SERVICES } from '../../../data/az-900/services';
import { sectionKind, SIMPLE_SECTIONS } from '../../../lib/rehype-sections.mjs';
import Toc from '../../../components/Toc.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import KnowledgeCheck from '../../../components/KnowledgeCheck.astro';
import InterviewBlock from '../../../components/InterviewBlock.astro';
import QuickRevision from '../../../components/QuickRevision.astro';
import LessonActivities from '../../../components/LessonActivities.astro';
import { mdxComponents } from '../../../components/mdx';
import { getNav, getTopicQuestions, moduleUrl, inlineMd } from '../../../lib/learn';
import { SITE } from '../../../config';
import { getExam, liveExams, moduleBySlug as examModule, objectiveText as examObjective } from '../../../data/exams';

export async function getStaticPaths() {
  const out = [];
  for (const exam of liveExams()) {
    const entries = await getCollection('tutorials', (e) => e.id.startsWith(`${exam.slug}/`));
    for (const entry of entries) {
      const [, module, topic] = entry.id.split('/');
      out.push({ params: { cert: exam.slug, module, topic }, props: { entry } });
    }
  }
  return out;
}
const exam = getExam(Astro.params.cert);

const { entry } = Astro.props;
const { module: moduleSlug, topic: topicSlug } = Astro.params;
const mod = examModule(exam, moduleSlug!)!;
const nav = await getNav(exam.slug);
const me = nav.find((t) => t.key === entry.id)!;
const published = nav.filter((t) => t.published);
const idx = published.findIndex((t) => t.key === entry.id);
const prev = published[idx - 1];
const next = published[idx + 1];
const related = entry.data.related.map((slug) => nav.find((t) => t.slug === slug && t.published)).filter(Boolean);

const { Content, headings } = await render(entry);
const questions = await getTopicQuestions(topicSlug!, exam.slug);
// Labs for the Practice Lab tab: those the lesson text mentions first, then the topic's labs.
const tryItLabs = [...(entry.body ?? '').matchAll(/<TryIt labs="([^"]+)"/g)].flatMap((m) => m[1].split(',').map((x) => x.trim()));
const labs = [...new Set([...tryItLabs, ...labsForTopic(topicSlug!).map((l) => l.id)])].map((id) => ALL_LABS.find((l) => l.id === id)).filter((l): l is NonNullable<typeof l> => Boolean(l));
const d = entry.data;
const hasSims = Boolean(exam.lessonSims[topicSlug!]);
const examTips = d.revision.examTips ?? [];
// Topic cluster links for the sidebar (comparisons, service reference, what-ifs about this lesson).
const lessonCompares = exam.comparisons.filter((c) => c.lessons.includes(topicSlug!));
const lessonServices = SERVICES.filter((s) => s.lesson === topicSlug);
const lessonWhatIfs = exam.whatIfs.filter((w) => w.lessons.includes(topicSlug!));

// Same flow on every lesson: answer → Simulations → Explanation → Exam tip → Quiz → Previous/Next.
const toc = [
  ...(hasSims ? [{ slug: 'simulations', text: 'Simulations', full: false }] : []),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ ...h, full: !SIMPLE_SECTIONS.includes(sectionKind(h.text)) })),
  { slug: 'exam-tip', text: 'Exam tip', full: false },
  ...(questions.length ? [{ slug: 'knowledge-check', text: 'Quiz', full: false }] : []),
  { slug: 'interview-questions', text: 'Interview preparation', full: true },
  { slug: 'quick-revision', text: 'Quick revision', full: true },
];

const url = new URL(Astro.url.pathname, SITE.url).href;
const shareText = `${d.title}: a free ${exam.code} lesson with simulations and a quiz`;
const crumbs = [
  { name: 'Home', url: '/' },
  { name: `${exam.code}`, url: `/${exam.slug}/` },
  { name: mod.shortTitle, url: moduleUrl(mod.slug, exam.slug) },
  { name: d.title, url: Astro.url.pathname },
];
const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    url,
    inLanguage: 'en',
    dateModified: d.updated.toISOString(),
    author: { '@id': `${SITE.url}/#author` },
    publisher: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@id': `${SITE.url}/${exam.slug}/#course` },
    about: me.objectives.map((o) => ({ '@type': 'Thing', name: examObjective(exam, o) })),
    educationalLevel: 'Beginner to advanced',
    learningResourceType: 'Tutorial',
    teaches: d.keyTerms.map((k) => k.term),
    citation: d.references.map((r) => r.url),
    // AEO: the 30-second answer is the part voice assistants should read aloud.
    speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.answer-box'] },
    image: new URL(ogImagePath(Astro.url.pathname), SITE.url).href,
    datePublished: d.updated.toISOString(),
  },
  // AEO: the lesson's knowledge check as Quiz / practice-problem structured data.
  ...(questions.length
    ? [{
        '@type': 'Quiz',
        '@id': `${url}#quiz`,
        name: `${d.title}: ${exam.code} practice quiz`,
        about: { '@id': `${url}#article` },
        educationalLevel: 'Beginner',
        assesses: d.keyTerms.map((k) => k.term),
        educationalAlignment: me.objectives.map((o) => ({ '@type': 'AlignmentObject', alignmentType: 'assesses', educationalFramework: `Microsoft ${exam.code} skills outline`, targetName: `${o} ${examObjective(exam, o)}` })),
        hasPart: questions.map((q) => ({
          '@type': 'Question',
          eduQuestionType: q.type === 'multi' ? 'Checkbox' : 'Multiple choice',
          learningResourceType: 'Practice problem',
          text: q.scenario ? `${q.scenario} ${q.question}` : q.question,
          encodingFormat: 'text/plain',
          suggestedAnswer: q.options.map((o, i) => ({ i, o })).filter(({ i }) => !q.answer.includes(i)).map(({ i, o }) => ({ '@type': 'Answer', position: i, text: o.text, comment: { '@type': 'Comment', text: o.why } })),
          acceptedAnswer: q.answer.map((i) => ({ '@type': 'Answer', position: i, text: q.options[i].text, answerExplanation: { '@type': 'Comment', text: q.explanation } })),
        })),
      }]
    : []),
  // AEO/GEO: questions already answered on the page, as FAQ structured data.
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: [
      [/^(what|why|how|when|which)\b/i.test(d.title) ? `${d.title.replace(/\?$/, '')}?`
        : d.title.includes(': ') ? `What is ${d.title.replace(/^(.*?): (.*)$/, '$1 ($2)')}?`
        : /^(\w+ing|factors)\b|\bvs\b| and /i.test(d.title) ? `What do you need to know about ${d.title} for ${exam.code}?`
        : `What is ${d.title.replace(/^The /, 'the ')}?`, d.answer],
      ...d.revision.quick.map((x) => [x.q, x.a]),
      ...d.interview.filter((x) => x.level === 'beginner').slice(0, 2).map((x) => [x.q, x.a]),
    ].map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: String(a).replace(/\*\*|`/g, '').replace(/\s+/g, ' ').trim() } })),
  },
];
---
<Base title={d.seoTitle} description={d.description} type="article" schema={schema} breadcrumbs={crumbs} modified={d.updated.toISOString()}>
  <LearnShell nav={nav} currentKey={entry.id} prev={prev} next={next} sections={toc} shareText={shareText}>
    <article class="mx-auto max-w-[860px]">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          {crumbs.slice(0, -1).map((c) => <li class="flex items-center gap-1.5"><a class="hover:text-[var(--accent-deep)] hover:underline" href={c.url}>{c.name}</a><span aria-hidden="true">›</span></li>)}
          <li aria-current="page" class="truncate text-[var(--text)]">{d.title}</li>
        </ol>
      </nav>

      <h1 class="mt-3 text-[2.1rem] leading-tight font-semibold tracking-tight sm:text-[2.6rem]">{d.title}</h1>


      <div class="mt-4 flex flex-wrap gap-2 text-xs">
        <span class="chip">Module {mod.domain}: {mod.shortTitle}</span>
        <span class="chip chip-muted">⏱ {d.readingMinutes} min read</span>
        {me.beyondExam && <span class="chip">Beyond the exam: real-world knowledge</span>}
        <span class="chip chip-muted lesson-updated">Updated <time datetime={d.updated.toISOString().slice(0, 10)}>{d.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}</time></span>
      </div>

      <LessonTools />

      <!-- 1 · 30-second answer -->
      <div class="answer-box mt-5" data-speakable>
        <p class="flex items-center gap-3 text-sm font-bold text-accent">30-second answer <button type="button" class="speak-btn" aria-label="Listen to the answer">🔊 Listen</button></p>
        <p class="mt-1 text-[1.05rem] leading-relaxed" set:html={inlineMd(d.answer)} />
        {hasSims && (
          <a href="#simulations" data-sim-tab="3d" class="simulate-btn mt-3 inline-flex items-center gap-2 rounded-md bg-[#107c10] px-5 py-2.5 text-base font-semibold !text-white !no-underline shadow-sm hover:bg-[#0b5a0b]">
            <span aria-hidden="true">▶</span> Simulate it »
          </a>
        )}
        {hasSims && <span class="ml-3 text-sm text-muted">No Azure account needed</span>}
      </div>
      {me.objectives.length > 0 && (
        <p class="mt-3 text-sm text-muted">
          <span class="font-semibold text-[var(--text)]">Exam objective:</span>
          {me.objectives.map((o) => ` ${o} ${examObjective(exam, o)}.`)} <span class="text-xs">(Skills measured as of {exam.skillsMeasuredAsOf})</span>
        </p>
      )}

      <LessonActivities exam={exam} topic={topicSlug!} lessonKey={entry.id} />

      <!-- 2 · Simulations: 3D View | Azure Portal | Practice Lab -->
      <LessonSimulations slug={topicSlug!} labs={labs} />

      <!-- 3 · Explanation -->
      <p class="lesson-step mt-10" aria-hidden="true">📘 Explanation</p>
      <LessonHero topic={topicSlug!} />
      <ProblemSolution topic={topicSlug!} />

      <div class="lesson mt-4">
        <Content components={mdxComponents} />

        <div class="simple-only !mt-8 flex flex-wrap items-center gap-4 rounded-lg bg-[var(--pastel-blue)] p-5">
          <span class="text-4xl" aria-hidden="true">🎓</span>
          <span class="min-w-0 flex-1"><span class="block font-semibold">Ready for more?</span><span class="block text-sm text-muted">The full lesson adds the technical explanation, when to use it, interview questions and revision notes.</span></span>
          <button type="button" class="nav-btn" data-go-full="the-technical-explanation">Show full lesson ❯</button>
        </div>

        <!-- 4 · Exam tip -->
        {examTips.length > 0 && (
          <aside id="exam-tip" class="mt-8 scroll-mt-28 rounded-xl border-l-[5px] border-[#c19c00] bg-[var(--pastel-yellow)] p-4" aria-label="Exam tip">
            <p class="text-sm font-bold">🎯 Exam tip</p>
            <ul class="mt-1 list-disc space-y-1 pl-5 text-[0.98rem] leading-relaxed">{examTips.map((t) => <li set:html={inlineMd(t)} />)}</ul>
          </aside>
        )}

        <!-- 5 · Quiz -->
        {questions.length > 0 && <KnowledgeCheck questions={questions} topicKey={entry.id} />}

        <!-- Extra depth (Full lesson view) -->
        <div class="full-only"><InterviewBlock items={d.interview} /></div>
        <div class="full-only">
          <QuickRevision revision={d.revision} keyTerms={d.keyTerms} />
          <section aria-labelledby="references">
            <h2 id="references">Official references</h2>
            <ul>{d.references.map((r) => <li><a href={r.url} target="_blank" rel="noopener">{r.title} ↗</a></li>)}</ul>
          </section>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3 rounded-lg bg-[var(--pastel-green)] p-4">
        <button id="mark-done" type="button" class="btn btn-primary btn-sm" data-key={entry.id}>Mark topic as complete</button>
        <p class="text-sm">Finished this lesson? Tick it off. Your progress is saved in this browser.</p>
      </div>

      <div class="mt-6 flex items-center justify-between gap-3 border-t border-default pt-6">
        {prev ? <a href={prev.url} class="nav-btn" rel="prev">❮ Previous</a> : <a href={`/${exam.slug}/`} class="nav-btn">❮ Home</a>}
        {next ? <a href={next.url} class="nav-btn" rel="next">Next ❯</a> : <a href={`/${exam.slug}/mock-exam/`} class="nav-btn">Mock exam ❯</a>}
      </div>
      {next && <p class="mt-2 text-right text-sm text-muted">Next up: <a class="text-accent hover:underline" href={next.url}>{next.title}</a></p>}

      <section id="share-lesson" class="mt-8 scroll-mt-28 rounded-lg border border-default bg-[var(--card)] p-4" aria-labelledby="share-lesson-h">
        <h2 id="share-lesson-h" class="text-base font-semibold">Studying with a friend? Send them this lesson</h2>
        <p class="mt-1 text-sm text-muted">It's free and needs no sign-up. Their progress saves in their own browser.</p>
        <ShareButtons url={url} text={shareText} class="mt-3" />
      </section>

      <a href={`/${exam.slug}/games/`} class="mt-8 flex items-center gap-4 rounded-lg bg-[var(--pastel-lilac)] p-4 hover:ring-2 hover:ring-[var(--accent)]">
        <span class="text-4xl" aria-hidden="true">🎮</span>
        <span class="min-w-0 flex-1"><span class="block font-semibold">Lesson done? Make it stick with a quick game</span><span class="block text-sm text-muted">Sort It, Match the Pairs, Lightning Round and Who Am I? Earn XP and badges.</span></span>
        <span class="nav-btn shrink-0">Play ❯</span>
      </a>
    </article>
    <style is:global>
      .lesson-step { font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); border-top: 1px solid var(--card-line); padding-top: 1.25rem; }
    </style>

    <div slot="aside" class="space-y-6">
      <Toc items={toc} />
      {related.length > 0 && (
        <div>
          <p class="mb-2 text-xs font-bold tracking-[0.14em] uppercase text-muted">Related lessons</p>
          <ul class="space-y-1 text-sm">{related.map((r) => <li><a class="text-accent hover:underline" href={r!.url}>{r!.title}</a></li>)}</ul>
        </div>
      )}
      {lessonCompares.length > 0 && (
        <div>
          <p class="mb-2 text-xs font-bold tracking-[0.14em] uppercase text-muted">Compare</p>
          <ul class="space-y-1 text-sm">{lessonCompares.map((c) => <li><a class="text-accent hover:underline" href={`/${exam.slug}/compare/${c.slug}/`}>⚖️ {c.title}</a></li>)}</ul>
        </div>
      )}
      {lessonServices.length > 0 && (
        <div>
          <p class="mb-2 text-xs font-bold tracking-[0.14em] uppercase text-muted">In 60 seconds</p>
          <ul class="space-y-1 text-sm">{lessonServices.map((s) => <li><a class="text-accent hover:underline" href={`/${exam.slug}/services/${s.slug}/`}>{s.icon} {s.name}</a></li>)}</ul>
        </div>
      )}
      {lessonWhatIfs.length > 0 && (
        <div>
          <p class="mb-2 text-xs font-bold tracking-[0.14em] uppercase text-muted">What happens if…?</p>
          <ul class="space-y-1 text-sm">{lessonWhatIfs.map((w) => <li><a class="text-accent hover:underline" href={`/simulator/${w.slug}/`}>{w.emoji} {w.q}</a></li>)}</ul>
        </div>
      )}
    </div>
  </LearnShell>
</Base>
<script>
  import { load, setDone } from '../../../lib/progress';
  // Remember this lesson so the home page can offer "Continue where you left off".
  try {
    const h1 = document.querySelector('article h1')?.textContent?.trim();
    if (h1) localStorage.setItem('msdb-last-lesson', JSON.stringify({ url: location.pathname, title: h1 }));
  } catch {}
  const btn = document.getElementById('mark-done') as HTMLButtonElement | null;
  if (btn) {
    const key = btn.dataset.key!;
    const paint = () => {
      const done = Boolean(load().done[key]);
      btn.textContent = done ? '✓ Completed (click to undo)' : 'Mark topic as complete';
      btn.setAttribute('aria-pressed', String(done));
    };
    btn.addEventListener('click', () => setDone(key, !load().done[key]));
    window.addEventListener('progress-change', paint);
    paint();
  }
</script>
