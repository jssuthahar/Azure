---
/** Human-readable site map: every page, grouped. Also good for crawlers (internal links). */
import Base from '../layouts/Base.astro';
import { getNav } from '../lib/learn';
import { labsForExam, SANDBOX } from '../lib/sim/labs';
import { getExam, liveExams } from '../data/exams';
const exam = getExam();
const x = `/${exam.slug}`;
const SERVICES = exam.services;
const ALL_LABS = [...labsForExam(exam.slug), SANDBOX];
const others = await Promise.all(liveExams().filter((e) => e.slug !== exam.slug).map(async (e) => ({ e, nav: await getNav(e.slug), labs: labsForExam(e.slug) })));
const SERVICE_CATS = [...new Set(SERVICES.map((s) => s.cat))];

const nav = (await getNav()).filter((t) => t.published);
const tools: [string, string][] = [
  ['All certification courses', '/certifications/'], [`${exam.code} course details and syllabus`, `/${exam.slug}/`], [`${exam.code} learning dashboard`, `/${exam.slug}/learn/`], ['3D explorer', `/${exam.slug}/3d-explorer/`], ['Mock exam', `${x}/mock-exam/`], [`${exam.code} Ready certificate`, '/certificate/'],
  ['Smart practice', `${x}/practice/`], ['Study plan', `${x}/study-plan/`], ['Cheat sheet', `${x}/cheat-sheet/`], ['Exam day guide', `${x}/exam-day/`],
  ['Revision flashcards', `${x}/revision/`], ['Interview questions', `${x}/interview/`], ['Glossary', `${x}/glossary/`],
  ['Play & Learn games', `${x}/games/`], ['Daily Challenge', `${x}/games/daily/`], ['Embed simulations', '/embed/'], ['Install the app (offline)', '/app/'],
  ['My progress', '/progress/'], ['About', '/about/'], ['The platform', '/platform/'], ['Sponsor a learning track', '/sponsor/'], ['Privacy policy', '/privacy/'], ['Terms and conditions', '/terms/'],
];
const machine: [string, string, string][] = [
  ['XML sitemap', '/sitemap-index.xml', 'For search engines (Google, Bing)'],
  ['llms.txt', '/llms.txt', 'Site map with one-line answers, for AI assistants'],
  ['llms-full.txt', '/llms-full.txt', 'Full answers with page links, for AI assistants to cite'],
  ['robots.txt', '/robots.txt', 'Crawler rules'],
];
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Site map', url: '/sitemap/' }];
const total = others.reduce((n, o) => n + o.nav.length + o.e.comparisons.length + o.e.services.length + o.labs.length, 0) + nav.length + exam.comparisons.length + SERVICES.length + exam.whatIfs.length + ALL_LABS.length + tools.length;
---
<Base title="Site Map: Every Page on MSDEVBUILD Azure" description={`Every page on MSDEVBUILD Azure in one place: ${nav.length} ${exam.code} lessons, comparisons, Azure services in 60 seconds, simulations, labs, mock exam and tools.`} breadcrumbs={crumbs}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-muted"><a class="hover:underline" href="/">Home</a> / <span class="text-[var(--text)]">Site map</span></nav>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Site map</h1>
    <p class="mt-2 text-lg text-muted">All {total} pages, grouped so you can jump straight to what you need.</p>

    <h2 class="sm-h">📘 {exam.code} lessons</h2>
    <div class="grid gap-8 md:grid-cols-3">
      {exam.modules.map((m) => (
        <section>
          <h3 class="font-semibold"><a class="text-accent hover:underline" href={`${x}/${m.slug}/`}>Domain {m.domain}: {m.shortTitle}</a></h3>
          <ol class="sm-list list-decimal pl-5">{nav.filter((t) => t.module.slug === m.slug).map((t) => <li><a href={t.url}>{t.title}</a></li>)}</ol>
        </section>
      ))}
    </div>

    <div class="mt-4 grid gap-8 md:grid-cols-2">
      <section>
        <h2 class="sm-h">⚖️ Comparisons</h2>
        <ul class="sm-list"><li><a href={`/${exam.slug}/compare/`}><strong>All comparisons</strong></a></li>{exam.comparisons.map((c) => <li><a href={`/${exam.slug}/compare/${c.slug}/`}>{c.title}</a></li>)}</ul>
      </section>
      <section>
        <h2 class="sm-h">⚡ Simulator and labs</h2>
        <ul class="sm-list"><li><a href="/simulator/"><strong>Azure Simulator</strong></a></li>{exam.whatIfs.map((w) => <li><a href={`/simulator/${w.slug}/`}>{w.q}</a></li>)}</ul>
        <ul class="sm-list mt-4"><li><a href={`${x}/labs/`}><strong>Practice labs</strong></a></li>{ALL_LABS.map((l) => <li><a href={`${x}/labs/${l.id}/`}>{`${l.icon} ${l.title}`}</a></li>)}</ul>
      </section>
    </div>

    <h2 class="sm-h">📚 Azure services in 60 seconds</h2>
    <p class="-mt-2 mb-3"><a class="text-accent hover:underline" href={`${x}/services/`}>All services</a></p>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {SERVICE_CATS.map((cat) => (
        <section><h3 class="font-semibold">{cat}</h3><ul class="sm-list">{SERVICES.filter((s) => s.cat === cat).map((s) => <li><a href={`${x}/services/${s.slug}/`}>{s.name}</a></li>)}</ul></section>
      ))}
    </div>

    <div class="mt-4 grid gap-8 md:grid-cols-2">
      <section>
        <h2 class="sm-h">🧰 Practice and tools</h2>
        <ul class="sm-list">{tools.map(([n, h]) => <li><a href={h}>{n}</a></li>)}</ul>
      </section>
      <section>
        <h2 class="sm-h">🤖 For search engines and AI assistants</h2>
        <ul class="sm-list">{machine.map(([n, h, d]) => <li><a href={h}><code>{n}</code></a> <span class="text-sm text-muted">· {d}</span></li>)}</ul>
      </section>
    </div>
    {others.map(({ e, nav: n, labs }) => (
      <Fragment>
        <h2 class="sm-h">🧠 {e.code} lessons · <a class="text-accent hover:underline" href={`/${e.slug}/`}>{e.name}</a></h2>
        <div class="grid gap-8 md:grid-cols-2">
          {e.modules.map((m) => (
            <section>
              <h3 class="font-semibold"><a class="text-accent hover:underline" href={`/${e.slug}/${m.slug}/`}>Domain {m.domain}: {m.shortTitle}</a></h3>
              <ol class="sm-list list-decimal pl-5">{n.filter((t) => t.module.slug === m.slug).map((t) => <li><a href={t.url}>{t.title}</a></li>)}</ol>
            </section>
          ))}
        </div>
        <div class="mt-4 grid gap-8 md:grid-cols-3">
          <section><h3 class="font-semibold">⚖️ Comparisons</h3><ul class="sm-list">{e.comparisons.map((c) => <li><a href={`/${e.slug}/compare/${c.slug}/`}>{c.title}</a></li>)}</ul></section>
          <section><h3 class="font-semibold">🧪 Practice labs</h3><ul class="sm-list"><li><a href={`/${e.slug}/labs/`}><strong>All {e.code} labs</strong></a></li>{labs.map((l) => <li><a href={`/${e.slug}/labs/${l.id}/`}>{`${l.icon} ${l.title}`}</a></li>)}</ul></section>
          <section><h3 class="font-semibold">📚 Services and tools</h3><ul class="sm-list">{e.services.map((sv) => <li><a href={`/${e.slug}/services/${sv.slug}/`}>{sv.name}</a></li>)}<li><a href={`/${e.slug}/mock-exam/`}>{e.code} mock exam</a></li><li><a href={`/${e.slug}/glossary/`}>{e.code} glossary</a></li></ul></section>
        </div>
      </Fragment>
    ))}
  </div>
</Base>
<style>
  .sm-h { margin: 2.25rem 0 .9rem; font-size: 1.5rem; font-weight: 600; }
  .sm-list { margin-top: .5rem; display: grid; gap: .1rem; }
  .sm-list li { padding-block: .2rem; line-height: 1.45; }
  .sm-list a { color: var(--accent); }
  .sm-list a:hover { text-decoration: underline; }
</style>
