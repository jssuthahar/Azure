---
/**
 * Home = DISCOVER. Certifications first; each card leads to its course details
 * page (understand), whose Start learning button opens the learning environment.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import Mascot from '../components/Mascot.astro';
import CloudScene from '../components/scenes/CloudScene.astro';
import TodayBand from '../components/TodayBand.astro';
import BrandLine from '../components/BrandLine.astro';
import CertCard from '../components/course/CertCard.astro';
import SiteSearch from '../components/course/SiteSearch.astro';
import { CERTIFICATIONS, difficulty } from '../data/certifications';
import { getNav, getQuestionBank, getTutorial, inlineMd } from '../lib/learn';
import { LABS } from '../lib/sim/labs';
import { SITE } from '../config';
import { getExam, liveExams } from '../data/exams';

const exam = getExam();
const x = `/${exam.slug}`;
const nav = await getNav();
const published = nav.filter((t) => t.published);
const bank = await getQuestionBank();
const counts: Record<string, { lessons: number; questions: number }> = {};
for (const e of liveExams()) counts[e.slug] = { lessons: (await getNav(e.slug)).filter((t) => t.published).length, questions: (await getQuestionBank(e.slug)).length };
const totalLessons = Object.values(counts).reduce((n, c) => n + c.lessons, 0);
const totalQuestions = Object.values(counts).reduce((n, c) => n + c.questions, 0);

const featured = CERTIFICATIONS.filter((c) => c.featured);
const sample = published[0] ? await getTutorial(published[0].key) : undefined;
const sampleQ = bank.find((q) => q.id === 'd2-arch-10') ?? bank[0];

const LEVELS = [
  { id: 'Fundamentals', icon: '🌱', tone: 'lv-1', who: 'New to the cloud', text: 'Start from zero. Stories first, then the theory.' },
  { id: 'Associate', icon: '🛠️', tone: 'lv-2', who: 'Building and running Azure', text: 'Administer, develop and secure real workloads.' },
  { id: 'Expert', icon: '🏛️', tone: 'lv-3', who: 'Designing at scale', text: 'Architecture and DevOps decisions with trade-offs.' },
] as const;

const why = [
  { icon: '🧊', title: 'Feel it, then learn it', text: 'Every lesson has a 3D scene, an Azure portal walkthrough and a practice lab before the theory.' },
  { icon: '💸', title: 'Free, with no catch', text: 'No paid tier, no sign-in, no credit card. Every lesson, lab and mock exam is open to everyone.' },
  { icon: '🧑‍🏫', title: 'Built by an architect', text: `Lessons come from real project work, not just the docs. Built by ${SITE.author}, ${SITE.authorTitle}.` },
  { icon: '🎯', title: 'Follows the official outline', text: 'Lessons map to Microsoft’s skills outline objective by objective, and we date-stamp every check.' },
  { icon: '📲', title: 'Phone, tablet or laptop', text: 'Install it as an app, study offline on the train, and pick up where you stopped.' },
  { icon: '🔒', title: 'Your progress stays yours', text: 'XP, streaks, quiz scores and your certificate live in your browser. Nothing is tracked to an account.' },
];
const audiences = [
  { icon: '🎒', title: 'School students', text: 'No cloud knowledge needed. Stories about libraries, games and pizza.' },
  { icon: '🎓', title: 'College & freshers', text: 'Cloud basics linked to real IT jobs, with a quiz after every lesson.' },
  { icon: '💻', title: 'Developers', text: 'How Azure services fit into real apps, and when not to use them.' },
  { icon: '🏛️', title: 'Experienced engineers', text: 'Architecture trade-offs, cost, security and scenario interviews.' },
];
const flow = [
  ['⏱️', '30-second answer', 'The idea in two lines, before anything else.'],
  ['🧊', 'Simulations', '3D view, Azure portal and a practice lab, inside the lesson.'],
  ['📖', 'Explanation', 'A story, the plain version, then the technical one.'],
  ['💡', 'Exam tip', 'The trap Microsoft likes to set, and how to spot it.'],
  ['✅', 'Quiz', 'Check yourself. A good score marks the lesson complete.'],
];
const faq = [
  { q: 'Is MSDEVBUILD Azure free?', a: 'Yes. Every course, lesson, simulation, lab, quiz, mock exam and the practice certificate is free. There is no paid plan and nothing is locked.' },
  { q: 'Which certification should I start with?', a: `Start with ${exam.code} (${exam.name}) if you are new to the cloud. It needs no experience and gives you the vocabulary every Associate exam builds on.` },
  { q: 'Do I need an Azure account to practise?', a: 'No. The Azure portal, Cloud Shell and 3D scenes are simulations that run in your browser, so you can practise without a subscription or a surprise bill.' },
  { q: 'Do I need to sign in?', a: 'No. Your progress, XP, streak and certificate are saved in this browser. My Account shows everything you have done so far.' },
  { q: 'Are the practice questions real exam questions?', a: 'No. Every question is original and written to practise the skills in Microsoft’s official outline. We never publish real or leaked exam questions.' },
  { q: 'When will AZ-104, AZ-305 and AZ-500 be ready?', a: 'They are planned. Each course opens once its lessons, questions and mock exam are complete and the exam has been checked on Microsoft Learn.' },
];

// Home targets the queries learners type (exam code, free, practice exam, labs), not just the brand name.
const homeTitle = `Free ${exam.code} Tutorials, Practice Exams & Azure Labs | MSDEVBUILD`;
const homeDescription = `Learn Microsoft Azure ${exam.code} from scratch: free lessons, 3D simulations, portal practice labs, mock exams, quizzes and interview questions. No Azure account needed.`;
const schema = [
  { '@type': 'WebPage', '@id': `${SITE.url}/#home`, name: homeTitle, description: homeDescription, url: `${SITE.url}/`, publisher: { '@id': `${SITE.url}/#organization` }, author: { '@id': `${SITE.url}/#author` } },
  { '@type': 'ItemList', name: 'Featured certification courses', itemListElement: featured.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `${c.code}: ${c.name}`, url: c.status === 'active' ? `${SITE.url}/${c.slug}/` : `${SITE.url}/certifications/#${c.slug}` })) },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PublicLayout title={homeTitle} description={homeDescription} schema={schema}>
  <!-- Hero -->
  <section class="h-hero">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.1fr_1fr]">
      <div class="text-center lg:text-left">
        <BrandLine variant="light" class="mb-3" />
        <h1 class="h-title">Learn Microsoft Technologies. <span>Master Your Certification.</span></h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-[#e3ebf5] lg:mx-0">Explore Microsoft certification courses with beginner-friendly lessons, interactive practice, real-world labs, simulations and mock exams.</p>
        <div class="mx-auto mt-7 max-w-xl lg:mx-0"><SiteSearch id="home-search" placeholder="Search, e.g. IaaS or AZ-900" /></div>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a href="#certifications" class="h-btn h-btn-y">Explore Certifications</a>
          <a href={`${x}/learn/`} id="hero-start" class="h-btn h-btn-o">Start Learning <span aria-hidden="true">→</span></a>
        </p>
        <dl class="mt-8 flex flex-wrap justify-center gap-x-10 gap-y-3 lg:justify-start">
          <div><dt class="text-sm text-[#c9d6e6]">Lessons ready</dt><dd class="text-3xl font-bold">{totalLessons}</dd></div>
          <div><dt class="text-sm text-[#c9d6e6]">Practice questions</dt><dd class="text-3xl font-bold">{totalQuestions}</dd></div>
          <div><dt class="text-sm text-[#c9d6e6]">Price</dt><dd class="text-3xl font-bold">Free</dd></div>
        </dl>
      </div>
      <figure class="scene overflow-hidden rounded-2xl bg-white p-3 shadow-2xl sm:p-5">
        <CloudScene />
        <figcaption class="flex items-center justify-center gap-3 pt-2 text-sm font-medium text-[#0b1020]">
          <span>The cloud: computers you borrow over the internet.</span>
          <button type="button" class="speak-btn text-[#005a9e]" data-say="Imagine your school library lends you any book the moment you ask, and you only pay for the days you keep it. That is cloud computing. Phones, laptops, shops and schools all borrow computers, storage and AI from the cloud over the internet.">🔊 Listen</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Featured certifications -->
  <section id="certifications" class="h-sec scroll-mt-28" aria-labelledby="certs">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head">
        <div>
          <p class="eyebrow">Featured certifications</p>
          <h2 id="certs" class="h-h2">Pick your certification</h2>
          <p class="h-lead">Open a course to see its syllabus, labs, simulations and exam tips before you start.</p>
        </div>
        <a href="/certifications/" class="h-more">Browse all certifications <span aria-hidden="true">→</span></a>
      </div>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((c) => <li><CertCard cert={c} lessons={counts[c.slug]?.lessons} questions={counts[c.slug]?.questions} /></li>)}
      </ul>
      <p class="mt-5 text-sm text-muted">Looking for AZ-204? Microsoft retired it on 31 July 2026. AI-200 is its replacement.</p>
    </div>
  </section>

  <!-- By level -->
  <section class="h-sec band-blue" aria-labelledby="levels">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="eyebrow">Browse by learning level</p>
      <h2 id="levels" class="h-h2">Start where you are</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {LEVELS.map((l) => {
          const list = CERTIFICATIONS.filter((c) => c.level === l.id);
          return (
            <div class={`lv ${l.tone}`}>
              <span class="lv-ic" aria-hidden="true">{l.icon}</span>
              <h3 class="mt-3 text-xl font-bold">{l.id} <span class="lv-diff">{difficulty(list[0])}</span></h3>
              <p class="mt-1 font-semibold">{l.who}</p>
              <p class="mt-1 text-sm text-muted">{l.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {list.map((c) => <li><a href={c.status === 'active' ? `/${c.slug}/` : `/certifications/#${c.slug}`} class={`lv-chip ${c.status === 'active' ? 'lv-live' : ''}`}>{c.code}{c.status === 'active' ? ' ●' : ''}<span class="sr-only">{c.status === 'active' ? ' (available now)' : ' (coming soon)'}</span></a></li>)}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <TodayBand />

  <!-- Why -->
  <section class="h-sec" aria-labelledby="why">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="eyebrow">Why choose MSDEVBUILD?</p>
      <h2 id="why" class="h-h2">The place where you can <em class="text-accent">feel</em> Azure</h2>
      <p class="h-lead">A 10-year-old should understand the idea. A 20-year veteran should still learn something new.</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {why.map((w) => <li class="h-why"><span class="h-why-ic" aria-hidden="true">{w.icon}</span><div><h3 class="font-bold">{w.title}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{w.text}</p></div></li>)}
      </ul>
      <h3 class="mt-12 text-xl font-bold">Made for every learner</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((a) => (
          <div class="card p-5">
            <p class="text-3xl" aria-hidden="true">{a.icon}</p>
            <p class="mt-2 text-lg font-semibold">{a.title}</p>
            <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive learning -->
  <section class="h-sec band-yellow" aria-labelledby="flow">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Interactive learning experience</p>
        <h2 id="flow" class="h-h2">Every lesson, the same five steps</h2>
        <p class="h-lead">You never leave the lesson half-way. Simulations, labs and the quiz all run on the page.</p>
        <ol class="h-flow">
          {flow.map(([ic, t, d], i) => <li><span class="h-flow-n" aria-hidden="true">{ic}</span><div><p class="font-bold">{i + 1}. {t}</p><p class="text-sm text-muted">{d}</p></div></li>)}
        </ol>
      </div>
      {sample && (
        <div class="example-box shadow-sm">
          <p class="text-sm font-bold text-accent">Example lesson · {exam.code}</p>
          <p class="mt-2 text-xl font-semibold">{sample.data.title}</p>
          <p class="mt-3 leading-relaxed" set:html={inlineMd(sample.data.answer)} />
          <a href={`${published[0].url}#knowledge-check`} class="nav-btn mt-5">Try it yourself ❯</a>
        </div>
      )}
    </div>
  </section>

  <!-- Labs and simulations -->
  <section class="h-sec band-navy" aria-labelledby="labs">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div class="text-center lg:text-left">
        <p class="eyebrow !text-[#ffd75e]">Practice labs and simulations</p>
        <h2 id="labs" class="h-h2">Try it yourself 🧪</h2>
        <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-white/90 lg:mx-0">Practise in a simulated Azure portal and Cloud Shell. Create VMs, storage and web apps, type real Azure CLI commands and watch the cost meter, with no Azure account needed. Then walk through a datacenter in 3D or pull the plug on a region.</p>
        <ul class="mx-auto mt-5 grid max-w-lg gap-2 text-left text-white/90 lg:mx-0">
          <li>🧪 {LABS.length} guided labs plus a free sandbox</li>
          <li>🧊 {Object.keys(exam.sims3d).length} 3D scenes: datacenter, zones, regions, identity and more</li>
          <li>⚡ {exam.whatIfs.length} “what happens if…?” simulations</li>
        </ul>
        <div class="mt-7 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href={`${x}/labs/`} class="big-btn !bg-[#ffd75e] !text-[#0b1020]">Open practice labs ❯</a>
          <a href={`${x}/3d-explorer/`} class="big-btn big-btn-light">3D explorer</a>
          <a href="/simulator/" class="big-btn big-btn-light">Azure simulator</a>
        </div>
      </div>
      <div class="example-box !bg-[#0b1020] font-mono text-[0.85rem] !text-[#e6edf3]">
        <p class="text-[#8fcbf7]">Azure Cloud Shell (practice)</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> az vm deallocate -g rg-lab -n web01</p>
        <p class="mt-1 text-white/80">💰 Cost: $8.76/mo → $4.38/mo</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> az group delete -n rg-prod</p>
        <p class="mt-1 text-[#ff8b94]">ERROR: (ScopeLocked) The scope 'rg-prod' cannot perform delete operation because it is locked…</p>
      </div>
    </div>
  </section>

  <!-- Mock exams + interview -->
  <section class="h-sec" aria-labelledby="exam-prep">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class="eyebrow">Mock exams and interview preparation</p>
      <h2 id="exam-prep" class="h-h2">Pass the exam, then the interview</h2>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="h-prep">
          <h3 class="text-2xl font-bold">⏱️ Mock exam</h3>
          <p class="mt-2 leading-relaxed text-muted">A timed, 40-question practice exam weighted like the real {exam.code}. Mark questions for review, see your score by domain, and learn why every answer is right or wrong.</p>
          <div class="example-box mt-5 !p-4">
            <p class="text-sm font-bold text-accent">Example question</p>
            <p class="mt-2 font-semibold leading-relaxed" set:html={inlineMd(sampleQ.question)} />
            <ul class="mt-3 space-y-2">
              {sampleQ.options.map((o) => <li class="rounded-md border border-default px-3 py-2 text-[0.95rem]" set:html={inlineMd(o.text)} />)}
            </ul>
          </div>
          <div class="mt-5 flex flex-wrap gap-3"><a href={`${x}/mock-exam/`} class="big-btn">Start the mock exam ❯</a></div>
          <p class="mt-3 text-sm text-muted">Original practice questions. Not real exam questions.</p>
        </div>
        <div class="h-prep">
          <h3 class="text-2xl font-bold">💼 Interview ready</h3>
          <p class="mt-2 leading-relaxed text-muted">Practise with Nimbus as your interviewer. Beginner to architect-level questions, model answers and the follow-up questions real interviewers ask.</p>
          <div class="example-box mt-5 space-y-3 !p-4">
            <div class="flex items-center gap-3"><Mascot size={48} mood="thinking" /><p class="font-semibold">Mock interview</p></div>
            <div class="bubble bubble-interviewer mr-8"><p class="mb-1 text-xs font-bold uppercase text-muted">Interviewer</p>What is the difference between scalability and elasticity?</div>
            <div class="bubble bubble-candidate ml-8"><p class="mb-1 text-xs font-bold uppercase text-accent">You</p>Scalability is the ability to add or remove resources. Elasticity is when that happens automatically, in real time, based on demand.</div>
            <div class="bubble bubble-interviewer mr-8"><p class="mb-1 text-xs font-bold uppercase text-muted">Interviewer</p>Can you give me a real-world example?</div>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={`${x}/interview/`} class="big-btn">Practise interview questions ❯</a>
            <a href={`${x}/revision/`} class="big-btn big-btn-light">Revision flashcards</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Play & Learn -->
  <section class="h-sec band-lilac" aria-labelledby="play">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <h2 id="play" class="h-h2">Play &amp; Learn 🎮</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed">Learning Azure should be fun. Play quick games, earn XP, level up from Cloud Seed 🌱 to Azure Legend 👑 and keep your daily 🔥 streak.</p>
      <div class="mt-8 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-5">
        {[
          ['📅', 'Daily Challenge', '5 questions a day', `${x}/games/daily/`],
          ['🗂️', 'Sort It!', 'Tap cards into buckets', `${x}/games/sort/`],
          ['🧠', 'Match the Pairs', 'Memory card game', `${x}/games/match/`],
          ['⚡', 'Lightning Round', '60-second quiz', `${x}/games/lightning/`],
          ['🕵️', 'Who Am I?', 'Guess the service', `${x}/games/who-am-i/`],
        ].map(([icon, title, text, href]) => (
          <a href={href} class="group rounded-2xl bg-[var(--card)] p-5 shadow-sm transition-transform hover:-translate-y-1">
            <span class="block text-4xl transition-transform group-hover:scale-110" aria-hidden="true">{icon}</span>
            <span class="mt-3 block text-lg font-bold">{title}</span>
            <span class="block text-sm text-muted">{text}</span>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`${x}/games/`} class="big-btn">Start playing ❯</a>
        <a href="/progress/" class="big-btn big-btn-light">🏆 Track your progress and badges</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="h-sec scroll-mt-28" aria-labelledby="faq-h">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="eyebrow text-center">FAQ</p>
      <h2 id="faq-h" class="h-h2 text-center">Frequently asked questions</h2>
      <div class="faq mt-8">
        {faq.map((f) => <details class="faq-item"><summary><h3 class="faq-q">{f.q}</h3></summary><p class="faq-a">{f.a}</p></details>)}
      </div>
      <div class="mt-10 text-center"><a href="#certifications" class="big-btn">Choose your certification ❯</a></div>
    </div>
  </section>
</PublicLayout>

<style>
  .h-hero { color: #fff; background: radial-gradient(60rem 34rem at 100% 0%, rgb(0 120 212 / .55), transparent 65%), radial-gradient(40rem 26rem at 0% 110%, rgb(135 100 184 / .4), transparent 70%), #101c2e; }
  .h-title { font-size: clamp(2.1rem, 5.4vw, 3.6rem); font-weight: 800; line-height: 1.08; letter-spacing: -.025em; }
  .h-title span { display: block; color: #ffd75e; }
  .h-btn { display: inline-flex; align-items: center; gap: .45rem; min-height: 48px; padding: 0 1.5rem; border-radius: 999px; font-size: 1.05rem; font-weight: 700; }
  .h-btn-y { background: #ffd75e; color: #0b1020; }
  .h-btn-y:hover { background: #ffcd2e; }
  .h-btn-o { border: 2px solid rgb(255 255 255 / .7); color: #fff; }
  .h-btn-o:hover { border-color: #ffd75e; color: #ffd75e; }
  .h-sec { padding-block: 4rem; }
  .h-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; }
  .h-h2 { margin-top: .35rem; font-size: clamp(1.8rem, 3.6vw, 2.6rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.15; }
  .h-lead { margin-top: .6rem; max-width: 42rem; font-size: 1.08rem; line-height: 1.6; color: var(--text-muted); }
  .h-more { font-weight: 700; color: var(--accent-deep); min-height: 44px; display: inline-flex; align-items: center; }
  .h-more:hover { text-decoration: underline; }
  .lv { border-radius: 18px; background: var(--card); border: 1px solid var(--card-line); padding: 1.4rem; border-top: 5px solid #0078d4; }
  .lv-2 { border-top-color: #5b3fb8; }
  .lv-3 { border-top-color: #0b5563; }
  .lv-ic { font-size: 2rem; }
  .lv-diff { margin-left: .35rem; vertical-align: middle; border-radius: 999px; background: var(--pastel-blue); color: var(--accent-deep); padding: 2px 9px; font-size: .75rem; font-weight: 700; }
  .lv-chip { display: inline-flex; align-items: center; min-height: 36px; padding: 0 .8rem; border-radius: 999px; border: 1px solid var(--card-line); background: var(--pastel-grey); font-size: .85rem; font-weight: 700; }
  .lv-chip:hover { border-color: var(--accent); }
  .lv-live { background: #0078d4; border-color: #0078d4; color: #fff; }
  .h-why { display: flex; gap: .9rem; border-radius: 16px; border: 1px solid var(--card-line); background: var(--card); padding: 1.15rem; }
  .h-why-ic { display: grid; place-items: center; flex: none; width: 2.8rem; height: 2.8rem; border-radius: 12px; background: var(--pastel-blue); font-size: 1.4rem; }
  .h-flow { margin-top: 1.5rem; display: grid; gap: .65rem; }
  .h-flow li { display: flex; align-items: center; gap: .85rem; border-radius: 14px; background: var(--card); padding: .75rem .9rem; border: 1px solid var(--card-line); }
  .h-flow-n { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 12px; background: var(--pastel-yellow); font-size: 1.25rem; }
  .h-prep { border-radius: 18px; border: 1px solid var(--card-line); background: var(--pastel-grey); padding: 1.5rem; }
</style>

<script>
  // Returning learner: Start Learning picks up where they left off.
  try {
    const last = JSON.parse(localStorage.getItem('msdb-last-lesson') || 'null');
    const start = document.getElementById('hero-start') as HTMLAnchorElement | null;
    if (start && last?.url?.startsWith('/') && !last.url.startsWith('//') && last.title) {
      start.href = last.url;
      start.textContent = 'Continue learning →';
      start.title = last.title;
    }
  } catch {}
</script>
