  /* Roadmap */
  .road { border-radius: 1.25rem; border: 1px dashed var(--border); padding: 1.1rem; background: var(--glass); }
  .road-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem 1rem; }
  .road-list { margin-top: .9rem; display: grid; gap: .6rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); }
  .road-item { display: flex; align-items: center; gap: .65rem; padding: .65rem .8rem; border-radius: 12px; background: var(--card); border: 1px solid var(--border); color: var(--accent-deep); font-size: .88rem; transition: border-color .15s, transform .15s; }
  .road-item strong { display: block; color: var(--text); }
  .road-name { display: block; color: var(--text-muted); font-size: .8rem; line-height: 1.3; }
  .road-item em { margin-left: auto; flex: none; font-style: normal; font-size: .7rem; font-weight: 700; color: var(--text-muted); }
  .road-item.is-next { border-color: var(--accent); }
  a.road-item:hover, a.road-item:focus-visible { border-color: var(--accent); transform: translateY(-2px); }
  .road-item.is-next em { color: #fff; background: #005a9e; padding: .15rem .5rem; border-radius: 999px; }

  /* Levels */
  .lv { padding: 1.4rem; overflow: hidden; }
  .lv::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: #0078d4; }
  .lv-2::before { background: #005a9e; }
  .lv-3::before { background: #003a66; }
  .lv-diff { margin-left: .35rem; vertical-align: middle; border-radius: 999px; background: var(--accent-soft); color: var(--accent-deep); padding: 2px 9px; font-size: .75rem; font-weight: 700; }
  .lv-chip { display: inline-flex; align-items: center; min-height: 36px; padding: 0 .85rem; border-radius: 999px; border: 1px solid var(--border); background: var(--card); font-size: .85rem; font-weight: 700; transition: border-color .15s; }
  .lv-chip:hover { border-color: var(--accent); }
  .lv-live { background: #0078d4; border-color: #0078d4; color: #fff; }

  /* Why */
  .h-why { display: flex; gap: .9rem; padding: 1.15rem; }

  /* Five-step flow */
  .h-flow { margin-top: 1.5rem; display: grid; gap: .65rem; }
  .h-flow li { display: flex; align-items: center; gap: .85rem; border-radius: 14px; background: var(--gp-fill); padding: .75rem .9rem; border: 1px solid var(--gp-tile-line); box-shadow: 0 8px 20px -14px rgb(0 72 130 / .35); }
  .h-flow-n { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 12px; background: var(--accent-soft); font-size: 1.25rem; }
  .h-glass { border: 0; border-radius: 1.25rem; }
  .h-inset { background: var(--card); }

  /* Azure-blue band, the blog's --band in place of the old navy */
  .h-blue { color: #fff; background: radial-gradient(70% 90% at 100% 0%, rgb(255 255 255 / .14), transparent 70%), linear-gradient(155deg, #005a9e, #003e70); }
  :global([data-theme='dark']) .h-blue { background: var(--band); }
  .h-blue .h-h2 { color: #fff; }
  .h-eyebrow-light { color: #e6f0fa; }
  .h-eyebrow-light::before { background: #fff; }
  .h-btn-w { background: #fff; color: #004f8c; }
  .h-btn-w:hover { transform: translateY(-1px); box-shadow: 0 10px 24px -10px rgb(0 0 0 / .5); }
  .h-btn-ow { border: 1.5px solid rgb(255 255 255 / .85); color: #fff; }
  .h-btn-ow:hover { background: #fff; color: #004f8c; }
  .h-shell { background: #0b1020 !important; color: #e6edf3 !important; border: 1px solid rgb(255 255 255 / .14); border-radius: 1.25rem; box-shadow: 0 28px 64px -20px rgb(0 0 0 / .55); }

  /* Mock exam + interview */
  .h-prep { padding: 1.5rem; }
</style>

<script>
  // Returning learner: Start Learning picks up where they left off.
  try {
    const last = JSON.parse(localStorage.getItem('msdb-last-lesson') || 'null');
    const start = document.getElementById('hero-start') as HTMLAnchorElement | null;
    if (start && last?.url?.startsWith('/') && !last.url.startsWith('//') && last.title) {
      start.href = last.url;
      start.textContent = 'Continue learning →';
      start.title = last.title;
    }
  } catch {}
</script>
