  /* Azure-blue band, the blog's --band in place of the old navy */
  .h-btn-w { background: #fff; color: #004f8c; }
  .h-btn-w:hover { transform: translateY(-1px); box-shadow: 0 10px 24px -10px rgb(0 0 0 / .5); }
  .h-btn-ow { border: 1.5px solid rgb(255 255 255 / .85); color: #fff; }
  .h-btn-ow:hover { background: #fff; color: #004f8c; }

  /* Mock exam + interview */
  .h-prep { padding: 1.5rem; }
</style>

<script>
  // Course filter chips (the full list shows without JavaScript).
  const chips = document.querySelector<HTMLElement>('[data-hc-chips]');
  if (chips) {
    chips.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>('[data-hc-tags]')];
    const empty = document.querySelector<HTMLElement>('[data-hc-empty]');
    chips.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-hc-filter]');
      if (!btn) return;
      const f = btn.dataset.hcFilter!;
      chips.querySelectorAll('[data-hc-filter]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      for (const li of items) { const on = f === 'all' || li.dataset.hcTags!.split(' ').includes(f); li.hidden = !on; if (on) shown++; }
      document.querySelectorAll<HTMLElement>('.hc-grid').forEach((g) => { const grp = g.previousElementSibling as HTMLElement | null; const any = [...g.children].some((c) => !(c as HTMLElement).hidden); g.hidden = !any; if (grp?.classList.contains('hc-group')) grp.hidden = !any; });
      if (empty) empty.hidden = shown > 0;
    });
  }

  // Returning learner: Start Learning picks up where they left off.
  try {
    const last = JSON.parse(localStorage.getItem('msdb-last-lesson') || 'null');
    const start = document.getElementById('hero-start') as HTMLAnchorElement | null;
    if (start && last?.url?.startsWith('/') && !last.url.startsWith('//') && last.title) {
      start.href = last.url;
      start.textContent = 'Continue learning →';
      start.title = last.title;
    }
  } catch {}
</script>
