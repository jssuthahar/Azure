---
/**
 * Home = DISCOVER. Certifications first; each card leads to its course details
 * page (understand), whose Start learning button opens the learning environment.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import Mascot from '../components/Mascot.astro';
import CloudScene from '../components/scenes/CloudScene.astro';
import TodayBand from '../components/TodayBand.astro';
import BrandLine from '../components/BrandLine.astro';
import CertIcon from '../components/course/CertIcon.astro';
import SiteSearch from '../components/course/SiteSearch.astro';
import { CERTIFICATIONS, difficulty } from '../data/certifications';
import { getNav, getQuestionBank, getTutorial, inlineMd } from '../lib/learn';
import { LABS } from '../lib/sim/labs';
import { SITE } from '../config';
import { getExam, liveExams } from '../data/exams';
import { AI_TRACKS } from '../data/ai-roadmap';

const exam = getExam();
const x = `/${exam.slug}`;
const nav = await getNav();
const published = nav.filter((t) => t.published);
const bank = await getQuestionBank();
const counts: Record<string, { lessons: number; questions: number }> = {};
for (const e of liveExams()) counts[e.slug] = { lessons: (await getNav(e.slug)).filter((t) => t.published).length, questions: (await getQuestionBank(e.slug)).length };
const totalLessons = Object.values(counts).reduce((n, c) => n + c.lessons, 0);
const totalQuestions = Object.values(counts).reduce((n, c) => n + c.questions, 0);

const featured = CERTIFICATIONS.filter((c) => c.featured);
const liveCerts = CERTIFICATIONS.filter((c) => c.status === 'active');
const LEVEL_ORDER = ['Fundamentals', 'Associate', 'Expert', 'Specialty'];
// Roadmap: the exam being built next first, then the featured planned exams by level.
const roadmap = CERTIFICATIONS.filter((c) => c.status === 'planned' && (c.featured || c.next))
  .sort((a, b) => Number(!!b.next) - Number(!!a.next) || LEVEL_ORDER.indexOf(a.level) - LEVEL_ORDER.indexOf(b.level));
const spotlight = (slug: string) => {
  const e = liveExams().find((x) => x.slug === slug)!;
  return { tours: Object.keys(e.tours).length, scenes: Object.keys(e.sims3d).length, domains: e.modules.length, modules: e.modules };
};
const aiTracks = AI_TRACKS.map((t) => ({ ...t, cert: CERTIFICATIONS.find((c) => c.slug === t.slug)! }));
const lives = liveExams();
const total3d = lives.reduce((n, e) => n + Object.keys(e.sims3d).length, 0);
const totalTours = lives.reduce((n, e) => n + Object.keys(e.tours).length, 0);
const labsOf = (slug: string) => LABS.filter((l) => (l.exam ?? 'az-900') === slug).length;
const sample = published[0] ? await getTutorial(published[0].key) : undefined;
const sampleQ = bank.find((q) => q.id === 'd2-arch-10') ?? bank[0];

const CHIPS = [
  { id: 'all', label: 'All' },
  { id: 'beginner', label: 'Beginner' },
  { id: 'intermediate', label: 'Intermediate' },
  { id: 'advanced', label: 'Advanced' },
  { id: 'ai', label: 'AI' },
  { id: 'security', label: 'Security' },
  { id: 'github', label: 'GitHub' },
];
const tags = (c: (typeof CERTIFICATIONS)[number]) => [difficulty(c).toLowerCase(), c.icon === 'ai' || /^A[IB]-/.test(c.code) ? 'ai' : '', c.icon === 'shield' || c.code.startsWith('SC-') ? 'security' : '', c.code.startsWith('GH-') ? 'github' : ''].filter(Boolean).join(' ');


const why = [
  { icon: '🧊', title: 'Feel it, then learn it', text: 'Every lesson has a 3D scene, an Azure portal walkthrough and a practice lab before the theory.' },
  { icon: '💸', title: 'Free, with no catch', text: 'No paid tier and no credit card. Every lesson, lab and mock exam is open to everyone, signed in or not.' },
  { icon: '🧑‍🏫', title: 'Built by an architect', text: `Lessons come from real project work, not just the docs. Built by ${SITE.author}, ${SITE.authorTitle}.` },
  { icon: '🎯', title: 'Follows the official outline', text: 'Lessons map to Microsoft’s skills outline objective by objective, and we date-stamp every check.' },
  { icon: '📲', title: 'Phone, tablet or laptop', text: 'Install it as an app, study offline on the train, and pick up where you stopped.' },
  { icon: '🔒', title: 'Your progress, on every device', text: 'Study without an account, or sign in with Google to keep XP, streaks, scores and your certificate in sync on phone and laptop.' },
];
const audiences = [
  { icon: '🎒', title: 'School students', text: 'No cloud knowledge needed. Stories about libraries, games and pizza.' },
  { icon: '🎓', title: 'College & freshers', text: 'Cloud basics linked to real IT jobs, with a quiz after every lesson.' },
  { icon: '💻', title: 'Developers', text: 'How Azure services fit into real apps, and when not to use them.' },
  { icon: '🏛️', title: 'Experienced engineers', text: 'Architecture trade-offs, cost, security and scenario interviews.' },
];
const flow = [
  ['⏱️', '30-second answer', 'The idea in two lines, before anything else.'],
  ['🧊', 'Simulations', '3D view, Azure portal and a practice lab, inside the lesson.'],
  ['📖', 'Explanation', 'A story, the plain version, then the technical one.'],
  ['💡', 'Exam tip', 'The trap Microsoft likes to set, and how to spot it.'],
  ['✅', 'Quiz', 'Check yourself. A good score marks the lesson complete.'],
];
const faq = [
  { q: 'Is MSDEVBUILD Azure free?', a: 'Yes. Every course, lesson, simulation, lab, quiz, mock exam and the practice certificate is free. There is no paid plan and nothing is locked.' },
  { q: 'Which certification should I start with?', a: `Pick by the work you want to do. For AI roles, our AI certification roadmap maps AI-103, AI-200, AI-300, AB-620 and SC-500 to real jobs. If you are new to the cloud, ${exam.code} (${exam.name}) or AI-901 (Azure AI Fundamentals) needs no experience and gives you the vocabulary the Associate exams build on.` },
  { q: 'Do I need an Azure account to practise?', a: 'No. The Azure portal, Cloud Shell and 3D scenes are simulations that run in your browser, so you can practise without a subscription or a surprise bill.' },
  { q: 'Do I need to sign in?', a: 'No. Everything works without an account and your progress is saved in this browser. Sign in with Google only if you want it synced across your devices.' },
  { q: 'Are the practice questions real exam questions?', a: 'No. Every question is original and written to practise the skills in Microsoft’s official outline. We never publish real or leaked exam questions.' },
  { q: 'When will AI-103, AI-300 and SC-500 be ready?', a: 'They are planned. Each course opens once its lessons, questions and mock exam are complete and the exam has been checked on Microsoft Learn.' },
];

// Home targets the queries learners type (exam code, free, practice exam, labs), not just the brand name.
const homeTitle = `Free ${exam.code} Tutorials, Practice Exams & Azure Labs | MSDEVBUILD`;
const homeDescription = `Learn Microsoft Azure ${exam.code} from scratch: free lessons, 3D simulations, portal practice labs, mock exams, quizzes and interview questions. No Azure account needed.`;
const schema = [
  { '@type': 'WebPage', '@id': `${SITE.url}/#home`, name: homeTitle, description: homeDescription, url: `${SITE.url}/`, publisher: { '@id': `${SITE.url}/#organization` }, author: { '@id': `${SITE.url}/#author` } },
  { '@type': 'ItemList', name: 'Featured certification courses', itemListElement: featured.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `${c.code}: ${c.name}`, url: c.status === 'active' ? `${SITE.url}/${c.slug}/` : `${SITE.url}/certifications/#${c.slug}` })) },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PublicLayout title={homeTitle} description={homeDescription} schema={schema}>
  <!-- Hero: headline, search and two calls to action, the 3D cloud on the right -->
  <section class="h-hero">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 pb-10 pt-10 sm:px-6 sm:pt-14 lg:grid-cols-[1.05fr_1fr]">
      <div class="text-center lg:text-left">
        <BrandLine class="mb-4" />
        <h1 class="h-title display">Learn Microsoft Technologies. <span class="gp-text">Master Your Certification.</span></h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted text-pretty lg:mx-0">Explore Microsoft certification courses with beginner-friendly lessons, interactive practice, real-world labs, simulations and mock exams. Free, with no account needed.</p>
        <div class="h-search mx-auto mt-7 max-w-xl lg:mx-0"><SiteSearch id="home-search" placeholder="What do you want to learn? e.g. IaaS or AZ-104" /></div>
        <p class="h-popular mt-3 justify-center lg:justify-start"><span>Popular:</span>
          {liveCerts.slice(0, 4).map((c) => <a href={`/${c.slug}/`}>{c.code}</a>)}
        </p>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a href={`${x}/learn/`} id="hero-start" class="btn btn-primary h-cta">Start Learning <span aria-hidden="true">→</span></a>
          <a href="#certifications" class="btn btn-outline h-cta">Explore Certifications</a>
        </p>
        <p class="mt-4 text-sm font-semibold"><a href="#simulators" class="text-[var(--accent-deep)] hover:underline">🧪 Try the free Azure simulators: portal, Cloud Shell, 3D and drag-and-drop</a></p>
      </div>
      <figure class="h-art">
        <div class="scene h-scene glass-premium p-3 sm:p-5">
          <CloudScene />
          <figcaption class="flex items-center justify-center gap-3 pt-2 text-sm font-medium">
            <span>The cloud: computers you borrow over the internet.</span>
            <button type="button" class="speak-btn text-[var(--accent-deep)]" data-say="Imagine your school library lends you any book the moment you ask, and you only pay for the days you keep it. That is cloud computing. Phones, laptops, shops and schools all borrow computers, storage and AI from the cloud over the internet.">🔊 Listen</button>
          </figcaption>
        </div>
        <p class="h-float h-float-a" aria-hidden="true"><span>🧪</span><b>{LABS.length} labs</b><small>no Azure account</small></p>
        <p class="h-float h-float-b" aria-hidden="true"><span>✅</span><b>{totalQuestions}</b><small>practice questions</small></p>
      </figure>
    </div>
  </section>

  <!-- Stats strip -->
  <section class="h-strip" aria-label="MSDEVBUILD in numbers">
    <dl data-ask-clear class="mx-auto grid max-w-6xl grid-cols-2 gap-y-5 px-4 py-6 sm:px-6 md:grid-cols-5">
      <div><dt>Courses live</dt><dd>{liveCerts.length}</dd></div>
      <div><dt>Lessons ready</dt><dd>{totalLessons}</dd></div>
      <div><dt>Practice questions</dt><dd>{totalQuestions}</dd></div>
      <div><dt>Guided labs</dt><dd>{LABS.length}</dd></div>
      <div class="col-span-2 md:col-span-1"><dt>Price</dt><dd>Free</dd></div>
    </dl>
    <p class="mx-auto max-w-6xl px-4 pb-6 text-sm text-muted sm:px-6">Lessons follow Microsoft’s official skills outlines. MSDEVBUILD is an independent site, not affiliated with Microsoft.</p>
  </section>

  <!-- Course catalogue with filter chips -->
  <section id="certifications" class="h-sec scroll-mt-28" aria-labelledby="certs">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head">
        <div>
          <p class="eyebrow">Certifications</p>
          <h2 id="certs" class="h-h2">Explore free certification courses</h2>
          <p class="h-lead">A complete course for each exam, free from the first lesson to the mock exam.</p>
        </div>
        <a href="/certifications/" class="h-more">Browse all certifications <span aria-hidden="true">→</span></a>
      </div>
      <div class="hc-chips mt-6" role="group" aria-label="Filter courses" data-hc-chips hidden>
        {CHIPS.map((c, i) => <button type="button" class="hc-chip" data-hc-filter={c.id} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>)}
      </div>
      <h3 class="hc-group">Available now</h3>
      <ul class="hc-grid hc-grid-live">
        {liveCerts.map((c) => { const sp = spotlight(c.slug); return (
          <li data-hc-tags={tags(c)}><article class="hc" data-cert={c.slug}>
            <div class={`hc-art hc-${c.level.toLowerCase()}`}>
              <CertIcon icon={c.icon} size={46} />
              <span class="hc-code" aria-hidden="true">{c.code}</span>
              <span class="hc-free">Free</span>
            </div>
            <div class="hc-body">
              <p class="hc-by"><img src={SITE.authorImageSmall} alt="" width="22" height="22" loading="lazy" /> MSDEVBUILD</p>
              <h4 class="hc-title"><a href={`/${c.slug}/`} class="hc-link">{c.code}: {c.name}</a></h4>
              <p class="hc-skills"><b>Skills you’ll gain:</b> {sp.modules.map((m) => m.shortTitle).join(', ')}</p>
              <p class="hc-meta">{difficulty(c)} · Course · {counts[c.slug]?.lessons} lessons · {counts[c.slug]?.questions} questions</p>
              <p class="hc-inc">{(c.slug.startsWith('gh-') ? ['Copilot simulations', 'Labs', 'Mock exam'] : ['3D view', 'Portal walkthroughs', 'Labs', 'Mock exam']).map((f) => <span>{f}</span>)}</p>
            </div>
          </article></li>
        ); })}
      </ul>
      <div id="roadmap" class="scroll-mt-28">
        <h3 class="hc-group">Coming soon <small>Each course opens once its lessons, questions and mock exam are complete.</small></h3>
        <ul class="hc-grid hc-grid-soon">
          {roadmap.map((c) => (
            <li data-hc-tags={tags(c)}><a href={`/${c.slug}/`} class={`hc-soon${c.next ? ' is-next' : ''}`}>
              <span class={`hc-soon-ic hc-${c.level.toLowerCase()}`}><CertIcon icon={c.icon} size={26} /></span>
              <span class="min-w-0"><strong>{c.code}</strong><span class="hc-soon-n">{c.name}</span></span>
              <em>{c.next ? 'Up next' : difficulty(c)}</em>
            </a></li>
          ))}
        </ul>
      </div>
      <p class="hc-empty mt-6 text-muted" data-hc-empty hidden>No courses match that filter yet. <a href="/certifications/" class="font-semibold text-[var(--accent-deep)] hover:underline">See every certification</a>.</p>
      <p class="mt-6 text-sm text-muted">Looking for AI-900, AZ-204 or AZ-500? Microsoft retired AI-900 on 30 June 2026 (AI-901 replaces it), AZ-204 on 31 July 2026 (AI-200 replaces it) and AZ-500 on 31 August 2026 (SC-500 replaces it).</p>
    </div>
  </section>

  <!-- Simulator showcase -->
  <section id="simulators" class="h-sec sx scroll-mt-28" aria-labelledby="sx-h">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head">
        <div>
          <p class="eyebrow">Learn by doing</p>
          <h2 id="sx-h" class="h-h2">Practise on simulators, right in your browser</h2>
          <p class="h-lead">Click through the Azure portal, type real CLI commands, drag resources into a design and walk a datacenter in 3D. No Azure account, no credit card and no surprise bill.</p>
        </div>
        <a href="/simulator/" class="h-more">All simulations <span aria-hidden="true">→</span></a>
      </div>
      <ul class="sx-grid mt-8">
        <li class="sx-wide"><a href="/az-104/architect/" class="sx-card">
          <div class="sx-pv sx-pv-arch" aria-hidden="true">
            <svg viewBox="0 0 420 170" role="presentation">
              <rect x="14" y="14" width="260" height="104" rx="10" class="a-vnet" /><text x="26" y="32" class="a-t">vnet-web · 10.10.0.0/16</text>
              <rect x="28" y="42" width="232" height="64" rx="8" class="a-sub" /><text x="38" y="58" class="a-t2">snet-web</text>
              <rect x="40" y="66" width="96" height="30" rx="6" class="a-card" /><text x="50" y="85" class="a-t2">🖥️ vm-web-01</text>
              <rect x="150" y="66" width="96" height="30" rx="6" class="a-card" /><text x="160" y="85" class="a-t2">🖥️ vm-web-02</text>
              <rect x="300" y="60" width="104" height="32" rx="6" class="a-card a-drag" /><text x="312" y="80" class="a-t2">⚖️ lb-web</text>
              <path d="M300 76 L246 82" class="a-link" /><path d="M300 76 C 230 40, 140 50, 136 70" class="a-link" />
              <rect x="40" y="132" width="110" height="28" rx="6" class="a-card" /><text x="50" y="150" class="a-t2">🛡️ nsg-web</text>
              <rect x="170" y="132" width="196" height="28" rx="14" class="a-ok" /><text x="184" y="150" class="a-t3">✓ Traffic: internet → lb → vm</text>
              <path d="M372 112 l10 26 4 -10 10 -4 z" class="a-cursor" />
            </svg>
          </div>
          <div class="sx-body">
            <p class="sx-tags"><span>Drag and drop</span><span>New</span></p>
            <h3 class="sx-t">Azure Architecture Builder</h3>
            <p class="sx-d">Drag VNets, subnets, VMs, load balancers and private endpoints onto a canvas. Check the design for mistakes, send test traffic and get a plain-English explanation.</p>
            <span class="sx-go">Build a design <span aria-hidden="true">→</span></span>
          </div>
        </a></li>
        <li class="sx-wide"><a href={`${x}/labs/`} class="sx-card">
          <div class="sx-pv sx-pv-portal" aria-hidden="true">
            <div class="pt-bar"><span></span><span></span><span></span><b>Microsoft Azure (practice)</b></div>
            <div class="pt-main">
              <div class="pt-side"><i></i><i></i><i></i><i></i><i></i></div>
              <div class="pt-body">
                <p class="pt-h">Create a virtual machine</p>
                <p class="pt-row"><span>Region</span><em>Central India</em></p>
                <p class="pt-row"><span>Size</span><em>Standard_B2s</em></p>
                <p class="pt-btn">Review + create</p>
              </div>
              <div class="pt-shell"><p><b>$</b> az vm deallocate -n web01</p><p class="pt-ok">💰 ₹730/mo → ₹365/mo</p><p><b>$</b> az group delete -n rg-prod</p><p class="pt-err">ERROR: ScopeLocked</p></div>
            </div>
          </div>
          <div class="sx-body">
            <p class="sx-tags"><span>Click through</span><span>Type commands</span></p>
            <h3 class="sx-t">Azure portal and Cloud Shell labs</h3>
            <p class="sx-d">{LABS.length} guided labs plus a free sandbox. Create VMs, storage, networks and web apps in a practice portal, run real Azure CLI commands and watch the cost meter. Every task is checked as you go.</p>
            <span class="sx-go">Open a lab <span aria-hidden="true">→</span></span>
          </div>
        </a></li>
        {[
          { href: `${x}/3d-explorer/`, pv: 'sx-pv-3d', ic: '🧊', tags: ['3D', 'Interactive'], t: '3D Explorer', d: `${total3d} scenes: walk a datacenter, zones and regions, identity and networks. Rotate, zoom and tap anything.` },
          { href: '/simulator/', pv: 'sx-pv-what', ic: '⚡', tags: ['What if?'], t: 'What-if simulator', d: `${exam.whatIfs.length} scenarios. Pull the plug on a zone or a region and watch what keeps running.` },
          { href: `${x}/learn/`, pv: 'sx-pv-tour', ic: '🧭', tags: ['Step by step'], t: 'Portal walkthroughs', d: `${totalTours} guided tours inside the lessons. Each one shows exactly where to click in the new Azure portal.` },
          { href: '/ai-901/labs/ai-foundry-setup/', pv: 'sx-pv-ai', ic: '✨', tags: ['AI', 'Click through'], t: 'Microsoft Foundry simulator', d: `Deploy a model, chat with it, build an agent with tools and run a Foundry SDK script. ${labsOf('ai-901')} AI-901 labs.` },
          { href: '/gh-300/labs/', pv: 'sx-pv-gh', ic: '💻', tags: ['Type commands'], t: 'VS Code and GitHub Copilot', d: `A practice VS Code, github.com and Copilot CLI terminal for GH-300. ${labsOf('gh-300')} guided labs.` },
          { href: `${x}/games/sort/`, pv: 'sx-pv-sort', ic: '🗂️', tags: ['Drag and drop', 'Game'], t: 'Sort It and Match', d: 'Drag service cards into the right bucket, match pairs from memory and beat the 60-second Lightning Round.' },
          { href: `${x}/mock-exam/`, pv: 'sx-pv-exam', ic: '⏱️', tags: ['Exam room'], t: 'Mock exam room', d: 'A timed exam in the style of the real one: agreement screen, review grid, flagged questions and a score report by domain.' },
          { href: '/embed/', pv: 'sx-pv-embed', ic: '</>', tags: ['For trainers'], t: 'Embed a simulation', d: 'Put any 3D scene or simulation on your own blog or course page with one line of code.' },
        ].map((c) => (
          <li><a href={c.href} class="sx-card sx-small">
            <div class={`sx-pv sx-mini ${c.pv}`} aria-hidden="true"><span>{c.ic}</span></div>
            <div class="sx-body">
              <p class="sx-tags">{c.tags.map((t) => <span>{t}</span>)}</p>
              <h3 class="sx-t">{c.t}</h3>
              <p class="sx-d">{c.d}</p>
              <span class="sx-go">Try it <span aria-hidden="true">→</span></span>
            </div>
          </a></li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-muted">🧪 All simulators are for learning only. Screens are simplified, nothing is created in Azure, and MSDEVBUILD isn’t affiliated with Microsoft or GitHub.</p>
    </div>
  </section>

  <!-- Career paths -->
  <section class="h-sec band-glass" aria-labelledby="ai-road">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head">
        <div>
          <p class="eyebrow">Azure AI careers</p>
          <h2 id="ai-road" class="h-h2">Which AI certification fits your role?</h2>
          <p class="h-lead">Start with the work you want to own. AI-901 and AZ-900 are optional first steps, not prerequisites.</p>
        </div>
        <a href="/ai-certifications/" class="h-more">See the full AI roadmap <span aria-hidden="true">→</span></a>
      </div>
      <ul class="ai-roles mt-8">
        {aiTracks.map((t) => (
          <li><a href={`/ai-certifications/#${t.slug}`} class="ai-role">
            <span class="ai-role-ic"><CertIcon icon={t.cert.icon} size={26} /></span>
            <span class="ai-role-k">{t.role}</span>
            <strong class="ai-role-c">{t.cert.code}</strong>
            <span class="ai-role-n">{t.cert.name}</span>
            <span class={`ai-role-s${t.cert.status === 'active' ? ' is-live' : ''}`}>{t.cert.status === 'active' ? '● Free course live' : 'Course planned'}</span>
          </a></li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-muted">Moving into architecture? AB-100 and AI-500 are Expert certifications that each need a second credential. <a href="/ai-certifications/#ar-expert" class="font-semibold text-[var(--accent-deep)] hover:underline">See what they need</a>.</p>
    </div>
  </section>

  <TodayBand />

  <!-- Why -->
  <section class="h-sec" aria-labelledby="why">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head"><div><p class="eyebrow">Why choose MSDEVBUILD?</p>
      <h2 id="why" class="h-h2">The place where you can <em class="gp-text">feel</em> Azure</h2>
      <p class="h-lead">A 10-year-old should understand the idea. A 20-year veteran should still learn something new.</p></div></div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {why.map((w) => <li class="tile h-why"><span class="tile-mark" aria-hidden="true">{w.icon}</span><div><h3 class="font-bold">{w.title}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{w.text}</p></div></li>)}
      </ul>
      <h3 class="mt-12 text-xl font-bold">Made for every learner</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((a) => (
