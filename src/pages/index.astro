  .a-t { font: 700 10px system-ui, sans-serif; fill: #005a9e; }
  .a-t2 { font: 600 10px system-ui, sans-serif; fill: var(--text); }
  .a-t3 { font: 700 10px system-ui, sans-serif; fill: #0b6a0b; }
  .a-cursor { fill: var(--text); stroke: var(--card); stroke-width: 1.5; animation: sx-drag 3.2s ease-in-out infinite; }
  :global([data-theme='dark']) .a-t { fill: #6cb8f6; }
  :global([data-theme='dark']) .a-t3 { fill: #7fd67f; }
  :global([data-theme='dark']) .a-link { stroke: #5fcf5f; }
  @keyframes sx-drag { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-8px, -4px); } }
  @keyframes sx-dash { to { stroke-dashoffset: -18; } }
  @media (prefers-reduced-motion: reduce) { .a-drag, .a-link, .a-cursor { animation: none; } }
  /* Portal + shell preview */
  .sx-pv-portal { height: 200px; border: 1px solid var(--border); background: var(--card); font-size: .68rem; }
  .pt-bar { display: flex; align-items: center; gap: .3rem; height: 24px; padding: 0 .6rem; background: #0067b8; color: #fff; }
  .pt-bar span { width: 7px; height: 7px; border-radius: 50%; background: rgb(255 255 255 / .55); }
  .pt-bar b { margin-left: .4rem; font-weight: 600; }
  .pt-main { display: grid; grid-template-columns: 28px 1fr 1fr; height: calc(100% - 24px); }
  .pt-side { display: grid; align-content: start; gap: 8px; padding: 8px 7px; background: var(--band-subtle); border-right: 1px solid var(--border); }
  .pt-side i { display: block; height: 12px; border-radius: 3px; background: var(--border); }
  .pt-body { padding: .6rem .7rem; }
  .pt-h { font-weight: 750; font-size: .78rem; }
  .pt-row { display: flex; justify-content: space-between; gap: .4rem; margin-top: .45rem; padding: .25rem .4rem; border: 1px solid var(--border); border-radius: 4px; }
  .pt-row span { color: var(--text-muted); }
  .pt-btn { display: inline-block; margin-top: .6rem; padding: .25rem .6rem; border-radius: 4px; background: #0078d4; color: #fff; font-weight: 700; }
  .pt-shell { padding: .55rem .65rem; background: #0b1020; color: #e6edf3; font-family: ui-monospace, monospace; font-size: .64rem; line-height: 1.6; overflow: hidden; }
  .pt-shell b { color: #9fe870; }
  .pt-ok { color: #8fcbf7; }
  .pt-err { color: #ff8b94; }

  /* Closing band */
  .h-final { color: #fff; background: radial-gradient(60% 120% at 100% 0%, rgb(255 255 255 / .14), transparent 70%), linear-gradient(135deg, #0067b8, #003e70); }
  :global([data-theme='dark']) .h-final { background: var(--band); }

  /* Why */
  .h-why { display: flex; gap: .9rem; padding: 1.15rem; }

  /* Five-step flow */
  .h-flow { margin-top: 1.5rem; display: grid; gap: .65rem; }
  .h-flow li { display: flex; align-items: center; gap: .85rem; border-radius: 14px; background: var(--gp-fill); padding: .75rem .9rem; border: 1px solid var(--gp-tile-line); box-shadow: 0 8px 20px -14px rgb(0 72 130 / .35); }
  .h-flow-n { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 12px; background: var(--accent-soft); font-size: 1.25rem; }
  .h-glass { border: 0; border-radius: 1.25rem; }
