---
/**
 * Home = DISCOVER. Certifications first; each card leads to its course details
 * page (understand), whose Start learning button opens the learning environment.
 */
import PublicLayout from '../layouts/PublicLayout.astro';
import Mascot from '../components/Mascot.astro';
import CloudScene from '../components/scenes/CloudScene.astro';
import TodayBand from '../components/TodayBand.astro';
import BrandLine from '../components/BrandLine.astro';
import CertIcon from '../components/course/CertIcon.astro';
import SiteSearch from '../components/course/SiteSearch.astro';
import { CERTIFICATIONS, difficulty } from '../data/certifications';
import { getNav, getQuestionBank, getTutorial, inlineMd } from '../lib/learn';
import { LABS } from '../lib/sim/labs';
import { SITE } from '../config';
import { getExam, liveExams } from '../data/exams';
import { AI_TRACKS } from '../data/ai-roadmap';

const exam = getExam();
const x = `/${exam.slug}`;
const nav = await getNav();
const published = nav.filter((t) => t.published);
const bank = await getQuestionBank();
const counts: Record<string, { lessons: number; questions: number }> = {};
for (const e of liveExams()) counts[e.slug] = { lessons: (await getNav(e.slug)).filter((t) => t.published).length, questions: (await getQuestionBank(e.slug)).length };
const totalLessons = Object.values(counts).reduce((n, c) => n + c.lessons, 0);
const totalQuestions = Object.values(counts).reduce((n, c) => n + c.questions, 0);

const featured = CERTIFICATIONS.filter((c) => c.featured);
const liveCerts = CERTIFICATIONS.filter((c) => c.status === 'active');
const LEVEL_ORDER = ['Fundamentals', 'Associate', 'Expert', 'Specialty'];
// Roadmap: the exam being built next first, then the featured planned exams by level.
const roadmap = CERTIFICATIONS.filter((c) => c.status === 'planned' && (c.featured || c.next))
  .sort((a, b) => Number(!!b.next) - Number(!!a.next) || LEVEL_ORDER.indexOf(a.level) - LEVEL_ORDER.indexOf(b.level));
const spotlight = (slug: string) => {
  const e = liveExams().find((x) => x.slug === slug)!;
  return { tours: Object.keys(e.tours).length, scenes: Object.keys(e.sims3d).length, domains: e.modules.length, modules: e.modules };
};
const aiTracks = AI_TRACKS.map((t) => ({ ...t, cert: CERTIFICATIONS.find((c) => c.slug === t.slug)! }));
const sample = published[0] ? await getTutorial(published[0].key) : undefined;
const sampleQ = bank.find((q) => q.id === 'd2-arch-10') ?? bank[0];

const LEVELS = [
  { id: 'Fundamentals', icon: '🌱', tone: 'lv-1', who: 'New to the cloud', text: 'Start from zero. Stories first, then the theory.' },
  { id: 'Associate', icon: '🛠️', tone: 'lv-2', who: 'Building and running Azure', text: 'Administer, develop and secure real workloads.' },
  { id: 'Expert', icon: '🏛️', tone: 'lv-3', who: 'Designing at scale', text: 'Architecture and DevOps decisions with trade-offs.' },
] as const;

const why = [
  { icon: '🧊', title: 'Feel it, then learn it', text: 'Every lesson has a 3D scene, an Azure portal walkthrough and a practice lab before the theory.' },
  { icon: '💸', title: 'Free, with no catch', text: 'No paid tier and no credit card. Every lesson, lab and mock exam is open to everyone, signed in or not.' },
  { icon: '🧑‍🏫', title: 'Built by an architect', text: `Lessons come from real project work, not just the docs. Built by ${SITE.author}, ${SITE.authorTitle}.` },
  { icon: '🎯', title: 'Follows the official outline', text: 'Lessons map to Microsoft’s skills outline objective by objective, and we date-stamp every check.' },
  { icon: '📲', title: 'Phone, tablet or laptop', text: 'Install it as an app, study offline on the train, and pick up where you stopped.' },
  { icon: '🔒', title: 'Your progress, on every device', text: 'Study without an account, or sign in with Google to keep XP, streaks, scores and your certificate in sync on phone and laptop.' },
];
const audiences = [
  { icon: '🎒', title: 'School students', text: 'No cloud knowledge needed. Stories about libraries, games and pizza.' },
  { icon: '🎓', title: 'College & freshers', text: 'Cloud basics linked to real IT jobs, with a quiz after every lesson.' },
  { icon: '💻', title: 'Developers', text: 'How Azure services fit into real apps, and when not to use them.' },
  { icon: '🏛️', title: 'Experienced engineers', text: 'Architecture trade-offs, cost, security and scenario interviews.' },
];
const flow = [
  ['⏱️', '30-second answer', 'The idea in two lines, before anything else.'],
  ['🧊', 'Simulations', '3D view, Azure portal and a practice lab, inside the lesson.'],
  ['📖', 'Explanation', 'A story, the plain version, then the technical one.'],
  ['💡', 'Exam tip', 'The trap Microsoft likes to set, and how to spot it.'],
  ['✅', 'Quiz', 'Check yourself. A good score marks the lesson complete.'],
];
const faq = [
  { q: 'Is MSDEVBUILD Azure free?', a: 'Yes. Every course, lesson, simulation, lab, quiz, mock exam and the practice certificate is free. There is no paid plan and nothing is locked.' },
  { q: 'Which certification should I start with?', a: `Pick by the work you want to do. For AI roles, our AI certification roadmap maps AI-103, AI-200, AI-300, AB-620 and SC-500 to real jobs. If you are new to the cloud, ${exam.code} (${exam.name}) or AI-901 (Azure AI Fundamentals) needs no experience and gives you the vocabulary the Associate exams build on.` },
  { q: 'Do I need an Azure account to practise?', a: 'No. The Azure portal, Cloud Shell and 3D scenes are simulations that run in your browser, so you can practise without a subscription or a surprise bill.' },
  { q: 'Do I need to sign in?', a: 'No. Everything works without an account and your progress is saved in this browser. Sign in with Google only if you want it synced across your devices.' },
  { q: 'Are the practice questions real exam questions?', a: 'No. Every question is original and written to practise the skills in Microsoft’s official outline. We never publish real or leaked exam questions.' },
  { q: 'When will AI-103, AI-300 and SC-500 be ready?', a: 'They are planned. Each course opens once its lessons, questions and mock exam are complete and the exam has been checked on Microsoft Learn.' },
];

// Home targets the queries learners type (exam code, free, practice exam, labs), not just the brand name.
const homeTitle = `Free ${exam.code} Tutorials, Practice Exams & Azure Labs | MSDEVBUILD`;
const homeDescription = `Learn Microsoft Azure ${exam.code} from scratch: free lessons, 3D simulations, portal practice labs, mock exams, quizzes and interview questions. No Azure account needed.`;
const schema = [
  { '@type': 'WebPage', '@id': `${SITE.url}/#home`, name: homeTitle, description: homeDescription, url: `${SITE.url}/`, publisher: { '@id': `${SITE.url}/#organization` }, author: { '@id': `${SITE.url}/#author` } },
  { '@type': 'ItemList', name: 'Featured certification courses', itemListElement: featured.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `${c.code}: ${c.name}`, url: c.status === 'active' ? `${SITE.url}/${c.slug}/` : `${SITE.url}/certifications/#${c.slug}` })) },
  { '@type': 'FAQPage', '@id': `${SITE.url}/#faq`, mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<PublicLayout title={homeTitle} description={homeDescription} schema={schema}>
  <!-- Hero -->
  <section class="h-hero">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.1fr_1fr]">
      <div class="text-center lg:text-left">
        <BrandLine class="mb-4" />
        <p class="eyebrow">Free Microsoft certification courses</p>
        <h1 class="h-title display mt-3">Learn Microsoft Technologies. <span class="gp-text">Master Your Certification.</span></h1>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-muted text-pretty lg:mx-0">Explore Microsoft certification courses with beginner-friendly lessons, interactive practice, real-world labs, simulations and mock exams.</p>
        <div class="mx-auto mt-7 max-w-xl lg:mx-0"><SiteSearch id="home-search" placeholder="Search, e.g. IaaS or AZ-900" /></div>
        <p class="mt-6 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <a href="#certifications" class="btn btn-primary h-cta">Explore Certifications</a>
          <a href={`${x}/learn/`} id="hero-start" class="btn btn-outline h-cta">Start Learning <span aria-hidden="true">→</span></a>
        </p>
        <dl data-ask-clear class="h-stats glass-premium mx-auto mt-7 grid max-w-md grid-cols-3 lg:mx-0">
          <div><dt>Lessons ready</dt><dd>{totalLessons}</dd></div>
          <div><dt>Practice questions</dt><dd>{totalQuestions}</dd></div>
          <div><dt>Price</dt><dd>Free</dd></div>
        </dl>
      </div>
      <figure class="scene h-scene glass-premium p-3 sm:p-5">
        <CloudScene />
        <figcaption class="flex items-center justify-center gap-3 pt-2 text-sm font-medium">
          <span>The cloud: computers you borrow over the internet.</span>
          <button type="button" class="speak-btn text-[var(--accent-deep)]" data-say="Imagine your school library lends you any book the moment you ask, and you only pay for the days you keep it. That is cloud computing. Phones, laptops, shops and schools all borrow computers, storage and AI from the cloud over the internet.">🔊 Listen</button>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- AI certification roadmap -->
  <section class="h-sec band-glass" aria-labelledby="ai-road">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head">
        <div>
          <p class="eyebrow">Azure AI certifications</p>
          <h2 id="ai-road" class="h-h2">Which AI certification fits your role?</h2>
          <p class="h-lead">Start with the work you want to own. AI-901 and AZ-900 are optional first steps, not prerequisites.</p>
        </div>
        <a href="/ai-certifications/" class="h-more">See the full AI roadmap <span aria-hidden="true">→</span></a>
      </div>
      <ul class="ai-roles mt-8">
        {aiTracks.map((t) => (
          <li><a href={`/ai-certifications/#${t.slug}`} class="tile ai-role">
            <span class="ai-role-k">{t.role}</span>
            <strong class="ai-role-c">{t.cert.code}</strong>
            <span class="ai-role-n">{t.cert.name}</span>
            <span class={`ai-role-s${t.cert.status === 'active' ? ' is-live' : ''}`}>{t.cert.status === 'active' ? '● Free course live' : 'Course planned'}</span>
          </a></li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-muted">Moving into architecture? AB-100 and AI-500 are Expert certifications that each need a second credential. <a href="/ai-certifications/#ar-expert" class="font-semibold text-[var(--accent-deep)] hover:underline">See what they need</a>.</p>
    </div>
  </section>

  <!-- Featured certifications -->
  <section id="certifications" class="h-sec scroll-mt-28" aria-labelledby="certs">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head">
        <div>
          <p class="eyebrow">Certifications</p>
          <h2 id="certs" class="h-h2">{liveCerts.length === 1 ? `Start with ${liveCerts[0].code}` : 'Pick your certification'}</h2>
          <p class="h-lead">A complete course, free from the first lesson to the mock exam. More Azure exams follow on the same platform.</p>
        </div>
        <a href="/certifications/" class="h-more">Browse all certifications <span aria-hidden="true">→</span></a>
      </div>
      {liveCerts.map((c) => { const sp = spotlight(c.slug); return (
        <article class="spot glass-premium mt-8" data-cert={c.slug}>
          <div class="spot-main">
            <p class="spot-meta"><span class="spot-live"><span aria-hidden="true">●</span> Available now</span><span class="spot-pill">{difficulty(c)}</span><span class="spot-pill">Free</span></p>
            <h3 class="spot-title"><span>{c.code}</span> {c.name}</h3>
            <p class="spot-text">{c.blurb}</p>
            <dl class="spot-stats">
              <div><dt>Lessons</dt><dd>{counts[c.slug]?.lessons}</dd></div>
              <div><dt>Practice questions</dt><dd>{counts[c.slug]?.questions}</dd></div>
              <div><dt>Portal walkthroughs</dt><dd>{sp.tours}</dd></div>
              <div><dt>3D scenes</dt><dd>{sp.scenes}</dd></div>
            </dl>
            <p class="mt-6 flex flex-wrap gap-3">
              <a href={`/${c.slug}/learn/`} class="btn btn-accent spot-btn">Start {c.code} free <span aria-hidden="true">→</span></a>
              <a href={`/${c.slug}/`} class="btn btn-outline spot-btn">Syllabus and course details</a>
            </p>
          </div>
          <div class="spot-side">
            <p class="spot-side-h">What the exam covers</p>
            <ol class="spot-doms">
              {sp.modules.map((m) => <li><a href={`/${c.slug}/${m.slug}/`}><span class="spot-dn">{m.domain}</span><span class="spot-dt">{m.shortTitle}</span><span class="spot-dw">{m.weight}</span></a></li>)}
            </ol>
            <p class="spot-side-h mt-5">Every lesson includes</p>
            <ul class="spot-inc">
              <li>3D view</li><li>Azure portal walkthrough</li><li>Practice lab</li><li>Exam tip and quiz</li>
            </ul>
          </div>
        </article>
      ); })}
      <div id="roadmap" class="road mt-10 scroll-mt-28" aria-labelledby="road-h">
        <div class="road-head">
          <h3 id="road-h" class="text-lg font-bold">On the roadmap</h3>
          <p class="text-sm text-muted">Each course opens once its lessons, questions and mock exam are complete.</p>
        </div>
        <ul class="road-list">
          {roadmap.map((c) => (
            <li><a href={`/${c.slug}/`} class={`road-item${c.next ? ' is-next' : ''}`}>
              <CertIcon icon={c.icon} size={28} />
              <span class="min-w-0"><strong>{c.code}</strong><span class="road-name">{c.name}</span></span>
              <em>{c.next ? 'Up next' : c.level}</em>
            </a></li>
          ))}
        </ul>
      </div>
      <p class="mt-5 text-sm text-muted">Looking for AI-900, AZ-204 or AZ-500? Microsoft retired AI-900 on 30 June 2026 (AI-901 replaces it), AZ-204 on 31 July 2026 (AI-200 replaces it) and AZ-500 on 31 August 2026 (SC-500 replaces it).</p>
    </div>
  </section>

  <!-- By level -->
  <section class="h-sec band-glass" aria-labelledby="levels">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head"><div><p class="eyebrow">Browse by learning level</p>
      <h2 id="levels" class="h-h2">Start where you are</h2></div></div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {LEVELS.map((l) => {
          const list = CERTIFICATIONS.filter((c) => c.level === l.id);
          return (
            <div class={`tile lv ${l.tone}`}>
              <span class="tile-mark" aria-hidden="true">{l.icon}</span>
              <h3 class="mt-3 text-xl font-bold">{l.id} <span class="lv-diff">{difficulty(list[0])}</span></h3>
              <p class="mt-1 font-semibold">{l.who}</p>
              <p class="mt-1 text-sm text-muted">{l.text}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {list.map((c) => <li><a href={c.status === 'active' ? `/${c.slug}/` : `/certifications/#${c.slug}`} class={`lv-chip ${c.status === 'active' ? 'lv-live' : ''}`}>{c.code}{c.status === 'active' ? ' ●' : ''}<span class="sr-only">{c.status === 'active' ? ' (available now)' : ' (coming soon)'}</span></a></li>)}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <TodayBand />

  <!-- Why -->
  <section class="h-sec" aria-labelledby="why">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head"><div><p class="eyebrow">Why choose MSDEVBUILD?</p>
      <h2 id="why" class="h-h2">The place where you can <em class="gp-text">feel</em> Azure</h2>
      <p class="h-lead">A 10-year-old should understand the idea. A 20-year veteran should still learn something new.</p></div></div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {why.map((w) => <li class="tile h-why"><span class="tile-mark" aria-hidden="true">{w.icon}</span><div><h3 class="font-bold">{w.title}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{w.text}</p></div></li>)}
      </ul>
      <h3 class="mt-12 text-xl font-bold">Made for every learner</h3>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {audiences.map((a) => (
          <div class="tile p-5">
            <p class="text-3xl" aria-hidden="true">{a.icon}</p>
            <p class="mt-2 text-lg font-semibold">{a.title}</p>
            <p class="mt-1 text-[0.95rem] leading-relaxed text-muted">{a.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive learning -->
  <section class="h-sec band-glass" aria-labelledby="flow">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Interactive learning experience</p>
        <h2 id="flow" class="h-h2">Every lesson, the same five steps</h2>
        <p class="h-lead">You never leave the lesson half-way. Simulations, labs and the quiz all run on the page.</p>
        <ol class="h-flow">
          {flow.map(([ic, t, d], i) => <li><span class="h-flow-n" aria-hidden="true">{ic}</span><div><p class="font-bold">{i + 1}. {t}</p><p class="text-sm text-muted">{d}</p></div></li>)}
        </ol>
      </div>
      {sample && (
        <div class="example-box h-glass glass-premium">
          <p class="text-sm font-bold text-accent">Example lesson · {exam.code}</p>
          <p class="mt-2 text-xl font-semibold">{sample.data.title}</p>
          <p class="mt-3 leading-relaxed" set:html={inlineMd(sample.data.answer)} />
          <a href={`${published[0].url}#knowledge-check`} class="btn btn-primary h-cta mt-5">Try it yourself <span aria-hidden="true">→</span></a>
        </div>
      )}
    </div>
  </section>

  <!-- Labs and simulations -->
  <section class="h-sec h-blue" aria-labelledby="labs">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div class="text-center lg:text-left">
        <p class="eyebrow h-eyebrow-light">Practice labs and simulations</p>
        <h2 id="labs" class="h-h2">Try it yourself 🧪</h2>
        <p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-[#e6f0fa] lg:mx-0">Practise in a simulated Azure portal and Cloud Shell. Create VMs, storage and web apps, type real Azure CLI commands and watch the cost meter, with no Azure account needed. Then walk through a datacenter in 3D or pull the plug on a region.</p>
        <ul class="mx-auto mt-5 grid max-w-lg gap-2 text-left text-[#e6f0fa] lg:mx-0">
          <li>🧪 {LABS.length} guided labs plus a free sandbox</li>
          <li>🧊 {Object.keys(exam.sims3d).length} 3D scenes: datacenter, zones, regions, identity and more</li>
          <li>⚡ {exam.whatIfs.length} “what happens if…?” simulations</li>
        </ul>
        <div class="mt-7 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a href={`${x}/labs/`} class="btn h-cta h-btn-w">Open practice labs <span aria-hidden="true">→</span></a>
          <a href={`${x}/3d-explorer/`} class="btn h-cta h-btn-ow">3D explorer</a>
          <a href="/simulator/" class="btn h-cta h-btn-ow">Azure simulator</a>
        </div>
      </div>
      <div class="example-box h-shell font-mono text-[0.85rem] !text-[#e6edf3]">
        <p class="text-[#8fcbf7]">Azure Cloud Shell (practice)</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> az vm deallocate -g rg-lab -n web01</p>
        <p class="mt-1 text-white/80">💰 Cost: $8.76/mo → $4.38/mo</p>
        <p class="mt-2"><span class="text-[#9fe870]">learner@Azure:~$</span> az group delete -n rg-prod</p>
        <p class="mt-1 text-[#ff8b94]">ERROR: (ScopeLocked) The scope 'rg-prod' cannot perform delete operation because it is locked…</p>
      </div>
    </div>
  </section>

  <!-- Mock exams + interview -->
  <section class="h-sec" aria-labelledby="exam-prep">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="h-head"><div><p class="eyebrow">Mock exams and interview preparation</p>
      <h2 id="exam-prep" class="h-h2">Pass the exam, then the interview</h2></div></div>
      <div class="mt-8 grid gap-6 lg:grid-cols-2">
        <div class="tile h-prep">
          <h3 class="text-2xl font-bold">⏱️ Mock exam</h3>
          <p class="mt-2 leading-relaxed text-muted">A timed, 40-question practice exam weighted like the real {exam.code}. Mark questions for review, see your score by domain, and learn why every answer is right or wrong.</p>
          <div class="example-box h-inset mt-5 !p-4">
            <p class="text-sm font-bold text-accent">Example question</p>
            <p class="mt-2 font-semibold leading-relaxed" set:html={inlineMd(sampleQ.question)} />
            <ul class="mt-3 space-y-2">
              {sampleQ.options.map((o) => <li class="rounded-md border border-default px-3 py-2 text-[0.95rem]" set:html={inlineMd(o.text)} />)}
            </ul>
          </div>
          <div class="mt-5 flex flex-wrap gap-3"><a href={`${x}/mock-exam/`} class="btn btn-primary h-cta">Start the mock exam <span aria-hidden="true">→</span></a></div>
          <p class="mt-3 text-sm text-muted">Original practice questions. Not real exam questions.</p>
        </div>
        <div class="tile h-prep">
          <h3 class="text-2xl font-bold">💼 Interview ready</h3>
          <p class="mt-2 leading-relaxed text-muted">Practise with Nimbus as your interviewer. Beginner to architect-level questions, model answers and the follow-up questions real interviewers ask.</p>
          <div class="example-box h-inset mt-5 space-y-3 !p-4">
            <div class="flex items-center gap-3"><Mascot size={48} mood="thinking" /><p class="font-semibold">Mock interview</p></div>
            <div class="bubble bubble-interviewer mr-8"><p class="mb-1 text-xs font-bold uppercase text-muted">Interviewer</p>What is the difference between scalability and elasticity?</div>
            <div class="bubble bubble-candidate ml-8"><p class="mb-1 text-xs font-bold uppercase text-accent">You</p>Scalability is the ability to add or remove resources. Elasticity is when that happens automatically, in real time, based on demand.</div>
            <div class="bubble bubble-interviewer mr-8"><p class="mb-1 text-xs font-bold uppercase text-muted">Interviewer</p>Can you give me a real-world example?</div>
          </div>
          <div class="mt-5 flex flex-wrap gap-3">
            <a href={`${x}/interview/`} class="btn btn-primary h-cta">Practise interview questions <span aria-hidden="true">→</span></a>
            <a href={`${x}/revision/`} class="btn btn-outline h-cta">Revision flashcards</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Play & Learn -->
  <section class="h-sec band-glass" aria-labelledby="play">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <p class="eyebrow">Games and XP</p>
      <h2 id="play" class="h-h2">Play &amp; Learn 🎮</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-muted">Learning Azure should be fun. Play quick games, earn XP, level up from Cloud Seed 🌱 to Azure Legend 👑 and keep your daily 🔥 streak.</p>
      <div class="mt-8 grid gap-3 text-left sm:grid-cols-2 lg:grid-cols-5">
        {[
          ['📅', 'Daily Challenge', '5 questions a day', `${x}/games/daily/`],
          ['🗂️', 'Sort It!', 'Tap cards into buckets', `${x}/games/sort/`],
          ['🧠', 'Match the Pairs', 'Memory card game', `${x}/games/match/`],
          ['⚡', 'Lightning Round', '60-second quiz', `${x}/games/lightning/`],
          ['🕵️', 'Who Am I?', 'Guess the service', `${x}/games/who-am-i/`],
        ].map(([icon, title, text, href]) => (
          <a href={href} class="group tile p-5">
            <span class="block text-4xl transition-transform group-hover:scale-110" aria-hidden="true">{icon}</span>
            <span class="mt-3 block text-lg font-bold">{title}</span>
            <span class="block text-sm text-muted">{text}</span>
          </a>
        ))}
      </div>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={`${x}/games/`} class="btn btn-primary h-cta">Start playing <span aria-hidden="true">→</span></a>
        <a href="/progress/" class="btn btn-outline h-cta">🏆 Track your progress and badges</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="h-sec scroll-mt-28" aria-labelledby="faq-h">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <p class="eyebrow text-center">FAQ</p>
      <h2 id="faq-h" class="h-h2 text-center">Frequently asked questions</h2>
      <div class="faq mt-8">
        {faq.map((f) => <details class="faq-item"><summary><h3 class="faq-q">{f.q}</h3></summary><p class="faq-a">{f.a}</p></details>)}
      </div>
      <div class="mt-10 text-center"><a href="#certifications" class="btn btn-primary h-cta">Choose your certification <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</PublicLayout>

<style>
  /* Home page in the MSDEVBUILD blog style (github.com/jssuthahar/blog): the
     page wash and soft blobs show through, cards are premium glass, headings
     sit on a hairline, buttons are azure pills. Azure blue is the one hue. */

  /* Hero: light, on the page wash, with two soft blobs behind the scene card. */
  .h-hero { position: relative; isolation: isolate; overflow: clip; }
  .h-hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(26rem 22rem at 88% 18%, var(--gp-blob-b), transparent 70%),
      radial-gradient(22rem 20rem at 70% 92%, var(--gp-blob-a), transparent 72%);
    opacity: .55;
  }
  .h-title { font-size: clamp(2.1rem, 5.4vw, 3.5rem); font-weight: 800; line-height: 1.08; }
  .h-title span { display: block; }
  .h-cta { min-height: 48px; padding-inline: 1.5rem; font-size: 1rem; }
  .h-scene { border-radius: 1.5rem; overflow: hidden; }
  .h-stats { border-radius: 1.25rem; padding: 1rem .25rem; }
  .h-stats > div { padding: 0 .75rem; text-align: center; }
  .h-stats > div + div { border-left: 1px solid var(--border); }
  .h-stats dt { font-size: .75rem; line-height: 1.2; color: var(--text-muted); letter-spacing: .02em; }
  .h-stats dd { margin-top: .3rem; font-size: 1.75rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; color: var(--accent-deep); }

  /* Sections */
  .h-sec { padding-block: 3.5rem; }
  @media (min-width: 768px) { .h-sec { padding-block: 4rem; } }
  .h-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
  .h-h2 { margin-top: .4rem; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; letter-spacing: -.025em; line-height: 1.15; text-wrap: balance; }
  .h-lead { margin-top: .6rem; max-width: 42rem; font-size: 1.05rem; line-height: 1.6; color: var(--text-muted); }
  .h-more { font-weight: 650; color: var(--accent-deep); min-height: 44px; display: inline-flex; align-items: center; gap: .3rem; }
  .h-more:hover { text-decoration: underline; }

  /* AI roles */
  .ai-roles { display: grid; gap: .85rem; grid-template-columns: 1fr; }
  @media (min-width: 560px) { .ai-roles { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .ai-roles { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1440px) { .ai-roles { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
  .ai-role { display: flex; flex-direction: column; min-width: 0; height: 100%; padding: 1.1rem 1.15rem; overflow: hidden; overflow-wrap: anywhere; }
  .ai-role::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: linear-gradient(90deg, #0078d4, #005a9e); }
  .ai-role-k { font-size: .72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; color: var(--accent-deep); }
  .ai-role-c { margin-top: .35rem; font-size: 1.5rem; font-weight: 800; letter-spacing: -.02em; }
  .ai-role-n { font-size: .9rem; font-weight: 600; color: var(--text-muted); }
  .ai-role-s { margin-top: auto; padding-top: .7rem; font-size: .8rem; color: var(--text-muted); font-weight: 600; }
  .ai-role-s.is-live { color: var(--ok); }

  /* Live certification spotlight */
  .spot { display: grid; gap: 0; overflow: hidden; border-radius: 1.5rem; }
  @media (min-width: 900px) { .spot { grid-template-columns: 1.35fr 1fr; } }
  .spot-main { padding: clamp(1.25rem, 3vw, 2.25rem); }
  .spot-meta { display: flex; flex-wrap: wrap; gap: .5rem; font-size: .78rem; font-weight: 700; }
  .spot-live { color: var(--ok); }
  .spot-pill { border-radius: 999px; background: var(--accent-soft); color: var(--accent-deep); padding: 2px 10px; }
  .spot-title { margin-top: .75rem; font-size: clamp(1.4rem, 3vw, 1.9rem); font-weight: 800; line-height: 1.2; letter-spacing: -.02em; }
  .spot-title span { color: var(--accent-deep); }
