  .spot-stats > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; border-left: 3px solid var(--accent); padding-left: .7rem; }
  .spot-stats dd { font-size: 1.6rem; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .spot-stats dt { font-size: .78rem; color: var(--text-muted); }
  .spot-btn { min-height: 44px; }
  .spot-side { padding: clamp(1.25rem, 3vw, 2.25rem); background: var(--band-subtle); border-top: 1px solid var(--border); }
  @media (min-width: 900px) { .spot-side { border-top: 0; border-left: 1px solid var(--border); } }
  .spot-side-h { font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-deep); }
  .spot-doms { margin-top: .6rem; display: grid; gap: .4rem; }
  .spot-doms a { display: flex; align-items: center; gap: .7rem; min-height: 44px; padding: .45rem .7rem; border-radius: 12px; background: var(--gp-fill); border: 1px solid var(--gp-tile-line); box-shadow: 0 4px 12px -8px rgb(0 72 130 / .3); transition: border-color .15s, transform .15s; }
  .spot-doms a:hover { border-color: var(--accent); transform: translateX(2px); }
  .spot-dn { flex: none; display: grid; place-items: center; width: 1.7rem; height: 1.7rem; border-radius: 8px; background: linear-gradient(135deg, #0078d4, #005a9e); color: #fff; font-weight: 800; font-size: .85rem; }
  .spot-dt { flex: 1; min-width: 0; font-weight: 600; font-size: .92rem; }
  .spot-dw { flex: none; font-size: .78rem; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .spot-inc { margin-top: .6rem; display: flex; flex-wrap: wrap; gap: .4rem; }
