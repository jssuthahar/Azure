---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import XpToast from '../components/XpToast.astro';
import SpeakButtons from '../components/SpeakButtons.astro';
import Reveal from '../components/Reveal.astro';
import CurrencyPrices from '../components/CurrencyPrices.astro';
import { SITE, SOCIAL } from '../config';

interface Crumb {
  name: string;
  url: string;
}
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  wide?: boolean;
}

const { title, description, type = 'website', schema = [], breadcrumbs = [], noindex = false, wide = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og-default.png', SITE.url).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: `${SITE.url}/`,
    name: SITE.name,
    description: SITE.description,
    inLanguage: SITE.lang,
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.org,
    url: SITE.main,
    logo: new URL(SITE.authorImage, SITE.url).href,
    sameAs: [SITE.blog, SITE.main, 'https://www.youtube.com/@MSDEVBUILD', 'https://www.linkedin.com/company/31318247/', 'https://www.instagram.com/msdevbuild/'],
    founder: { '@id': `${SITE.url}/#author` },
  },
  {
    '@type': 'Person',
    '@id': `${SITE.url}/#author`,
    name: SITE.author,
    url: SITE.profile,
    image: new URL(SITE.authorImage, SITE.url).href,
    jobTitle: SITE.authorTitle,
    homeLocation: { '@type': 'Place', name: SITE.authorLocation },
    worksFor: { '@id': `${SITE.url}/#organization` },
    sameAs: [SITE.profile, SITE.blog, ...SOCIAL.filter((s) => !s.name.startsWith('MSDEVBUILD')).map((s) => s.href.split('?')[0]), 'https://learn.microsoft.com/en-us/users/jssuthahar/'],
  },
  ...(breadcrumbs.length
    ? [
        {
          '@type': 'BreadcrumbList',
          itemListElement: breadcrumbs.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: new URL(c.url, SITE.url).href,
          })),
        },
      ]
    : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={SITE.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0078d4" />
    <meta name="author" content={SITE.author} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        let v = null;
        try { v = localStorage.getItem('lesson-view'); } catch {}
        document.documentElement.dataset.view = v || 'simple';
        document.documentElement.classList.add('js');
      })();
    </script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      {wide ? <slot /> : <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6"><slot /></div>}
    </main>
    <Footer />
    <XpToast />
    <SpeakButtons />
    <Reveal />
    <CurrencyPrices />
  </body>
</html>
