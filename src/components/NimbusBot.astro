---
/**
 * Nimbus lives in @msdevbuild/config (shared with the blog). This wrapper adds
 * what only this site has: the accessory for the learner's XP level and the
 * character skin they picked (src/lib/nimbus-skins.ts).
 */
import Bot from '@msdevbuild/config/components/NimbusBot.astro';
interface Props {
  size?: number; class?: string; mood?: 'idle' | 'wave' | 'think' | 'talk' | 'cheer' | 'dance' | 'listen'; tap?: boolean;
  /** Celebrate when the learner earns XP. */
  react?: boolean;
  /** Fixed look (1-6) instead of the learner's level; 0 = no accessory. */
  level?: number;
}
---
<Bot {...Astro.props} />

<script>
  import { load, levelFor } from '../lib/progress';
  // Nimbus grows with the learner's XP level (the shared bot handles the night cap).
  const dress = () => {
    const lv = levelFor(load().xp).level;
    document.querySelectorAll<SVGElement>('svg.nb').forEach((svg) => {
      if (!svg.hasAttribute('data-level-fixed')) svg.dataset.level = String(lv);
    });
  };
  dress();
  addEventListener('progress-change', dress);

  // Wear the learner's chosen character everywhere (cloud is the server-rendered default).
  // The character art (nimbus-skins.ts) loads only when a learner has picked something other than the cloud.
  const chosen = () => { try { return JSON.parse(localStorage.getItem('msdb-azure-plan-v1') || '{}')._coach?.skin || 'cloud'; } catch { return 'cloud'; } };
  const wear = async () => {
    const want = chosen();
    const svgs = [...document.querySelectorAll<SVGElement>('svg.nb:not(.nb-mini):not([data-skin-fixed])')].filter((svg) => (svg.dataset.skin || 'cloud') !== want);
    if (!svgs.length) return;
    const { skinMarkup, skinOrDefault } = await import('../lib/nimbus-skins');
    const skin = skinOrDefault(want);
    svgs.forEach((svg) => {
      const g = svg.querySelector('.nb-skin');
      if (g && svg.dataset.nbid) { g.innerHTML = skinMarkup(skin, svg.dataset.nbid); svg.dataset.skin = skin; }
    });
  };
  wear();
  addEventListener('nimbus-skin', wear);
  addEventListener('msdb-data-change', wear);
  addEventListener('storage', (e) => { if (e.key === 'msdb-azure-plan-v1') wear(); });
</script>
