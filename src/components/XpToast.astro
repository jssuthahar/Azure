---
/** Global "+XP" toast and level-up celebration, driven by `xp-gain` events. */
---
<div id="xp-toasts" class="pointer-events-none fixed right-4 bottom-4 z-[150] flex flex-col items-end gap-2" aria-live="polite"></div>
<script>
  import { confetti } from '../lib/fun';
  const box = document.getElementById('xp-toasts')!;
  window.addEventListener('xp-gain', (e) => {
    const { amount, reason, levelUp } = (e as CustomEvent).detail;
    const t = document.createElement('div');
    t.className = 'xp-toast flex items-center gap-2 rounded-full bg-[#0078d4] px-4 py-2 text-sm font-semibold text-white shadow-lg';
    t.innerHTML = `<span>⭐ +${amount} XP</span><span class="font-normal opacity-90">${reason}</span>`;
    box.append(t);
    setTimeout(() => t.remove(), 2600);
    if (levelUp) {
      const l = document.createElement('div');
      l.className = 'xp-toast rounded-2xl bg-[#ffd75e] px-5 py-3 text-base font-bold text-[#0b1020] shadow-xl';
      l.textContent = `${levelUp.icon} Level up! You are now a ${levelUp.name}`;
      box.append(l);
      setTimeout(() => l.remove(), 4200);
      confetti(200);
    }
  });
</script>
<style>
  :global(.xp-toast) {
    animation: xp-in 0.35s cubic-bezier(0.2, 0.9, 0.3, 1.3);
  }
  @keyframes xp-in {
    from {
      transform: translateY(16px) scale(0.9);
      opacity: 0;
    }
  }
</style>
