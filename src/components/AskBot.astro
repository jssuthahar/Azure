---
/**
 * "Ask Nimbus": a floating chat on every page. The learner picks an exam, asks a
 * question, and gets the closest answers from this site's own lessons, FAQs,
 * glossary and comparisons. Free and private: the exam's answer index
 * (/<exam>/ask-index.json) is loaded on first use and ranked in the browser.
 * Nothing the learner types leaves the device.
 *
 * On a lesson, Nimbus is also the lesson tutor: it explains the same lesson
 * another way (simpler, a real example, the exam traps, a deeper technical
 * answer), quizzes the learner and lists key terms, all from that lesson's own
 * content in the index. Any button with [data-tutor-open] opens it.
 */
import { liveExams } from '../data/exams';
import NimbusBot from './NimbusBot.astro';
import { SITE, SUPPORT } from '../config';
const exams = liveExams().map((e) => ({ slug: e.slug, code: e.code, name: e.name }));
const here = exams.find((e) => e.slug === Astro.url.pathname.split('/')[1])?.slug ?? '';
---
<div id="ask" data-msdb-feature="askBot" data-exams={JSON.stringify(exams)} data-here={here} data-site={SITE.url} data-coffee={SUPPORT.url}>
  <button id="ask-fab" type="button" class="ask-fab" aria-expanded="false" aria-controls="ask-panel" aria-label="Ask Nimbus a question about your exam">
    <span class="ask-fab-bot"><NimbusBot size={54} react /></span>
    <span>Ask</span>
  </button>

  <section id="ask-panel" class="ask-panel" role="dialog" aria-labelledby="ask-title" hidden>
    <div class="ask-head">
      <span class="ask-ava"><NimbusBot size={46} mood="wave" /></span>
      <div class="ask-id">
        <p id="ask-title" class="ask-title">Ask Nimbus</p>
        <p class="ask-sub"><span class="ask-dot" aria-hidden="true"></span><span id="ask-status">Your study buddy</span><span id="ask-exam" class="ask-exam"></span></p>
      </div>
      <button id="ask-switch" type="button" class="ask-hbtn" aria-label="Change exam" title="Change exam" hidden><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 7h11l-3-3M17 17H6l3 3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
      <button type="button" class="ask-hbtn" data-coach-open aria-label="My study plan" title="My study plan"><span aria-hidden="true">🎯</span></button>
      <button id="ask-close" type="button" class="ask-hbtn ask-x" aria-label="Close chat">✕</button>
    </div>
    <div id="ask-log" class="ask-log" role="log" aria-live="polite"></div>
    <form id="ask-form" class="ask-form" autocomplete="off">
      <label for="ask-q" class="sr-only">Your question</label>
      <input id="ask-q" type="text" enterkeyhint="send" maxlength="200" placeholder="Pick an exam first" disabled />
      <button type="submit" class="ask-send" aria-label="Ask" disabled><svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z" fill="currentColor" /></svg></button>
    </form>
    <p class="ask-note">Answers come from MSDEVBUILD lessons and stay on your device. 3D and portal simulations first. Education only, not affiliated with Microsoft.</p>
  </section>
</div>

<script>
  // Nimbus on the button animates for its hello, then rests (no constant repaint on every page).
  // It wakes on hover, keyboard focus or when the learner earns XP.
  const fabBot = document.querySelector<HTMLElement>('.ask-fab-bot');
  let restT = 0;
  const rest = (ms: number) => { clearTimeout(restT); restT = window.setTimeout(() => fabBot?.classList.add('is-resting'), ms); };
  const wake = (ms = 5000) => { fabBot?.classList.remove('is-resting'); rest(ms); };
  rest(7000);
  document.getElementById('ask-fab')?.addEventListener('pointerenter', () => wake());
  document.getElementById('ask-fab')?.addEventListener('focus', () => wake());
  addEventListener('xp-gain', () => wake(4500));
  // The chat itself (src/lib/ask-chat.ts) loads on first use, so pages stay light until someone asks.
  const fab = document.getElementById('ask-fab') as HTMLButtonElement;
  let loading: Promise<void> | null = null;
  const loadChat = () => (loading ??= import('../lib/ask-chat').then((m) => { m.mountChat(); off(); }));
  const onFab = (e: Event) => { e.stopImmediatePropagation(); fab.setAttribute('aria-busy', 'true'); loadChat().then(() => { fab.removeAttribute('aria-busy'); fab.click(); }); };
  const onTutor = (e: Event) => {
    const t = (e.target as Element)?.closest?.('[data-tutor-open]') as HTMLElement | null;
    if (!t) return;
    e.stopImmediatePropagation();
    loadChat().then(() => t.click());
  };
  const onEvent = (e: Event) => { const ce = e as CustomEvent; e.stopImmediatePropagation(); loadChat().then(() => window.dispatchEvent(new CustomEvent(ce.type, { detail: ce.detail }))); };
  fab.addEventListener('click', onFab, true);
  document.addEventListener('click', onTutor, true);
  addEventListener('nimbus-chat', onEvent);
  addEventListener('nimbus-tutor', onEvent);
  function off() {
    fab.removeEventListener('click', onFab, true);
    document.removeEventListener('click', onTutor, true);
    removeEventListener('nimbus-chat', onEvent);
    removeEventListener('nimbus-tutor', onEvent);
  }
  // Small screens: step aside while key content marked [data-ask-clear] sits where the button floats.
  const clear = document.querySelectorAll('[data-ask-clear]');
  if (clear.length && 'IntersectionObserver' in window) {
    const small = matchMedia('(max-width: 767px)');
    const under = new Set<Element>();
    const sync = () => fab.classList.toggle('is-tucked', small.matches && under.size > 0);
    const io = new IntersectionObserver((es) => { for (const e of es) e.isIntersecting ? under.add(e.target) : under.delete(e.target); sync(); }, { rootMargin: '-86% 0px 0px 0px' });
    clear.forEach((el) => io.observe(el));
    small.addEventListener('change', sync);
  }
</script>

<style>
  .ask-fab {
    position: fixed; z-index: 90;
    right: max(16px, env(safe-area-inset-right)); bottom: calc(16px + env(safe-area-inset-bottom));
    display: inline-flex; align-items: center; gap: 6px; min-height: 48px; padding: 0 18px 0 14px;
    border-radius: 999px; border: 1px solid rgb(255 255 255 / .18); color: #fff; font-weight: 700; letter-spacing: .01em;
    background: linear-gradient(135deg, #1a8cff 0%, #0063b8 45%, #0a2f5c 100%);
    box-shadow: 0 14px 32px -10px rgb(0 70 150 / .65), 0 0 0 4px rgb(0 120 212 / .12), inset 0 1px 0 rgb(255 255 255 / .35);
    cursor: pointer; overflow: visible; isolation: isolate;
  }
  /* a static gloss on the pill (no animation: this button is on every page, so it must never repaint constantly) */
  .ask-fab::after { content: ''; position: absolute; inset: 1px 1px 50%; z-index: -1; border-radius: 999px 999px 40% 40%; background: linear-gradient(180deg, rgb(255 255 255 / .22), transparent); pointer-events: none; }
  .ask-fab { transition: transform .25s ease, opacity .2s ease, visibility 0s linear 0s; }
  .ask-fab.is-tucked { transform: translateY(calc(100% + 24px)); opacity: 0; visibility: hidden; transition: transform .25s ease, opacity .2s ease, visibility 0s linear .25s; }
  @media (prefers-reduced-motion: reduce) { .ask-fab, .ask-fab.is-tucked { transition: none; } }
  .ask-fab:hover { transform: translateY(-2px); box-shadow: 0 18px 38px -10px rgb(0 70 150 / .75), 0 0 0 5px rgb(0 120 212 / .16), inset 0 1px 0 rgb(255 255 255 / .35); }
  .ask-fab-bot { display: grid; place-items: center; width: 52px; height: 40px; margin: -20px 0 -4px -12px; }
  .ask-fab-bot :global(.nb) { filter: drop-shadow(0 4px 6px rgb(0 20 50 / .35)); }
  .ask-fab-bot :global(.nb-shadow) { display: none; }
  .ask-fab-bot :global(.nb-arm) { animation: nb-wave 2.6s ease-in-out 1.2s 2; }
  /* The button is on every page: keep it light (float and blink only), so it never makes the page repaint constantly. */
  .ask-fab-bot :global(:is(.nb-glow, .nb-sheen, .nb-shadow, .nb-arm-l)) { animation: none; }
  .ask-fab-bot.is-resting :global(.nb *) { animation: none !important; }
  .ask-fab:hover .ask-fab-bot :global(.nb-arm), .ask-fab:focus-visible .ask-fab-bot :global(.nb-arm) { animation: nb-wave 2.6s ease-in-out infinite; }
  .ask-fab:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  /* make room for the install banner and the lesson reader; step aside in the exam room */
  :global(body:has(.install-banner)) .ask-fab, :global(body:has(.install-banner)) .ask-panel { bottom: calc(96px + env(safe-area-inset-bottom)); }
  :global(body:has(.install-banner)) .ask-panel { height: min(580px, calc(100dvh - 180px)); }
  :global(body:has(#xs:not([hidden]))) #ask { display: none; }
  #ask.is-open .ask-fab { display: none; }

  .ask-panel {
    position: fixed; z-index: 95;
    right: max(12px, env(safe-area-inset-right)); bottom: calc(12px + env(safe-area-inset-bottom));
    width: min(400px, calc(100vw - 24px)); height: min(600px, calc(100dvh - 96px));
    display: flex; flex-direction: column;
    border-radius: 24px; border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--card-line)); color: var(--text);
    background: var(--card);
    box-shadow: 0 40px 90px -24px rgb(0 25 60 / .6), 0 12px 28px -18px rgb(0 60 140 / .45), inset 0 1px 0 rgb(255 255 255 / .5);
    overflow: hidden;
    transform-origin: 100% 100%; animation: ask-in .28s cubic-bezier(.3, .8, .4, 1.1);
  }
  .ask-panel[hidden] { display: none; }
  @keyframes ask-in { from { opacity: 0; transform: translateY(14px) scale(.94); } to { opacity: 1; transform: none; } }
  .ask-head {
    position: relative; display: flex; align-items: center; gap: 10px; padding: 12px 10px 12px 12px; color: #fff; isolation: isolate; overflow: hidden;
    background: linear-gradient(135deg, #0a5cad 0%, #073b75 55%, #061f3f 100%);
    box-shadow: inset 0 -1px 0 rgb(255 215 94 / .45);
  }
  /* slow aurora behind the header */
  .ask-head::before { content: ''; position: absolute; inset: -60% -20%; z-index: -1; background: radial-gradient(40% 50% at 20% 30%, rgb(98 230 255 / .35), transparent 70%), radial-gradient(35% 45% at 85% 70%, rgb(140 110 255 / .28), transparent 70%); animation: ask-aurora 14s ease-in-out infinite alternate; }
  @keyframes ask-aurora { from { transform: translate(-6%, -4%) rotate(0); } to { transform: translate(6%, 4%) rotate(8deg); } }
  @media (prefers-reduced-motion: reduce) { .ask-head::before { animation: none; } }
  .ask-ava { flex: none; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / .32), rgb(255 255 255 / .08) 70%); box-shadow: inset 0 0 0 1px rgb(255 255 255 / .28), 0 0 0 3px rgb(255 215 94 / .35), 0 6px 18px -6px rgb(0 0 0 / .5); }
  .ask-ava :global(.nb-shadow) { display: none; }
  .ask-id { flex: 1; min-width: 0; }
  .ask-title { margin: 0; font-weight: 800; font-size: 1.05rem; line-height: 1.2; letter-spacing: -.01em; }
  .ask-sub { display: flex; align-items: center; gap: 6px; margin: 2px 0 0; font-size: .78rem; color: #e3f1ff; white-space: nowrap; overflow: hidden; }
  .ask-sub > span:not(.ask-dot) { overflow: hidden; text-overflow: ellipsis; }
  .ask-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: #5ff0a0; box-shadow: 0 0 0 3px rgb(95 240 160 / .25); transition: background .2s, box-shadow .2s; }
  .ask-sub[data-state='busy'] .ask-dot { background: #ffd75e; box-shadow: 0 0 0 3px rgb(255 215 94 / .3); animation: ask-dots .9s ease-in-out infinite; }
  .ask-sub[data-state='off'] .ask-dot { background: #b7c3d3; box-shadow: 0 0 0 3px rgb(183 195 211 / .25); }
  .ask-exam { flex: none; padding: 1px 8px; border-radius: 999px; background: rgb(255 255 255 / .2); font-size: .74rem; font-weight: 700; color: #fff; }
  .ask-exam:empty { display: none; }
  .ask-hbtn { flex: none; display: grid; place-items: center; min-height: 36px; min-width: 36px; padding: 0 8px; border-radius: 12px; border: 1px solid rgb(255 255 255 / .16); background: rgb(255 255 255 / .1); color: #fff; font-size: .9rem; cursor: pointer; transition: background .15s, border-color .15s; backdrop-filter: blur(6px); }
  .ask-hbtn:hover { background: rgb(255 255 255 / .22); border-color: rgb(255 255 255 / .35); }
  .ask-hbtn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .ask-hbtn[hidden] { display: none; }

  .ask-log {
    flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 14px 12px; display: flex; flex-direction: column; gap: 10px;
    background-color: var(--bg-subtle);
    background-image: radial-gradient(circle at 1px 1px, color-mix(in srgb, var(--accent) 14%, transparent) 1px, transparent 0);
    background-size: 18px 18px;
  }
  .ask-log :global(.ask-row) { display: flex; align-items: flex-end; gap: 6px; max-width: 96%; animation: ask-rise .3s ease-out both; }
  .ask-log :global(.ask-row .ask-msg) { max-width: calc(100% - 36px); }
  .ask-log :global(.ask-ava-s) { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, var(--accent-soft)); box-shadow: 0 0 0 2px rgb(255 215 94 / .55), 0 4px 10px -4px rgb(0 60 140 / .5); }
  .ask-log :global(.ask-row.is-cont .ask-ava-s) { visibility: hidden; }
  .ask-log :global(.ask-msg.is-typing) { min-width: 58px; }
  .ask-log :global(.ask-msg.is-typing > *) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ask-log :global(.ask-msg.is-typing::after) { content: ''; display: block; width: 7px; height: 7px; margin: 5px 24px 5px 6px; border-radius: 50%; background: var(--accent); box-shadow: 11px 0 var(--accent), 22px 0 var(--accent); animation: ask-dots .9s ease-in-out infinite; }
  .ask-log :global(.ask-me) { animation: ask-rise .25s ease-out both; }
  .ask-log :global(.ask-exams) { display: grid; grid-template-columns: repeat(auto-fill, minmax(112px, 1fr)); gap: 6px; margin-top: 8px; }
  .ask-log :global(.ask-examcard) { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; min-height: 52px; padding: 8px 10px; border-radius: 14px; border: 1px solid var(--card-line); background: var(--bg); color: var(--text); text-align: left; cursor: pointer; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .ask-log :global(.ask-examcard strong) { font-size: .95rem; color: var(--accent-deep); }
  .ask-log :global(.ask-examcard span) { font-size: .76rem; line-height: 1.3; color: var(--text-muted); }
  .ask-log :global(.ask-examcard:hover) { border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 6px 16px -8px rgb(0 60 120 / .4); }
  .ask-log :global(.ask-examcard:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  @keyframes ask-rise { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes ask-dots { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .ask-panel, .ask-log :global(.ask-row), .ask-log :global(.ask-me) { animation: none; } }
  .ask-log :global(.ask-msg) { max-width: 92%; padding: 10px 12px; border-radius: 14px; font-size: .95rem; line-height: 1.5; overflow-wrap: anywhere; }
  .ask-log :global(.ask-msg p) { margin: 0; }
  .ask-log :global(.ask-msg p + p), .ask-log :global(.ask-msg p + .ask-chips), .ask-log :global(.ask-chips + p) { margin-top: 8px; }
  .ask-log :global(.ask-bot) { position: relative; align-self: flex-start; background: linear-gradient(180deg, var(--card), color-mix(in srgb, var(--card) 92%, var(--accent))); border: 1px solid color-mix(in srgb, var(--accent) 16%, var(--card-line)); border-radius: 18px 18px 18px 6px; box-shadow: 0 10px 24px -16px rgb(0 40 90 / .55), inset 0 1px 0 rgb(255 255 255 / .6); }
  .ask-log :global(.ask-me) { align-self: flex-end; background: linear-gradient(135deg, #1a8cff, #0063b8 55%, #0a3d75); color: #fff; border-radius: 18px 18px 6px 18px; box-shadow: 0 10px 22px -12px rgb(0 70 150 / .7), inset 0 1px 0 rgb(255 255 255 / .3); }
  .ask-log :global(.ask-strong) { font-weight: 700; }
  .ask-log :global(.ask-head2) { font-size: .78rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--accent-deep); }
  .ask-log :global(.ask-steps) { list-style: decimal; font-size: .88rem; }
  .ask-log :global(.ask-chip.ask-go) { background: linear-gradient(135deg, #1a8cff, #0063b8 60%, #0a3d75); border-color: transparent; color: #fff; font-weight: 700; box-shadow: 0 8px 18px -10px rgb(0 70 150 / .8), inset 0 1px 0 rgb(255 255 255 / .3); }
  .ask-log :global(.ask-chip.ask-go:hover) { background: linear-gradient(135deg, #3399ff, #0070cc 60%, #0a3d75); }
  .ask-log :global(.ask-msg ol + .ask-chips), .ask-log :global(.ask-msg ul + p), .ask-log :global(.ask-msg ol + p) { margin-top: 8px; }
  .ask-log :global(.ask-list) { margin: 0; padding-left: 1.1rem; list-style: disc; }
  .ask-log :global(.ask-list li + li) { margin-top: 4px; }
  .ask-log :global(.ask-src), .ask-log :global(.ask-more) { font-size: .82rem; color: var(--text-muted); }
  /* home */
  .ask-log { --ring-track: color-mix(in srgb, var(--accent) 14%, var(--card)); }
  .ask-log :global(.ask-home) { display: flex; flex-direction: column; gap: 10px; }
  .ask-log :global(.ask-meet) { align-self: flex-end; margin: -4px -4px -6px 0; min-height: 34px; padding: 0 12px; border-radius: 999px; border: 1px solid color-mix(in srgb, #ffc83d 60%, var(--card-line)); background: color-mix(in srgb, #ffc83d 18%, var(--card)); color: var(--text); font: inherit; font-size: .8rem; font-weight: 800; cursor: pointer; }
  .ask-log :global(.ask-meet:hover) { background: color-mix(in srgb, #ffc83d 32%, var(--card)); }
  .ask-log :global(.ask-meet:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ask-log :global(.ask-ava-s svg) { border-radius: 50%; }
  .ask-log :global(.ask-home-top) { display: flex; align-items: center; gap: 12px; }
  .ask-log :global(.ask-ring) { position: relative; flex: none; width: 62px; height: 62px; }
  .ask-log :global(.ask-ring span) { position: absolute; inset: 0; display: grid; place-items: center; font-size: .9rem; font-weight: 800; color: var(--accent-deep); }
  .ask-log :global(.ask-home-w) { min-width: 0; }
  .ask-log :global(.ask-hello) { margin: 0; font-size: 1.3rem; font-weight: 800; line-height: 1.15; letter-spacing: -.01em; }
  .ask-log :global(.ask-hello-sm) { font-size: 1.05rem; }
  .ask-log :global(.ask-home-sub) { margin: 4px 0 0 !important; font-size: .84rem; color: var(--text-muted); }
  .ask-log :global(.ask-next) { display: flex; align-items: center; gap: 8px; padding: 9px 11px; border-radius: 14px; background: color-mix(in srgb, var(--accent) 10%, var(--card)); font-size: .88rem; font-weight: 600; }
  .ask-log :global(.ask-next-l) { flex: none; font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--accent-deep); }
  .ask-log :global(.ask-cta) { flex: 1; display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 14px; border-radius: 999px; border: 0; background: linear-gradient(135deg, #1a8cff, #0063b8 60%, #0a3d75); color: #fff; font-size: .9rem; font-weight: 700; text-decoration: none; cursor: pointer; box-shadow: 0 8px 18px -10px rgb(0 70 150 / .8); }
  .ask-log :global(.ask-cta-2) { background: var(--bg); color: var(--accent-deep); border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--card-line)); box-shadow: none; }
  .ask-log :global(.ask-cta:disabled) { opacity: .45; cursor: default; }
  .ask-log :global(.ask-cta:focus-visible), .ask-log :global(.ask-tile:focus-visible), .ask-log :global(.ask-opt:focus-visible), .ask-log :global(.ask-tab:focus-visible), .ask-log :global(.ask-thumb:focus-visible), .ask-log :global(.ask-signin:focus-visible), .ask-log :global(.ask-post:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ask-log :global(.ask-tiles) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .ask-log :global(.ask-tile) { display: flex; flex-direction: column; align-items: flex-start; gap: 3px; min-height: 84px; padding: 11px; border-radius: 16px; border: 1px solid color-mix(in srgb, var(--accent) 18%, var(--card-line)); background: var(--bg); color: var(--text); text-align: left; text-decoration: none; font: inherit; cursor: pointer; transition: transform .15s, border-color .15s, box-shadow .15s; }
  .ask-log :global(.ask-tile:hover) { transform: translateY(-2px); border-color: var(--accent); box-shadow: 0 12px 22px -16px rgb(0 70 150 / .8); }
  .ask-log :global(.ask-tile b) { font-size: .9rem; }
  .ask-log :global(.ask-tile-i) { display: grid; color: var(--accent); }
  .ask-log :global(.ask-tile-n) { font-size: .74rem; line-height: 1.3; color: var(--text-muted); }
  .ask-log :global(.ask-tile.is-gold) { background: color-mix(in srgb, #ffc83d 16%, var(--card)); border-color: color-mix(in srgb, #ffc83d 55%, var(--card-line)); }
  .ask-log :global(.ask-tile.is-gold .ask-tile-i) { color: #b07400; }
  .ask-log :global(.ask-signin) { align-self: flex-start; min-height: 36px; margin-top: 8px; padding: 0; border: 0; background: none; color: var(--accent-deep); font-size: .82rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
  /* quiz */
  .ask-log :global(.ask-opts) { display: grid; gap: 6px; margin-top: 8px; }
  .ask-log :global(.ask-opt) { display: flex; align-items: flex-start; gap: 10px; min-height: 44px; padding: 9px 11px; border-radius: 14px; border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--card-line)); background: var(--bg); color: var(--text); font: inherit; font-size: .88rem; text-align: left; cursor: pointer; }
  .ask-log :global(.ask-opt:not(:disabled):hover) { border-color: var(--accent); }
