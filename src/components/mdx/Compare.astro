---
/** Side-by-side comparison diagram. Columns stack on small screens. */
interface Col { title: string; subtitle?: string; icon?: string; items: string[]; tone?: 'neutral' | 'accent' | 'ok' | 'warn' }
interface Props { columns: Col[]; caption: string }
const { columns, caption } = Astro.props;
const tone = { neutral: 'var(--border)', accent: 'var(--accent)', ok: 'var(--ok)', warn: 'var(--bad)' };
---
<figure class="card p-4 sm:p-5">
  <div class={`grid gap-3 ${columns.length === 2 ? 'sm:grid-cols-2' : columns.length === 3 ? 'md:grid-cols-3' : 'sm:grid-cols-2 xl:grid-cols-4'}`}>
    {columns.map((c) => (
      <div class="rounded-xl border-2 bg-[var(--bg)] p-4" style={`border-color:${tone[c.tone ?? 'neutral']}`}>
        <p class="flex items-center gap-2 text-base font-semibold">{c.icon && <span aria-hidden="true" class="text-xl">{c.icon}</span>}{c.title}</p>
        {c.subtitle && <p class="mt-0.5 text-xs text-muted">{c.subtitle}</p>}
        <ul class="mt-3 space-y-1.5 text-sm leading-relaxed">{c.items.map((i) => <li class="flex gap-2"><span aria-hidden="true" class="text-accent">›</span><span set:html={i} /></li>)}</ul>
      </div>
    ))}
  </div>
  <figcaption class="mt-3 text-center text-sm text-muted">{caption}</figcaption>
</figure>
