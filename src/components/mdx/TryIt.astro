---
/**
 * "Try it yourself" box inside a lesson. It never leaves the page: the button
 * switches the lesson's Simulations section to the Practice Lab tab with this
 * lab selected. Usage in MDX: <TryIt labs="vm-and-cost" text="..." />
 */
import { ALL_LABS } from '../../lib/sim/labs';
interface Props { labs: string; text: string }
const { labs, text } = Astro.props;
const list = labs.split(',').map((id) => ALL_LABS.find((l) => l.id === id.trim())).filter(Boolean);
---
<aside class="tryit not-prose rounded-xl border-l-[5px] border-[#107c10] bg-[var(--pastel-green)] p-4" aria-label="Try it yourself">
  <p class="text-sm font-bold verdict-ok">🧪 Try it yourself, right here</p>
  <p class="mt-1 text-[0.98rem] leading-relaxed">{text}</p>
  <div class="mt-3 flex flex-wrap gap-2">
    {list.map((l) => (
      <a href="#simulations" class="sim-jump" data-sim-tab="lab" data-sim-lab={l!.id}>
        <span aria-hidden="true">{l!.icon}</span> {l!.id === 'sandbox' ? 'Open the sandbox' : `Practise: ${l!.title}`} »
      </a>
    ))}
  </div>
</aside>
