---
/** Cumulative spend: buying servers up front (CapEx) vs renting monthly (OpEx). Illustrative numbers. */
interface Props { caption?: string }
const { caption = 'Illustrative numbers only. CapEx front-loads the spend; OpEx spreads it out and can be switched off.' } = Astro.props;
const months = 36;
const capex = Array.from({ length: months + 1 }, (_, m) => 90 + m * 1.2 + (m >= 30 ? 25 : 0));
const opex = Array.from({ length: months + 1 }, (_, m) => m * 3.4);
const W = 600, H = 240, padL = 40, padB = 26, padT = 12, max = 150;
const x = (m: number) => padL + (m * (W - padL - 10)) / months;
const y = (v: number) => padT + (H - padT - padB) * (1 - v / max);
const path = (a: number[]) => a.map((v, i) => `${i ? 'L' : 'M'}${x(i)},${y(v)}`).join(' ');
---
<figure class="card p-4 sm:p-5">
  <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-label="Line chart: CapEx starts with a large upfront cost; OpEx starts at zero and grows steadily each month">
    {[0, 50, 100, 150].map((v) => (
      <g>
        <line x1={padL} x2={W - 10} y1={y(v)} y2={y(v)} stroke="var(--border)" stroke-dasharray="3 4" />
        <text x={padL - 6} y={y(v) + 4} text-anchor="end" font-size="10" fill="var(--text-muted)">{v}k</text>
      </g>
    ))}
    {[0, 12, 24, 36].map((m) => <text x={x(m)} y={H - 8} text-anchor="middle" font-size="10" fill="var(--text-muted)">Month {m}</text>)}
    <path d={path(capex)} fill="none" stroke="var(--you)" stroke-width="3" />
    <path d={path(opex)} fill="none" stroke="var(--accent)" stroke-width="3" />
    <text x={x(2)} y={y(capex[2]) - 8} font-size="11" font-weight="600" fill="var(--you)">CapEx: buy servers up front</text>
    <text x={x(30)} y={y(capex[30]) - 10} font-size="10" text-anchor="middle" fill="var(--you)">hardware refresh</text>
    <text x={x(14)} y={y(opex[14]) + 18} font-size="11" font-weight="600" fill="var(--accent)">OpEx: pay monthly for what you use</text>
  </svg>
  <figcaption class="mt-3 text-center text-sm text-muted">{caption}</figcaption>
</figure>
