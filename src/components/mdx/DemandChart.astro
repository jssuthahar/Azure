---
/**
 * Interactive demand-vs-capacity chart. Shows wasted capacity (paying for
 * idle servers) and unmet demand (users turned away) for each strategy.
 */
type Mode = 'fixed' | 'manual' | 'elastic';
interface Props { modes?: Mode[]; initial?: Mode; caption?: string }
const { modes = ['fixed', 'manual', 'elastic'], initial = modes[0], caption = 'One day of traffic on an online exam website. Toggle a strategy to see the trade-off.' } = Astro.props;

const demand = [20, 18, 16, 15, 15, 18, 30, 45, 60, 70, 72, 68, 65, 70, 95, 100, 92, 75, 60, 50, 45, 38, 30, 24];
const plans: Record<Mode, { label: string; desc: string; cap: number[] }> = {
  fixed: { label: 'Fixed servers', desc: 'Bought once for an "average busy day". Idle at night, overwhelmed at the 3 pm exam rush.', cap: demand.map(() => 75) },
  manual: {
    label: 'Scale manually',
    desc: 'An engineer adds or removes servers on a schedule. Better, but the rush arrived an hour before anyone reacted.',
    cap: demand.map((_, h) => (h < 7 ? 40 : h < 15 ? 80 : h < 20 ? 105 : 60)),
  },
  elastic: { label: 'Elastic (autoscale)', desc: 'Capacity follows demand automatically with a small safety buffer. Very little waste, nobody turned away.', cap: demand.map((d) => Math.ceil((d * 1.12) / 5) * 5) },
};

const W = 600, H = 250, padL = 36, padB = 26, padT = 12;
const max = 120;
const x = (i: number) => padL + (i * (W - padL - 8)) / (demand.length - 1);
const y = (v: number) => padT + (H - padT - padB) * (1 - v / max);
const line = (vals: number[], step = false) =>
  vals.map((v, i) => (i === 0 ? `M${x(i)},${y(v)}` : step ? `H${x(i)}V${y(v)}` : `L${x(i)},${y(v)}`)).join(' ');
const barW = (W - padL - 8) / demand.length - 4;

const stats = Object.fromEntries(
  (Object.keys(plans) as Mode[]).map((m) => {
    const cap = plans[m].cap;
    const waste = cap.reduce((s, c, i) => s + Math.max(0, c - demand[i]), 0);
    const unmet = cap.reduce((s, c, i) => s + Math.max(0, demand[i] - c), 0);
    const totalCap = cap.reduce((a, b) => a + b, 0);
    const totalDemand = demand.reduce((a, b) => a + b, 0);
    return [m, { waste: Math.round((waste / totalCap) * 100), unmet: Math.round((unmet / totalDemand) * 100) }];
  }),
) as Record<Mode, { waste: number; unmet: number }>;
const uid = 'dc' + Math.random().toString(36).slice(2, 8);
---
<figure class="demand-chart card p-4 sm:p-5" data-mode={initial}>
  <div role="radiogroup" aria-label="Capacity strategy" class="flex flex-wrap gap-2">
    {modes.map((m) => (
      <label class="opt !py-1.5 text-sm">
        <input type="radio" name={uid} value={m} checked={m === initial} />
        {plans[m].label}
      </label>
    ))}
  </div>
  <svg viewBox={`0 0 ${W} ${H}`} class="mt-4 h-auto w-full" role="img" aria-label="Chart of user demand against server capacity over 24 hours">
    {[0, 25, 50, 75, 100].map((v) => (
      <g>
        <line x1={padL} x2={W - 8} y1={y(v)} y2={y(v)} stroke="var(--border)" stroke-dasharray="3 4" />
        <text x={padL - 6} y={y(v) + 4} text-anchor="end" font-size="10" fill="var(--text-muted)">{v}</text>
      </g>
    ))}
    {[0, 6, 12, 18, 23].map((h) => <text x={x(h)} y={H - 8} text-anchor="middle" font-size="10" fill="var(--text-muted)">{String(h).padStart(2, '0')}:00</text>)}
    {modes.map((m) => (
      <g data-plan={m}>
        {plans[m].cap.map((c, i) => {
          const d = demand[i];
          const top = Math.max(c, d), bottom = Math.min(c, d);
          return <rect x={x(i) - barW / 2} width={barW} y={y(top)} height={Math.max(0, y(bottom) - y(top))} rx="2" fill={c >= d ? 'var(--accent)' : 'var(--bad)'} opacity={c >= d ? 0.18 : 0.55} />;
        })}
        <path d={line(plans[m].cap, m !== 'elastic')} fill="none" stroke="var(--accent)" stroke-width="3" stroke-linejoin="round" />
      </g>
    ))}
    <path d={line(demand)} fill="none" stroke="var(--text)" stroke-width="2.5" stroke-dasharray="6 4" stroke-linejoin="round" />
  </svg>
  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-xs text-muted">
    <span><span class="mr-1 inline-block h-0.5 w-5 align-middle" style="border-top:2.5px dashed var(--text)"></span>User demand</span>
    <span><span class="mr-1 inline-block h-1 w-5 rounded align-middle" style="background:var(--accent)"></span>Capacity you pay for</span>
    <span><span class="mr-1 inline-block size-3 rounded-sm align-middle" style="background:var(--accent);opacity:.25"></span>Idle (wasted) capacity</span>
    <span><span class="mr-1 inline-block size-3 rounded-sm align-middle" style="background:var(--bad);opacity:.6"></span>Users turned away</span>
  </div>
  {modes.map((m) => (
    <div data-plan={m} class="mt-4 grid gap-3 sm:grid-cols-[1fr_auto_auto] sm:items-center" aria-live="polite">
      <p class="text-sm leading-relaxed">{plans[m].desc}</p>
      <p class="rounded-xl border border-default bg-[var(--bg)] px-3 py-2 text-center text-sm"><span class="block text-lg font-bold text-accent">{stats[m].waste}%</span>capacity idle</p>
      <p class="rounded-xl border border-default bg-[var(--bg)] px-3 py-2 text-center text-sm"><span class="block text-lg font-bold verdict-bad">{stats[m].unmet}%</span>demand unmet</p>
    </div>
  ))}
  <figcaption class="mt-3 text-center text-sm text-muted">{caption}</figcaption>
</figure>
<style>
  .demand-chart [data-plan] { display: none; }
  .demand-chart[data-mode='fixed'] [data-plan='fixed'],
  .demand-chart[data-mode='manual'] [data-plan='manual'],
  .demand-chart[data-mode='elastic'] [data-plan='elastic'] { display: revert; }
  .demand-chart div[data-plan] { display: none; }
  .demand-chart[data-mode='fixed'] div[data-plan='fixed'],
  .demand-chart[data-mode='manual'] div[data-plan='manual'],
  .demand-chart[data-mode='elastic'] div[data-plan='elastic'] { display: grid; }
</style>
<script>
  document.querySelectorAll<HTMLElement>('.demand-chart').forEach((fig) => {
    fig.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type === 'radio') fig.dataset.mode = t.value;
    });
  });
</script>
