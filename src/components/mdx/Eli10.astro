---
import Mascot from '../Mascot.astro';
interface Props { title?: string }
const { title = 'Explain it like I am 10' } = Astro.props;
---
<aside data-speakable class="eli10 flex flex-col gap-4 rounded-lg border-l-[5px] border-[var(--ok)] bg-[var(--pastel-green)] p-5 sm:flex-row sm:items-start" aria-label={title}>
  <Mascot size={72} class="shrink-0" />
  <div class="min-w-0 space-y-3 text-[1.05rem] leading-relaxed">
    <p class="flex items-center gap-3 text-sm font-bold verdict-ok">Nimbus explains 👋 <button type="button" class="speak-btn" aria-label="Listen to Nimbus">🔊 Listen</button></p>
    <slot />
  </div>
</aside>
