---
/** Section F: when to use, when to avoid, and what else to consider. */
interface Props { use: string[]; avoid: string[]; alternatives?: string[] }
const { use, avoid, alternatives = [] } = Astro.props;
---
<div class="grid gap-4 md:grid-cols-2">
  <div class="card p-5">
    <p class="font-semibold verdict-ok">✓ Use it when…</p>
    <ul class="mt-3 space-y-2 text-[0.95rem] leading-relaxed">{use.map((u) => <li class="flex gap-2"><span aria-hidden="true" class="verdict-ok">•</span><span set:html={u} /></li>)}</ul>
  </div>
  <div class="card p-5">
    <p class="font-semibold verdict-bad">✕ Think twice when…</p>
    <ul class="mt-3 space-y-2 text-[0.95rem] leading-relaxed">{avoid.map((u) => <li class="flex gap-2"><span aria-hidden="true" class="verdict-bad">•</span><span set:html={u} /></li>)}</ul>
  </div>
  {alternatives.length > 0 && (
    <div class="card p-5 md:col-span-2">
      <p class="font-semibold text-accent">↔ Alternatives to consider</p>
      <ul class="mt-3 space-y-2 text-[0.95rem] leading-relaxed">{alternatives.map((u) => <li class="flex gap-2"><span aria-hidden="true" class="text-accent">•</span><span set:html={u} /></li>)}</ul>
    </div>
  )}
</div>
