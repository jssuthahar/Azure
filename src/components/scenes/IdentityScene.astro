---
/** Identity scene. variant: entra | mfa | external | conditional | rbac | zerotrust */
interface Props { variant?: 'entra' | 'mfa' | 'external' | 'conditional' | 'rbac' | 'zerotrust' }
const { variant = 'entra' } = Astro.props;
const person = (x: number, y: number, c = '#ffb900', b = '#ca5010') => `<g transform="translate(${x} ${y})"><circle cx="22" cy="16" r="14" fill="${c}"/><path d="M0 64c0-18 10-28 22-28s22 10 22 28z" fill="${b}"/></g>`;
const app = (x: number, y: number, icon: string, label: string) => `<g transform="translate(${x} ${y})"><rect width="92" height="50" rx="10" fill="var(--card)" stroke="#0078d4" stroke-width="2"/><text x="22" y="32" font-size="20">${icon}</text><text x="40" y="31" font-size="11" font-weight="700" fill="var(--text)">${label}</text></g>`;
const entra = `<g transform="translate(250 105)"><rect width="140" height="90" rx="16" fill="#0078d4"/><text x="70" y="40" text-anchor="middle" font-size="26">🪪</text><text x="70" y="68" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">Microsoft Entra ID</text></g>`;
---
{variant === 'entra' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="A user signs in once to Microsoft Entra ID and can then open many apps, such as Outlook, Teams, the Azure portal and a custom app, without signing in again.">
    <g set:html={person(40, 110) + entra + app(500, 30, '📧', 'Outlook') + app(500, 95, '💬', 'Teams') + app(500, 160, '☁️', 'Azure') + app(500, 225, '🛒', 'Shop app')} />
    <path id="en-in" d="M90 150 H250" fill="none" stroke="#0078d4" stroke-width="3" class="a-dash" />
    <circle r="7" fill="#ffb900"><animateMotion dur="1.6s" repeatCount="indefinite"><mpath href="#en-in" /></animateMotion></circle>
    {[55, 120, 185, 250].map((y, k) => <><path id={`en-o${k}`} d={`M390 150 C 440 150, 450 ${y}, 500 ${y}`} fill="none" stroke="#107c10" stroke-width="2.5" opacity=".6" /><circle r="5" fill="#107c10"><animateMotion dur="1.6s" begin={`-${k * 0.3}s`} repeatCount="indefinite"><mpath href={`#en-o${k}`} /></animateMotion></circle></>)}
    <text x="62" y="210" text-anchor="middle" class="lbl">You</text>
    <text x="170" y="138" text-anchor="middle" class="sub">sign in once</text>
    <text x="320" y="230" text-anchor="middle" class="lbl">Single sign-on: one identity, many apps</text>
  </svg>
)}
{variant === 'mfa' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Multifactor authentication combines something you know (a password), something you have (your phone) and something you are (your fingerprint or face).">
    {[
      ['🔑', 'Something you know', 'password or PIN', '#0078d4'],
      ['📱', 'Something you have', 'phone, security key', '#107c10'],
      ['👆', 'Something you are', 'fingerprint, face', '#8764b8'],
    ].map(([i, t, d, c], k) => (
      <g transform={`translate(${40 + k * 195} 40)`} class="mfa-step" style={`animation-delay:${k * 0.8}s`}>
        <rect width="170" height="150" rx="16" fill="var(--card)" stroke={c} stroke-width="3" />
        <text x="85" y="62" text-anchor="middle" font-size="44">{i}</text>
        <text x="85" y="100" text-anchor="middle" class="lbl">{t}</text>
        <text x="85" y="122" text-anchor="middle" class="sub">{d}</text>
      </g>
    ))}
    <g class="mfa-ok" transform="translate(220 212)"><rect width="200" height="50" rx="25" fill="#107c10" /><text x="100" y="32" text-anchor="middle" fill="#fff" font-size="15" font-weight="700">✓ Signed in safely</text></g>
    <text x="320" y="290" text-anchor="middle" class="sub">MFA = two or more of these. A stolen password alone is not enough.</text>
  </svg>
)}
{variant === 'external' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="A partner company's consultant signs in with their own work account and gets guest access to one of your apps. Customers sign in to your public app with their own accounts.">
    <rect x="300" y="30" width="320" height="230" rx="16" fill="none" stroke="#0078d4" stroke-width="2" stroke-dasharray="6 5" /><text x="316" y="54" class="lbl" fill="#0078d4">Your organisation</text>
    <g set:html={entra.replace('translate(250 105)', 'translate(330 105)') + app(510, 70, '📊', 'Project') + app(510, 170, '🛒', 'Shop')} />
    <g set:html={person(40, 50, '#8fcbf7', '#8764b8') + person(40, 170, '#ffd75e', '#107c10')} />
    <text x="62" y="140" text-anchor="middle" class="sub">Partner (B2B guest)</text>
    <text x="62" y="260" text-anchor="middle" class="sub">Customer</text>
    <path id="ex1" d="M90 85 C 200 85, 250 140, 330 145" fill="none" stroke="#8764b8" stroke-width="2.5" class="a-dash" />
    <path id="ex2" d="M90 205 C 200 205, 250 170, 330 165" fill="none" stroke="#107c10" stroke-width="2.5" class="a-dash" />
    <circle r="6" fill="#8764b8"><animateMotion dur="2s" repeatCount="indefinite"><mpath href="#ex1" /></animateMotion></circle>
    <circle r="6" fill="#107c10"><animateMotion dur="2s" begin="-1s" repeatCount="indefinite"><mpath href="#ex2" /></animateMotion></circle>
    <text x="200" y="285" text-anchor="middle" class="sub">They use their own accounts. You control what they can reach.</text>
  </svg>
)}
{variant === 'conditional' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Conditional Access checks signals such as who the user is, where they are, which device and which app, then decides: allow, require MFA, or block.">
    {[['👤', 'Who'], ['📍', 'Where'], ['💻', 'Device'], ['🧩', 'App'], ['⚠️', 'Risk']].map(([i, t], k) => (
      <g transform={`translate(20 ${20 + k * 52})`}><rect width="120" height="42" rx="10" fill="var(--card)" stroke="var(--card-line)" /><text x="14" y="28" font-size="18">{i}</text><text x="44" y="27" class="lbl">{t}</text></g>
    ))}
    {[0, 1, 2, 3, 4].map((k) => <path d={`M140 ${41 + k * 52} C 200 ${41 + k * 52}, 210 150, 250 150`} fill="none" stroke="#8a97a8" stroke-width="2" class="a-dash" />)}
    <g transform="translate(250 100)"><g class="a-pulse"><rect width="140" height="100" rx="18" fill="#0078d4" /><text x="70" y="44" text-anchor="middle" font-size="26">🚦</text><text x="70" y="74" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">Conditional Access</text></g></g>
    {[['✅', 'Allow', '#107c10', 50], ['📱', 'Require MFA', '#c19c00', 130], ['⛔', 'Block', '#e74856', 210]].map(([i, t, c, y], k) => (
      <g><path d={`M390 150 C 430 150, 440 ${Number(y) + 20}, 470 ${Number(y) + 20}`} fill="none" stroke={c} stroke-width="2.5" class="ca-out" style={`animation-delay:${k * 1.2}s`} />
      <g transform={`translate(470 ${y})`} class="ca-out" style={`animation-delay:${k * 1.2}s`}><rect width="150" height="40" rx="10" fill={c} /><text x="18" y="26" font-size="16">{i}</text><text x="44" y="26" fill="#fff" font-size="13" font-weight="700">{t}</text></g></g>
    ))}
    <text x="320" y="290" text-anchor="middle" class="sub">If these signals… then this decision.</text>
  </svg>
)}
{variant === 'rbac' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Azure role-based access control: a role assignment combines a security principal (who), a role definition (what they can do) and a scope (where).">
    {[['👤', 'Who', 'security principal', 'user, group, app', '#ffb900'], ['📜', 'What', 'role definition', 'Owner, Contributor, Reader', '#0078d4'], ['📦', 'Where', 'scope', 'MG, subscription, RG, resource', '#107c10']].map(([i, t, s, d, c], k) => (
      <g transform={`translate(${30 + k * 200} 40)`} class={`a-float${k === 1 ? '-2' : k === 2 ? '-3' : ''}`}>
        <rect width="180" height="150" rx="16" fill="var(--card)" stroke={c} stroke-width="3" />
        <text x="90" y="54" text-anchor="middle" font-size="36">{i}</text>
        <text x="90" y="88" text-anchor="middle" class="lbl">{t}</text>
        <text x="90" y="108" text-anchor="middle" class="sub">{s}</text>
        <text x="90" y="128" text-anchor="middle" class="sub">{d}</text>
      </g>
    ))}
    <text x="215" y="120" font-size="26" fill="var(--text-muted)">+</text><text x="415" y="120" font-size="26" fill="var(--text-muted)">+</text>
    <g transform="translate(170 214)"><g class="a-pulse"><rect width="300" height="46" rx="23" fill="#243a5e" /><text x="150" y="29" text-anchor="middle" fill="#fff" font-size="14" font-weight="700">= Role assignment 🔐</text></g></g>
  </svg>
)}
{variant === 'zerotrust' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Zero Trust: every request is checked, whether it comes from inside or outside the network. Verify explicitly, use least privilege, and assume breach.">
    <g set:html={person(30, 60) + person(30, 170, '#8fcbf7', '#243a5e')} />
    <text x="52" y="150" text-anchor="middle" class="sub">at home</text><text x="52" y="258" text-anchor="middle" class="sub">in the office</text>
    <g transform="translate(240 70)"><rect width="140" height="150" rx="18" fill="#0078d4" /><text x="70" y="50" text-anchor="middle" font-size="30">🕵️</text><text x="70" y="82" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">Check EVERY</text><text x="70" y="100" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">request</text><text x="70" y="126" text-anchor="middle" fill="#cfe6fb" font-size="10">identity · device · risk</text></g>
    <path id="zt1" d="M80 95 C 160 95, 180 130, 240 130" fill="none" stroke="#ffb900" stroke-width="2.5" class="a-dash" />
    <path id="zt2" d="M80 205 C 160 205, 180 170, 240 170" fill="none" stroke="#8fcbf7" stroke-width="2.5" class="a-dash" />
    <circle r="6" fill="#ffb900"><animateMotion dur="2s" repeatCount="indefinite"><mpath href="#zt1" /></animateMotion></circle>
    <circle r="6" fill="#8fcbf7"><animateMotion dur="2s" begin="-1s" repeatCount="indefinite"><mpath href="#zt2" /></animateMotion></circle>
    {[['✔️ Verify explicitly', 60], ['🔑 Least privilege', 125], ['🚨 Assume breach', 190]].map(([t, y]) => (
      <g transform={`translate(430 ${y})`}><rect width="190" height="44" rx="12" fill="var(--card)" stroke="#0078d4" stroke-width="2" /><text x="95" y="28" text-anchor="middle" class="lbl">{t}</text></g>
    ))}
    <text x="320" y="285" text-anchor="middle" class="sub">“Never trust, always verify”, even inside the office network.</text>
  </svg>
)}
<style>
  .mfa-step { animation: mfa-in 3.6s infinite; }
  @keyframes mfa-in { 0% { opacity: 0.25; translate: 0 8px; } 20%, 90% { opacity: 1; translate: 0 0; } 100% { opacity: 0.25; } }
  .mfa-ok { animation: mfa-ok 3.6s infinite; }
  @keyframes mfa-ok { 0%, 55% { opacity: 0; } 65%, 92% { opacity: 1; } 100% { opacity: 0; } }
  .ca-out { animation: ca-out 3.6s infinite; opacity: 0.2; }
  @keyframes ca-out { 0%, 100% { opacity: 0.2; } 15%, 35% { opacity: 1; } }
</style>
