---
/** Public (apartment block), private (house with a lock), hybrid (house linked to the cloud). */
interface Props { highlight?: 'public' | 'private' | 'hybrid' }
const { highlight } = Astro.props;
const op = (k: string) => (!highlight || highlight === k ? 1 : 0.32);
const windows = Array.from({ length: 15 }, (_, i) => ({ x: 56 + (i % 3) * 30, y: 92 + Math.floor(i / 3) * 30, d: ((i * 7) % 11) * 0.3 }));
---
<svg viewBox="0 0 640 300" role="img" aria-label="Three cloud models: public cloud is like an apartment block shared by many, private cloud is like your own house with a lock, hybrid cloud connects your house to the cloud">
  <!-- public -->
  <g opacity={op('public')}>
    {highlight === 'public' && <rect x="20" y="40" width="190" height="230" rx="16" fill="#0078d4" opacity=".08" />}
    <rect x="40" y="76" width="110" height="170" rx="6" fill="#3a6ea5" />
    {windows.map((w) => <rect x={w.x} y={w.y} width="18" height="18" rx="2" fill="#ffd75e" class="a-blink" style={`animation-delay:-${w.d}s`} />)}
    <g class="a-float"><path d="M150 96h46a18 18 0 0 0 2-35.8A27 27 0 0 0 151 58a21 21 0 0 0-1 38z" fill="#fff" stroke="#0078d4" stroke-width="2.5" /></g>
    <text x="115" y="272" text-anchor="middle" class="lbl">Public cloud</text>
    <text x="115" y="290" text-anchor="middle" class="sub">shared by many, pay as you go</text>
  </g>
  <!-- private -->
  <g opacity={op('private')}>
    {highlight === 'private' && <rect x="225" y="40" width="190" height="230" rx="16" fill="#0078d4" opacity=".08" />}
    <path d="M250 140l70-56 70 56z" fill="#c50f1f" />
    <rect x="262" y="138" width="116" height="100" fill="#fff4c2" stroke="#8a5300" stroke-width="2" />
    <rect x="306" y="186" width="28" height="52" rx="3" fill="#8a5300" />
    <path d="M240 246h160" stroke="#8a5300" stroke-width="3" />
    {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <rect x={242 + i * 18} y="222" width="5" height="26" fill="#c19c00" />)}
    <g class="a-pulse"><rect x="353" y="160" width="22" height="18" rx="3" fill="#107c10" /><path d="M357 160v-6a7 7 0 0 1 14 0v6" fill="none" stroke="#107c10" stroke-width="3" /></g>
    <text x="320" y="272" text-anchor="middle" class="lbl">Private cloud</text>
    <text x="320" y="290" text-anchor="middle" class="sub">just for one organisation</text>
  </g>
  <!-- hybrid -->
  <g opacity={op('hybrid')}>
    {highlight === 'hybrid' && <rect x="430" y="40" width="195" height="230" rx="16" fill="#0078d4" opacity=".08" />}
    <path d="M445 190l36-30 36 30z" fill="#c50f1f" /><rect x="452" y="188" width="58" height="50" fill="#fff4c2" stroke="#8a5300" stroke-width="2" />
    <g class="a-float"><path d="M548 120h50a20 20 0 0 0 2-39.8A30 30 0 0 0 551 76a24 24 0 0 0-3 44z" fill="#fff" stroke="#0078d4" stroke-width="2.5" /></g>
    <path id="hy-link" d="M500 180 Q540 120 560 122" fill="none" stroke="#0078d4" stroke-width="3" class="a-dash" />
    <circle r="5" fill="#ffb900"><animateMotion dur="2s" repeatCount="indefinite"><mpath href="#hy-link" /></animateMotion></circle>
    <circle r="5" fill="#6ccb5f"><animateMotion dur="2s" begin="-1s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#hy-link" /></animateMotion></circle>
    <text x="528" y="272" text-anchor="middle" class="lbl">Hybrid cloud</text>
    <text x="528" y="290" text-anchor="middle" class="sub">both, securely connected</text>
  </g>
</svg>
