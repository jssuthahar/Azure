---
/** Users arrive and leave; servers appear and disappear automatically to match. */
const N = 8, S = 4;
// demand rises 0→8 (0–40%), holds (40–55%), falls back (55–100%)
const up = (i: number) => (40 * i) / N;
const down = (i: number) => 55 + (45 * (N - i)) / N;
const kf = (name: string, a: number, b: number) =>
  `@keyframes ${name}{0%,${Math.max(0, a - 0.1).toFixed(1)}%{opacity:0;transform:scale(.4)}${a.toFixed(1)}%,${b.toFixed(1)}%{opacity:1;transform:scale(1)}${Math.min(100, b + 0.1).toFixed(1)}%,100%{opacity:0;transform:scale(.4)}}`;
const css = [
  ...Array.from({ length: N }, (_, k) => kf(`el-u${k}`, up(k + 1), down(k + 1))),
  ...Array.from({ length: S }, (_, k) => kf(`el-s${k}`, up(2 * k + 1) + 3, down(2 * k + 1) + 3)),
  ...Array.from({ length: N }, (_, k) => `.el-u${k}{animation:el-u${k} 9s infinite;transform-box:fill-box;transform-origin:50% 100%}`),
  ...Array.from({ length: S }, (_, k) => `.el-s${k}{animation:el-s${k} 9s infinite;transform-box:fill-box;transform-origin:50% 100%}`),
].join('\n');
---
<svg viewBox="0 0 640 300" role="img" aria-label="As more users arrive, Azure adds servers automatically. When users leave, the extra servers are removed, so you stop paying for them.">
  <style set:html={`@media (prefers-reduced-motion: no-preference){${css}}`} />
  <text x="40" y="40" class="lbl">👥 Users</text>
  {Array.from({ length: N }, (_, k) => (
    <g transform={`translate(${70 + k * 66} 60)`}><g class={`el-u${k}`}><circle cx="16" cy="12" r="11" fill="#ffb900" /><path d="M0 50c0-14 7-22 16-22s16 8 16 22z" fill="#ca5010" /></g></g>
  ))}
  <path d="M40 140H600" stroke="var(--border)" stroke-dasharray="4 6" />
  <text x="320" y="160" text-anchor="middle" class="sub">⚡ autoscale watches demand</text>
  <text x="40" y="190" class="lbl">🖥️ Servers</text>
  {Array.from({ length: S }, (_, k) => (
    <g transform={`translate(${140 + k * 110} 200)`}><g class={`el-s${k}`}><rect width="70" height="80" rx="8" fill="#0078d4" /><rect x="10" y="12" width="50" height="9" rx="3" fill="#9fd0f7" /><rect x="10" y="28" width="50" height="9" rx="3" fill="#9fd0f7" /><circle cx="56" cy="66" r="4" fill="#6ccb5f" /></g></g>
  ))}
</svg>
