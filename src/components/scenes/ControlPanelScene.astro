---
/** Manageability: a dashboard with live charts, a terminal typing a command, a server healing itself. */
---
<svg viewBox="0 0 640 300" role="img" aria-label="A management dashboard shows live charts, a terminal runs an Azure CLI command, and a failed server is replaced automatically.">
  <rect x="30" y="20" width="360" height="200" rx="14" fill="#243a5e" />
  <rect x="44" y="34" width="332" height="172" rx="8" fill="#0f1a2b" />
  <text x="58" y="56" fill="#9fd0f7" font-size="12" font-weight="700">Azure portal · dashboard</text>
  {[0, 1, 2, 3, 4, 5].map((i) => (
    <rect x={64 + i * 30} y="90" width="18" height="90" rx="3" fill="#0078d4" style={`transform-box:fill-box;transform-origin:50% 100%;animation:cp-bar 2.4s ease-in-out ${i * 0.25}s infinite`} />
  ))}
  <g transform="translate(300 140)"><circle r="44" fill="none" stroke="#465a7a" stroke-width="10" /><path d="M-44 0a44 44 0 0 1 88 0" fill="none" stroke="#6ccb5f" stroke-width="10" /><g class="cp-needle"><path d="M0 0L0-36" stroke="#ffd75e" stroke-width="4" stroke-linecap="round" /></g><circle r="5" fill="#ffd75e" /><text y="30" text-anchor="middle" fill="#9fd0f7" font-size="10">health</text></g>
  <!-- terminal -->
  <rect x="30" y="232" width="360" height="54" rx="10" fill="#0b1020" />
  <text x="46" y="264" fill="#6ccb5f" font-size="14" font-family="ui-monospace, monospace">$</text>
  <clipPath id="cp-clip"><rect x="62" y="248" width="240" height="24" class="cp-type" /></clipPath>
  <text x="62" y="264" fill="#fff" font-size="14" font-family="ui-monospace, monospace" clip-path="url(#cp-clip)">az vm create --name web01</text>
  <!-- self-healing server -->
  <g transform="translate(450 70)">
    <rect width="130" height="150" rx="14" fill="var(--card)" stroke="var(--card-line)" stroke-width="2" />
    <rect x="35" y="22" width="60" height="80" rx="8" class="cp-srv" />
    <circle cx="82" cy="34" r="5" class="cp-led" />
    <text x="65" y="128" text-anchor="middle" class="sub cp-bad">failed… replacing</text>
    <text x="65" y="128" text-anchor="middle" class="sub cp-good">✓ auto-healed</text>
  </g>
  <text x="515" y="250" text-anchor="middle" class="lbl">Fixes itself</text>
</svg>
<style>
  @keyframes cp-bar { 50% { transform: scaleY(0.45); } }
  .cp-needle { animation: cp-needle 3s ease-in-out infinite; transform-origin: 0 0; }
  @keyframes cp-needle { 0%, 100% { transform: rotate(-50deg); } 50% { transform: rotate(55deg); } }
  .cp-type { animation: cp-type 5s steps(26) infinite; }
  @keyframes cp-type { 0% { width: 0; } 60%, 100% { width: 240px; } }
  .cp-srv { animation: cp-srv 6s infinite; }
  @keyframes cp-srv { 0%, 30% { fill: #e74856; } 40%, 100% { fill: #0078d4; } }
  .cp-led { animation: cp-led 6s infinite; }
  @keyframes cp-led { 0%, 30% { fill: #ffd75e; } 40%, 100% { fill: #6ccb5f; } }
  .cp-bad { animation: cp-bad 6s infinite; }
  .cp-good { animation: cp-good 6s infinite; }
  @keyframes cp-bad { 0%, 30% { opacity: 1; } 36%, 100% { opacity: 0; } }
  @keyframes cp-good { 0%, 34% { opacity: 0; } 40%, 100% { opacity: 1; } }
</style>
