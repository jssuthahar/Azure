---
/** Azure Storage scene: variant = services | tiers | redundancy | move | databases */
interface Props { variant?: 'services' | 'tiers' | 'redundancy' | 'move' | 'databases' }
const { variant = 'services' } = Astro.props;
---
{variant === 'services' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="A storage account holds four services: blobs for files like photos, Azure Files for shared folders, queues for messages, and tables for structured data. Managed disks attach to virtual machines.">
    <rect x="20" y="30" width="470" height="240" rx="18" fill="none" stroke="#0078d4" stroke-width="2.5" />
    <text x="40" y="56" class="lbl" fill="#0078d4">🗄️ Storage account: stlearn0412</text>
    {[
      ['🖼️', 'Blobs', 'photos, videos, backups', '#0078d4'],
      ['📁', 'Files', 'shared folders (SMB/NFS)', '#107c10'],
      ['✉️', 'Queues', 'messages between apps', '#ca5010'],
      ['🧾', 'Tables', 'NoSQL key/value data', '#8764b8'],
    ].map(([i, t, d, c], k) => (
      <g transform={`translate(${40 + k * 112} 76)`} class={`a-float${k % 2 ? '-2' : ''}`}>
        <rect width="100" height="170" rx="12" fill="var(--card)" stroke={c} stroke-width="2" />
        <text x="50" y="48" text-anchor="middle" font-size="32">{i}</text>
        <text x="50" y="86" text-anchor="middle" class="lbl">{t}</text>
        <foreignObject x="6" y="96" width="88" height="60"><p xmlns="http://www.w3.org/1999/xhtml" style="font-size:11px;text-align:center;color:var(--text-muted);margin:0;line-height:1.3">{d}</p></foreignObject>
      </g>
    ))}
    <g transform="translate(515 70)"><rect width="100" height="70" rx="10" fill="#243a5e" /><text x="50" y="30" text-anchor="middle" font-size="22">🖥️</text><text x="50" y="56" text-anchor="middle" fill="#fff" font-size="11">VM</text></g>
    <path d="M565 140v40" stroke="#8a97a8" stroke-width="3" class="a-dash" />
    <g transform="translate(515 182)"><rect width="100" height="70" rx="10" fill="var(--card)" stroke="#0099bc" stroke-width="2" /><text x="50" y="32" text-anchor="middle" font-size="24">💽</text><text x="50" y="56" text-anchor="middle" class="sub">Managed disk</text></g>
  </svg>
)}
{variant === 'tiers' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Blob access tiers from hot to archive. Hot data is used often and costs more to store; archive data is rarely used, cheapest to store, and must be rehydrated before reading.">
    <defs><linearGradient id="st-th" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#e74856" /><stop offset=".35" stop-color="#ffb900" /><stop offset=".7" stop-color="#50e6ff" /><stop offset="1" stop-color="#5b6f8f" /></linearGradient></defs>
    <rect x="40" y="130" width="560" height="22" rx="11" fill="url(#st-th)" />
    {[
      ['🔥 Hot', 'used every day', 'store $$$$ · read $', 40],
      ['🌤️ Cool', 'kept 30+ days', 'store $$$ · read $$', 190],
      ['❄️ Cold', 'kept 90+ days', 'store $$ · read $$$', 340],
      ['🧊 Archive', '180+ days, offline', 'store $ · read $$$$', 490],
    ].map(([t, d, c, x], k) => (
      <g transform={`translate(${x} 40)`}>
        <rect width="110" height="76" rx="12" fill="var(--card)" stroke="var(--card-line)" />
        <text x="55" y="26" text-anchor="middle" class="lbl">{t}</text>
        <text x="55" y="46" text-anchor="middle" class="sub">{d}</text>
        <text x="55" y="64" text-anchor="middle" class="sub">{c}</text>
      </g>
    ))}
    <g><animateMotion dur="7s" repeatCount="indefinite" path="M90 141 H 545" /><circle r="16" fill="#fff" stroke="#0078d4" stroke-width="3" /><text y="5" text-anchor="middle" font-size="14">📄</text></g>
    <text x="320" y="200" text-anchor="middle" class="lbl">As data gets older and less used, move it to a cooler tier to save money</text>
    <text x="320" y="224" text-anchor="middle" class="sub">Lifecycle management rules can move blobs automatically</text>
    <g transform="translate(470 245)"><rect width="150" height="34" rx="8" fill="var(--pastel-yellow)" /><text x="75" y="22" text-anchor="middle" font-size="11" font-weight="700" fill="#8a5300">⏳ Archive: rehydrate first</text></g>
  </svg>
)}
{variant === 'redundancy' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Storage redundancy: LRS keeps three copies in one datacenter, ZRS keeps copies across three zones, GRS adds copies in a second region, and GZRS combines zones and a second region.">
    <rect x="20" y="40" width="380" height="200" rx="16" fill="none" stroke="#0078d4" stroke-width="2" stroke-dasharray="6 5" /><text x="34" y="62" class="lbl" fill="#0078d4">Primary region</text>
    {[0, 1, 2].map((z) => (
      <g transform={`translate(${40 + z * 120} 76)`}>
        <rect width="104" height="140" rx="10" fill="var(--card)" stroke="var(--card-line)" />
        <text x="52" y="20" text-anchor="middle" class="sub">Zone {z + 1}</text>
        {[0, 1, 2].map((c) => <rect x="14" y={32 + c * 34} width="76" height="26" rx="6" fill="#0078d4" class={z === 0 ? '' : 'rd-zrs'} style={z === 0 ? '' : `animation-delay:${z * 0.3}s`} />)}
      </g>
    ))}
    <rect x="430" y="76" width="190" height="140" rx="16" fill="none" stroke="#107c10" stroke-width="2" stroke-dasharray="6 5" /><text x="444" y="98" class="lbl" fill="#107c10">Secondary region</text>
    {[0, 1, 2].map((c) => <rect x="470" y={110 + c * 32} width="110" height="24" rx="6" fill="#107c10" class="rd-geo" style={`animation-delay:${c * 0.2}s`} />)}
    <path d="M400 150 H430" stroke="#107c10" stroke-width="3" class="a-dash" />
    <g transform="translate(20 252)" font-size="12" font-weight="700">
      <text x="0" y="16" fill="#0078d4">LRS: 3 copies, 1 datacenter</text>
      <text x="200" y="16" fill="#0078d4">ZRS: across 3 zones</text>
      <text x="360" y="16" fill="#107c10">GRS / GZRS: + another region</text>
    </g>
  </svg>
)}
{variant === 'move' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Ways to move data to Azure: AzCopy on the command line, Storage Explorer with a graphical interface, Azure File Sync for file servers, Azure Migrate for whole servers, and Data Box for huge amounts by courier.">
    <g transform="translate(20 110)"><rect width="110" height="90" rx="12" fill="var(--card)" stroke="#8a97a8" stroke-width="2" /><text x="55" y="44" text-anchor="middle" font-size="30">🏢</text><text x="55" y="76" text-anchor="middle" class="lbl">On-premises</text></g>
    <g class="a-float" transform="translate(510 100)"><path d="M0 70h90a28 28 0 0 0 3-55.8A40 40 0 0 0 20 8a32 32 0 0 0-20 62z" fill="#eaf4fe" stroke="#0078d4" stroke-width="3" /><text x="48" y="54" text-anchor="middle" class="lbl">Azure</text></g>
    {[
      ['⌨️ AzCopy', 'command line', 40],
      ['🖱️ Storage Explorer', 'desktop app', 100],
      ['🔄 Azure File Sync', 'keep file servers in sync', 160],
      ['🚚 Azure Migrate', 'whole servers and apps', 220],
    ].map(([t, d, y], k) => (
      <g>
        <path id={`mv${k}`} d={`M130 155 C 220 ${y}, 380 ${y}, 510 140`} fill="none" stroke="#0078d4" stroke-width="2" opacity=".35" />
        <circle r="5" fill="#ffb900"><animateMotion dur={`${2 + k * 0.4}s`} repeatCount="indefinite"><mpath href={`#mv${k}`} /></animateMotion></circle>
        <g transform={`translate(250 ${y - 18})`}><rect width="150" height="32" rx="8" fill="var(--card)" stroke="var(--card-line)" /><text x="75" y="14" text-anchor="middle" font-size="11" font-weight="700" fill="var(--text)">{t}</text><text x="75" y="27" text-anchor="middle" class="sub">{d}</text></g>
      </g>
    ))}
    <g transform="translate(200 250)"><rect width="240" height="40" rx="10" fill="var(--pastel-yellow)" /><text x="120" y="25" text-anchor="middle" font-size="12" font-weight="700" fill="#8a5300">📦 Too much data? Azure Data Box by courier</text></g>
    <g><animateMotion dur="5s" repeatCount="indefinite" path="M130 200 C 260 300, 420 300, 540 175" /><text font-size="20">🚚</text></g>
  </svg>
)}
{variant === 'databases' && (
  <svg viewBox="0 0 640 300" role="img" aria-label="Azure database choices from most control to most managed: SQL Server on a VM, Azure SQL Managed Instance, Azure SQL Database, and Azure Cosmos DB for global NoSQL.">
    {[
      ['🖥️', 'SQL Server on VM', 'IaaS: full control', '#5b6f8f'],
      ['🏢', 'SQL Managed Instance', 'PaaS: near 100% SQL Server', '#2b8ddf'],
      ['☁️', 'Azure SQL Database', 'PaaS: fully managed', '#0078d4'],
      ['🌍', 'Azure Cosmos DB', 'NoSQL, global, fast', '#107c10'],
    ].map(([i, t, d, c], k) => (
      <g transform={`translate(${24 + k * 152} 60)`} class={`a-float${k % 2 ? '-2' : ''}`}>
        <rect width="136" height="170" rx="14" fill="var(--card)" stroke={c} stroke-width="2.5" />
        <ellipse cx="68" cy="40" rx="34" ry="10" fill={c} /><rect x="34" y="40" width="68" height="46" fill={c} /><ellipse cx="68" cy="86" rx="34" ry="10" fill={c} />
        <text x="68" y="72" text-anchor="middle" font-size="22">{i}</text>
        <text x="68" y="122" text-anchor="middle" font-size="12" font-weight="700" fill="var(--text)">{t}</text>
        <text x="68" y="142" text-anchor="middle" class="sub">{d}</text>
      </g>
    ))}
    <path d="M40 262 H600" stroke="#8a97a8" stroke-width="2" marker-end="url(#db-ar)" />
    <defs><marker id="db-ar" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0 0L10 5L0 10z" fill="#8a97a8" /></marker></defs>
    <text x="40" y="285" class="sub">More control</text><text x="600" y="285" text-anchor="end" class="sub">Less management</text>
  </svg>
)}
<style>
  .rd-zrs { animation: rd-copy 4s infinite; }
  .rd-geo { animation: rd-copy 4s 1s infinite; }
  @keyframes rd-copy { 0%, 15% { opacity: 0.15; } 35%, 90% { opacity: 1; } 100% { opacity: 0.15; } }
</style>
