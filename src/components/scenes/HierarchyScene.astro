---
/** Management groups → subscriptions → resource groups → resources; a policy flows down. */
const sub = (x: number, label: string) => `<g transform="translate(${x} 128)"><rect width="120" height="38" rx="8" fill="#ffd75e"/><text x="60" y="24" text-anchor="middle" font-size="12" font-weight="700" fill="#0b1020">🔑 ${label}</text></g>`;
const rg = (x: number, label: string) => `<g transform="translate(${x} 200)"><rect width="100" height="32" rx="8" fill="#9fd0f7"/><text x="50" y="21" text-anchor="middle" font-size="11" font-weight="700" fill="#0b1020">📦 ${label}</text></g>`;
---
<svg viewBox="0 0 640 300" role="img" aria-label="The Azure hierarchy: management groups contain subscriptions, subscriptions contain resource groups, and resource groups contain resources. A policy set at the top flows down to everything below.">
  <g transform="translate(240 20)"><rect width="160" height="40" rx="10" fill="#0078d4" /><text x="80" y="25" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">🏢 Root management group</text></g>
  <g transform="translate(130 74)"><rect width="140" height="36" rx="10" fill="#2b8ddf" /><text x="70" y="23" text-anchor="middle" fill="#fff" font-size="11" font-weight="700">📁 MG: Production</text></g>
  <g transform="translate(370 74)"><rect width="140" height="36" rx="10" fill="#2b8ddf" /><text x="70" y="23" text-anchor="middle" fill="#fff" font-size="11" font-weight="700">📁 MG: Development</text></g>
  <g stroke="#8a97a8" stroke-width="2" fill="none"><path d="M320 60v8H200v6M320 68h120v6" /><path d="M200 110v10H120v8M200 120h60v8M440 110v18" /><path d="M120 166v10H85v24M120 176h65v24M440 166v34" /></g>
  <g set:html={sub(60, 'Sub: Web') + sub(200, 'Sub: Data') + sub(380, 'Sub: Dev')} />
  <g set:html={rg(35, 'rg-web') + rg(140, 'rg-api') + rg(390, 'rg-test')} />
  <g font-size="18"><text x="55" y="262">🖥️</text><text x="85" y="262">🗄️</text><text x="160" y="262">🌍</text><text x="410" y="262">🖥️</text><text x="440" y="262">🧪</text></g>
  <text x="560" y="40" class="sub">Policy set here…</text>
  <g class="hs-flow"><circle r="7" fill="#e74856"><animateMotion dur="3s" repeatCount="indefinite" path="M320 40 L200 92 L120 147 L85 216 L70 250" /></circle><circle r="7" fill="#e74856"><animateMotion dur="3s" repeatCount="indefinite" path="M320 40 L440 92 L440 147 L440 216 L425 250" /></circle></g>
  <g transform="translate(520 120)"><rect width="110" height="70" rx="10" fill="var(--card)" stroke="#e74856" stroke-width="2" /><text x="55" y="22" text-anchor="middle" font-size="11" font-weight="700" fill="#e74856">📜 Policy</text><text x="55" y="40" text-anchor="middle" class="sub">is inherited by</text><text x="55" y="56" text-anchor="middle" class="sub">everything below</text></g>
  <text x="20" y="290" class="sub">Management groups → subscriptions → resource groups → resources</text>
</svg>
