---
/**
 * Sign-in dialog: Google, Microsoft, LinkedIn. Opened by any [data-account-signin]
 * element. Providers switched off in AUTH_PROVIDERS show as "Coming soon".
 * Native <dialog>: focus is trapped, Esc closes, the page behind is inert.
 */
import { SITE, AUTH_PROVIDERS } from '../config';
const P = [
  { id: 'google', label: 'Continue with Google', on: AUTH_PROVIDERS.google },
  { id: 'microsoft', label: 'Continue with Microsoft', on: AUTH_PROVIDERS.microsoft },
  { id: 'linkedin', label: 'Continue with LinkedIn', on: AUTH_PROVIDERS.linkedin },
] as const;
---
<dialog id="signin-dlg" class="sid" aria-labelledby="sid-h" aria-describedby="sid-sub">
  <form method="dialog" class="sid-x-form"><button class="sid-x" aria-label="Close" value="close">✕</button></form>
  <div class="sid-brand">
    <img src="/icons/icon-192.png" alt="" width="56" height="56" class="sid-logo" />
    <p class="sid-org">{SITE.brandLine}</p>
  </div>
  <h2 id="sid-h" class="sid-h">Sign in to MSDEVBUILD</h2>
  <p id="sid-sub" class="sid-sub">One account for Azure certifications and the blog: sign in here and you are signed in on both. Your XP, streak, practice deck and certificate stay in sync on every device. Optional: everything works without an account.</p>

  <div class="sid-list">
    {P.map((p) => (
      <button type="button" class={`sid-btn sid-${p.id}`} data-provider={p.id} disabled={!p.on} aria-describedby={p.on ? undefined : `sid-soon-${p.id}`}>
        <span class="sid-ico" aria-hidden="true">
          {p.id === 'google' && <svg viewBox="0 0 48 48" width="20" height="20"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>}
          {p.id === 'microsoft' && <svg viewBox="0 0 21 21" width="18" height="18"><rect x="1" y="1" width="9" height="9" fill="#f25022"/><rect x="11" y="1" width="9" height="9" fill="#7fba00"/><rect x="1" y="11" width="9" height="9" fill="#00a4ef"/><rect x="11" y="11" width="9" height="9" fill="#ffb900"/></svg>}
          {p.id === 'linkedin' && <svg viewBox="0 0 24 24" width="20" height="20"><rect width="24" height="24" rx="4" fill="#0a66c2"/><path fill="#fff" d="M7.1 9.5H4.6V19h2.5V9.5zM5.9 5.2a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM19.4 13.6c0-2.6-1.4-4.3-3.7-4.3-1.3 0-2.2.7-2.6 1.4V9.5h-2.4V19h2.5v-4.7c0-1.2.3-2.4 1.8-2.4 1.5 0 1.5 1.4 1.5 2.5V19h2.5v-5.4z"/></svg>}
        </span>
        <span class="sid-label">{p.label}</span>
        {!p.on && <span class="sid-soon" id={`sid-soon-${p.id}`}>Coming soon</span>}
      </button>
    ))}
  </div>

  <p class="sid-status" id="sid-status" role="status" aria-live="polite"></p>

  <ul class="sid-points">
    <li>We never post anything or email you.</li>
    <li>We only keep your study progress. Delete it any time.</li>
  </ul>
  <p class="sid-legal">By continuing you agree to our <a href="/terms/">Terms</a> and <a href="/privacy/">Privacy Policy</a>.</p>
</dialog>

<script>
  import { signIn } from '../lib/cloud/account';
  import type { AuthProviderId } from '../config';
  const dlg = document.getElementById('signin-dlg') as HTMLDialogElement;
  const status = document.getElementById('sid-status')!;
  const btns = [...dlg.querySelectorAll<HTMLButtonElement>('[data-provider]')];
  const enabled = btns.filter((b) => !b.disabled);
  const busy = (on: boolean, id?: string) => {
    for (const b of enabled) { b.disabled = on; b.classList.toggle('is-busy', on && b.dataset.provider === id); }
  };
  const name: Record<string, string> = { google: 'Google', microsoft: 'Microsoft', linkedin: 'LinkedIn' };
  const MSG: Record<string, string> = {
    'auth/unauthorized-domain': 'Sign-in isn’t switched on for this address yet. Please try again later.',
    'auth/operation-not-allowed': 'This sign-in option isn’t available yet.',
    'auth/network-request-failed': 'You seem to be offline. Connect and try again.',
    'auth/account-exists-with-different-credential': 'You’ve signed in before with a different option. Use that one.',
    'auth/too-many-requests': 'Too many attempts. Wait a minute and try again.',
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest?.('[data-account-signin]');
    if (!t) return;
    e.preventDefault();
    status.textContent = '';
    busy(false);
    if (!dlg.open) dlg.showModal();
  });
  // Click on the backdrop closes it.
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });

  for (const b of enabled) b.addEventListener('click', () => {
    const id = b.dataset.provider as AuthProviderId;
    status.textContent = `Opening ${name[id]}…`;
    busy(true, id);
    void signIn(id);
  });

  window.addEventListener('msdb-auth', (e) => {
    if ((e as CustomEvent).detail && dlg.open) { status.textContent = 'Signed in.'; setTimeout(() => dlg.close(), 400); }
  });
  window.addEventListener('msdb-sync', (e) => {
    const d = (e as CustomEvent).detail as { state: string; code?: string; signin?: boolean };
    if (!dlg.open) return;
    if (d.state === 'idle') { status.textContent = ''; busy(false); }
    else if (d.state === 'error' && d.signin) { status.textContent = MSG[d.code ?? ''] ?? 'Sign-in didn’t work. Please try again.'; busy(false); }
  });
</script>

<style>
  .sid { width: min(400px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); margin: auto; padding: 1.75rem 1.5rem 1.25rem; border: 0; border-radius: 20px; background: var(--card); color: var(--text); box-shadow: 0 30px 80px -20px rgb(0 20 50 / .5); overflow: auto; }
  .sid::backdrop { background: rgb(8 16 32 / .55); backdrop-filter: blur(3px); }
  .sid[open] { animation: sid-in .18s ease-out; }
  @keyframes sid-in { from { opacity: 0; transform: translateY(8px) scale(.98); } }
  @media (prefers-reduced-motion: reduce) { .sid[open] { animation: none; } }
  .sid-x-form { position: absolute; top: .6rem; right: .6rem; }
  .sid-x { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 999px; color: var(--text-muted); font-size: 1rem; }
  .sid-x:hover { background: var(--bg-subtle); color: var(--text); }
  .sid-brand { display: flex; flex-direction: column; align-items: center; gap: .5rem; }
  .sid-logo { width: 56px; height: 56px; border-radius: 14px; box-shadow: 0 6px 18px -6px rgb(0 60 120 / .4); }
  .sid-org { font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--text-muted); }
  .sid-h { margin-top: .9rem; text-align: center; font-size: 1.3rem; font-weight: 800; letter-spacing: -.01em; }
  .sid-sub { margin-top: .4rem; text-align: center; font-size: .9rem; line-height: 1.5; color: var(--text-muted); }
  .sid-list { margin-top: 1.25rem; display: grid; gap: .6rem; }
  .sid-btn { position: relative; display: flex; align-items: center; gap: .75rem; width: 100%; min-height: 48px; padding: 0 1rem; border-radius: 12px; border: 1px solid var(--border); background: var(--card); font-weight: 600; font-size: .95rem; color: var(--text); transition: border-color .15s, background-color .15s, box-shadow .15s; }
  .sid-btn:not(:disabled):hover { border-color: var(--accent); box-shadow: 0 4px 14px -6px rgb(0 60 120 / .35); }
  .sid-btn:focus-visible, .sid-x:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .sid-btn:disabled { cursor: not-allowed; }
  .sid-btn:disabled:not(.is-busy) .sid-ico, .sid-btn:disabled:not(.is-busy) .sid-label { opacity: .55; }
  .sid-ico { display: grid; place-items: center; width: 24px; height: 24px; flex: none; background: #fff; border-radius: 6px; }
  .sid-label { flex: 1; text-align: left; }
  .sid-soon { flex: none; font-size: .7rem; font-weight: 700; padding: .15rem .5rem; border-radius: 999px; background: var(--bg-subtle); color: var(--text-muted); }
  .sid-btn.is-busy::after { content: ''; width: 16px; height: 16px; flex: none; border-radius: 999px; border: 2px solid var(--border); border-top-color: var(--accent); animation: sid-spin .8s linear infinite; }
  @keyframes sid-spin { to { transform: rotate(360deg); } }
  .sid-status { min-height: 1.25rem; margin-top: .75rem; text-align: center; font-size: .85rem; color: var(--text-muted); }
  .sid-points { margin-top: .5rem; display: grid; gap: .3rem; font-size: .8rem; color: var(--text-muted); }
  .sid-points li { display: flex; gap: .4rem; }
  .sid-points li::before { content: '✓'; color: var(--ok); font-weight: 800; }
  .sid-legal { margin-top: .9rem; padding-top: .8rem; border-top: 1px solid var(--border); text-align: center; font-size: .75rem; color: var(--text-muted); }
  .sid-legal a { color: var(--accent-deep); text-decoration: underline; }
</style>
