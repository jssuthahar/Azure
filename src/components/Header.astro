---
import { getNav } from '../lib/learn';
import CurrencySelect from './CurrencySelect.astro';
import { SITE } from '../config';
import { examFromPath } from '../data/exams';
import CertIcon from './course/CertIcon.astro';

interface Props {
  /** 'public' = discovery menus (home, catalogue, about); 'learn' = only the current exam's learning menus. */
  mode?: 'public' | 'learn';
}
const { mode = 'public' } = Astro.props;
const path = Astro.url.pathname;
const exam = examFromPath(path);
const x = `/${exam.slug}`;
const nav = await getNav(exam.slug);
const published = nav.filter((t) => t.published);

/** Top bar: a few grouped menus instead of one long row of links. */
interface Item { label: string; href: string; desc: string; icon: string }
interface Group { label: string; icon: string; items: Item[] }
const PUBLIC: (Group | Item)[] = [
  { label: 'Home', href: '/', desc: '', icon: '🏠' },
  { label: 'Certifications', href: '/certifications/', desc: '', icon: '🎓' },
  { label: 'About', href: '/about/', desc: '', icon: 'ℹ️' },
  { label: 'My Account', href: '/progress/', desc: '', icon: '👤' },
];
// Learning environment: only this exam. Order follows the learner's journey.
const LEARN: (Group | Item)[] = [
  { label: 'Overview', href: `${x}/learn/`, desc: '', icon: '🧭' },
  { label: 'Lessons', icon: '📘', items: [
    { icon: '🗂️', label: 'All lessons', href: `${x}/learn/#curriculum`, desc: `${published.length} lessons in exam order, with your progress` },
    ...exam.modules.map((m) => ({ icon: String(m.domain), label: m.shortTitle, href: `${x}/${m.slug}/`, desc: `Domain ${m.domain} · ${m.weight} of the exam` })),
  ] },
  { label: 'Practice', icon: '🧠', items: [
    { icon: '🧠', label: 'Smart Practice', href: `${x}/practice/`, desc: 'Readiness score, mistakes come back, weak topics' },
    { icon: '📅', label: 'Study Plan', href: `${x}/study-plan/`, desc: 'Day-by-day plan to your exam date, with reminders' },
    { icon: '🃏', label: 'Revision', href: `${x}/revision/`, desc: 'Flashcards and quick notes' },
    { icon: '🎮', label: 'Play & Learn', href: `${x}/games/`, desc: 'Sort It, Match, Lightning Round, Who Am I?' },
    { icon: '🔥', label: 'Daily Challenge', href: `${x}/games/daily/`, desc: '5 questions a day, keep your streak' },
  ] },
  { label: 'Practice Labs', href: `${x}/labs/`, desc: '', icon: '🧪' },
  { label: 'Simulations', href: '/simulator/', desc: '', icon: '⚡' },
  { label: '3D Explorer', href: `${x}/3d-explorer/`, desc: '', icon: '🧊' },
  { label: 'Mock Exams', href: `${x}/mock-exam/`, desc: '', icon: '⏱️' },
  { label: 'Interview Prep', href: `${x}/interview/`, desc: '', icon: '💼' },
  { label: 'Resources', icon: '📚', items: [
    { icon: '📝', label: 'Cheat Sheet', href: `${x}/cheat-sheet/`, desc: 'Printable one-pagers per domain, with audio' },
    { icon: '✅', label: 'Exam Day Guide', href: `${x}/exam-day/`, desc: 'Booking, free vouchers, check-in, retakes' },
    { icon: '⚖️', label: 'Compare services', href: `${x}/compare/`, desc: 'Blob vs Files, VM vs Functions, Azure vs AWS…' },
    { icon: '📚', label: 'Service reference', href: `${x}/services/`, desc: 'Every Azure service in 60 seconds' },
    { icon: '📖', label: 'Glossary', href: `${x}/glossary/`, desc: 'Azure terms in one line' },
    { icon: '🏆', label: 'Free Certificate', href: '/certificate/', desc: `Pass the mock exam, share your ${exam.code} Ready badge` },
    { icon: '</>', label: 'Embed simulations', href: '/embed/', desc: 'For trainers and bloggers' },
  ] },
];
const GROUPS = mode === 'learn' ? LEARN : PUBLIC;
const allLinks = GROUPS.flatMap((g) => ('items' in g ? g.items : [g]));
const active = allLinks.filter((t) => !t.href.includes('#') && (t.href === '/' ? path === '/' : path.startsWith(t.href))).sort((a, b) => b.href.length - a.href.length)[0]?.href;
const groupActive = (g: Group) => g.items.some((i) => i.href === active);
---

<header class="site-header sticky top-0 z-50 border-b border-default bg-[var(--bg)]" data-mode={mode}>
  <div class="hdr-row flex h-14 items-center gap-3 px-4 sm:px-6">
    <button id="app-back" type="button" hidden class="-ml-2 grid size-10 shrink-0 place-items-center rounded-md text-2xl leading-none hover:bg-subtle" aria-label="Back">‹</button>
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${SITE.brandLine}: home`}>
      <img src={SITE.authorImageSmall} alt="Suthahar Jegatheesan" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-[var(--accent)]/30" />
      <span class="brand-text leading-tight">
        <span class="block font-semibold tracking-tight"><span class="header-ms">MS</span>DEVBUILD <span class="brand-sub font-normal text-muted">/ azure</span></span>
        <span class="brand-tag hidden text-[11px] text-muted lg:block">{SITE.tagline}</span>
      </span>
    </a>

    <form id="topic-search" class="relative ml-auto hidden w-full max-w-sm md:block" role="search">
      <label for="topic-q" class="sr-only">Search tutorials</label>
      <input id="topic-q" list="topic-list" type="search" placeholder="Search tutorials… e.g. IaaS" class="w-full rounded-full border border-default bg-[var(--pastel-grey)] py-2 pr-4 pl-10 text-sm outline-none focus:border-[var(--accent)]" />
      <svg class="pointer-events-none absolute top-2.5 left-3.5 size-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <datalist id="topic-list">
        {published.map((t) => <option value={t.title} data-url={t.url} />)}
        <option value={`${exam.code} mock exam`} data-url={`${x}/mock-exam/`} />
        <option value="Interview questions" data-url={`${x}/interview/`} />
        <option value="Revision flashcards" data-url={`${x}/revision/`} />
        <option value="Smart practice and readiness score" data-url={`${x}/practice/`} />
        <option value="Study plan" data-url={`${x}/study-plan/`} />
        <option value="Cheat sheet" data-url={`${x}/cheat-sheet/`} />
        <option value="Exam day guide" data-url={`${x}/exam-day/`} />
        <option value="3D explorer" data-url={`${x}/3d-explorer/`} />
        <option value="Learning dashboard" data-url={`${x}/learn/`} />
      </datalist>
    </form>

    <div class="hdr-actions ml-auto flex shrink-0 items-center gap-1 md:ml-2">
      <a id="xp-chip" href="/progress/" hidden class="flex items-center gap-1.5 rounded-full border border-default bg-[var(--pastel-grey)] px-3 py-1.5 text-sm font-semibold hover:border-[var(--accent)]" title="Your level, XP and learning streak">
        <span id="xp-level"></span><span id="xp-points" class="text-accent"></span><span id="xp-streak" class="hidden"></span>
      </a>
      <button id="search-toggle" type="button" class="rounded-md p-2 hover:bg-subtle md:hidden" aria-label="Search tutorials" aria-expanded="false" aria-controls="topic-search">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </button>
      <button id="install-btn" type="button" data-install hidden class="install-btn flex items-center gap-1.5 rounded-full bg-[#0078d4] px-2.5 py-1.5 text-sm font-semibold text-white hover:bg-[#106ebe]" title="Install the app: works offline, opens from your home screen">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v11M7.5 9.5 12 14l4.5-4.5" /><path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2" /></svg>
        <span class="install-label">Install<span class="hidden lg:inline"> app</span></span>
      </button>
      <CurrencySelect compact class="mr-1" />
      <button id="theme-toggle" type="button" class="rounded-md p-2 transition-colors hover:bg-subtle" aria-label="Switch colour theme">
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" /></svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
  </div>

  <div class="topbar-wrap relative">
  <nav class="topbar overflow-x-auto" aria-label={mode === 'learn' ? `${exam.code} learning` : 'Main'}>
    <ul class="flex h-11 min-w-max items-stretch px-2 text-[0.92rem] sm:px-4">
      {mode === 'learn' && (
        <li class="tb-course-li flex items-center">
          <a href={`${x}/`} class="tb-course" title={`${exam.code} course details`}>
            <span class="tb-course-badge" aria-hidden="true"><CertIcon icon={exam.info.icon} size={18} /></span>
            <span class="tb-course-code">{exam.code}</span>
            <span class="tb-course-name">{exam.name.replace(/^Microsoft /, '')}</span>
            <span class="sr-only"> course details</span>
          </a>
        </li>
      )}
      {GROUPS.map((g, gi) => 'items' in g ? (
        <li class="flex">
          <button type="button" class="tb-group flex items-center gap-1.5 px-3.5 whitespace-nowrap transition-colors" aria-expanded="false" aria-controls={`tb-menu-${gi}`} data-active={groupActive(g) ? '' : undefined}>
            <span class="tb-gi" aria-hidden="true">{g.icon}</span>{g.label}<span class="tb-caret" aria-hidden="true">▾</span>
          </button>
          <div id={`tb-menu-${gi}`} class="tb-menu" hidden>
            {g.items.map((i) => (
              <a href={i.href} class="tb-item" aria-current={active === i.href ? 'page' : undefined}>
                <span class="tb-ico" aria-hidden="true">{i.icon}</span>
                <span><span class="tb-label">{i.label}</span><span class="tb-desc">{i.desc}</span></span>
              </a>
            ))}
          </div>
        </li>
      ) : (
        <li class="flex">
          <a href={g.href} aria-current={active === g.href ? 'page' : undefined} class="flex items-center gap-1.5 px-3.5 whitespace-nowrap transition-colors"><span class="tb-gi" aria-hidden="true">{g.icon}</span>{g.label}</a>
        </li>
      ))}
      {mode === 'learn' && (
        <li class="tb-prog-li flex items-center">
          <a href={`${x}/learn/`} class="tb-prog" data-tb-prog={exam.slug} data-total={published.length} title="Your course progress">
            <span class="tb-ring" style="--p:0" aria-hidden="true"></span><span><span data-tb-pct>0%</span> complete</span>
          </a>
        </li>
      )}
    </ul>
  </nav>
  <span class="topbar-more" aria-hidden="true">›</span>
  </div>
</header>

<style is:global>
  /* Phones: header search opens as a full-width row */
  @media (max-width: 767px) {
    .site-header.search-open #topic-search { display: block; position: absolute; left: .75rem; right: .75rem; top: 3.6rem; max-width: none; z-index: 70; }
    .site-header.search-open #topic-search input { padding-top: .7rem; padding-bottom: .7rem; font-size: 1rem; box-shadow: 0 10px 30px rgb(0 30 60 / .2); background: var(--bg); }
  }
  .install-btn[hidden] { display: none; }
  /* Learning environment: a light course bar (badge · text tabs with underline · progress) */
  .site-header[data-mode='learn'] .topbar { background: var(--bg); color: var(--text); border-top: 1px solid var(--border); }
  .site-header[data-mode='learn'] .topbar ul { gap: .1rem; }
  .site-header[data-mode='learn'] .tb-gi { display: none; }
  .site-header[data-mode='learn'] .topbar li > a:not(.tb-course):not(.tb-prog),
  .site-header[data-mode='learn'] .topbar .tb-group { position: relative; padding-inline: .8rem; color: var(--text-muted); font-weight: 600; background: none; }
  .site-header[data-mode='learn'] .topbar li > a:not(.tb-course):not(.tb-prog):hover,
  .site-header[data-mode='learn'] .topbar .tb-group:hover { color: var(--text); background: none; }
  .site-header[data-mode='learn'] .topbar .tb-group[aria-expanded='true'] { color: var(--text); background: var(--pastel-grey); }
  .site-header[data-mode='learn'] .topbar a[aria-current='page'],
  .site-header[data-mode='learn'] .topbar .tb-group[data-active] { color: var(--accent-deep); background: none; }
  .site-header[data-mode='learn'] .topbar a[aria-current='page']::after,
  .site-header[data-mode='learn'] .topbar .tb-group[data-active]::after { content: ''; position: absolute; left: .8rem; right: .8rem; bottom: 0; height: 3px; border-radius: 3px 3px 0 0; background: var(--accent); }
  .site-header[data-mode='learn'] .topbar-more { color: var(--text); background: linear-gradient(90deg, transparent, var(--bg) 65%); }
  .tb-course { display: flex; align-items: center; gap: .55rem; height: 100%; padding: 0 1rem 0 .25rem; margin-right: .35rem; border-right: 1px solid var(--border); color: var(--text) !important; white-space: nowrap; }
  .tb-course:hover .tb-course-code { color: var(--accent-deep); }
  .tb-course-badge { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; color: #fff; background: linear-gradient(135deg, #0078d4, #3a2f9e); }
  .tb-course-code { font-weight: 800; letter-spacing: -.01em; }
  .tb-course-name { font-size: .82rem; color: var(--text-muted); }
  @media (max-width: 1439px) { .tb-course-name { display: none; } }
  /* the course badge stays pinned at the left while the tabs scroll */
  .tb-course-li { position: sticky; left: 0; z-index: 1; background: var(--bg); margin-left: -.5rem; padding-left: .5rem; }
  @media (max-width: 639px) { .tb-course-code { display: none; } .tb-course { padding-right: .7rem; margin-right: .15rem; } }
  .tb-prog-li { margin-left: auto; padding-left: 1rem; }
  .tb-prog { display: flex; align-items: center; gap: .5rem; padding: .3rem .75rem; border-radius: 999px; border: 1px solid var(--border); font-size: .8rem; font-weight: 600; color: var(--text-muted) !important; white-space: nowrap; }
  .tb-prog:hover { border-color: var(--accent); color: var(--text) !important; }
  .tb-ring { width: 20px; height: 20px; border-radius: 999px; background: conic-gradient(var(--accent) calc(var(--p) * 1%), var(--border) 0); -webkit-mask: radial-gradient(circle, transparent 5.5px, #000 6px); mask: radial-gradient(circle, transparent 5.5px, #000 6px); }
  @media (max-width: 1279px) { .tb-prog-li { display: none; } }
  .site-header[data-mode='public'] .topbar ul { justify-content: center; }
  @media (max-width: 479px) {
    .site-header[data-mode='public'] .topbar ul { justify-content: flex-start; padding-inline: .25rem; }
    .site-header[data-mode='public'] .topbar a { padding-inline: .7rem; }
    .site-header[data-mode='public'] .topbar a > span[aria-hidden] { display: none; }
  }
  .install-btn, #xp-chip { min-height: 36px; min-width: 36px; justify-content: center; }
  /* Small phones: the install button shows its icon only */
  @media (max-width: 400px) {
    .install-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .install-btn { padding: .45rem; }
    /* small phones: keep every header button on screen */
    .brand-sub { display: none; }
    .hdr-row { gap: .5rem; padding-inline: .75rem; }
    .hdr-actions { gap: 0; }
    .hdr-actions > button, .hdr-actions > a#xp-chip { flex: none; }
    #theme-toggle, #search-toggle { padding: .45rem; }
  }
  /* phones: compact XP chip (level + number); when it's showing, the photo logo stands in for the wordmark */
  @media (max-width: 639px) {
    .xp-unit, #xp-streak { display: none !important; }
    #xp-chip { padding: .3rem .55rem; gap: .25rem; }
    .site-header:has(#xp-chip:not([hidden])) .brand-text { display: none; }
  }
  @media (max-width: 340px) { .brand-text { display: none; } }
  /* Top menu: show a fade + arrow when more items are off to the right */
  .topbar-more { display: none; position: absolute; top: 0; right: 0; bottom: 0; width: 2.6rem; align-items: center; justify-content: flex-end; padding-right: .5rem; color: #fff; font-size: 1.4rem; font-weight: 700; pointer-events: none; background: linear-gradient(90deg, transparent, var(--topbar) 65%); }
  .topbar-wrap.more-right .topbar-more { display: flex; }
  .topbar .tb-group { color: var(--topbar-text); }
  .topbar .tb-group:hover, .topbar .tb-group[aria-expanded='true'] { background: rgb(255 255 255 / 0.12); }
  .topbar .tb-group[data-active] { background: #0078d4; color: #fff; }
  .tb-caret { font-size: .95em; opacity: .85; transition: transform .15s; }
  .tb-group[aria-expanded='true'] .tb-caret { transform: rotate(180deg); }
  .tb-menu { position: fixed; z-index: 60; width: min(360px, calc(100vw - 16px)); padding: 6px; border-radius: 12px; background: var(--card); color: var(--text); border: 1px solid var(--card-line); box-shadow: 0 14px 40px rgb(0 30 60 / .22); }
  .tb-item { display: flex; gap: 12px; align-items: flex-start; padding: 9px 10px; border-radius: 8px; color: var(--text) !important; }
  .tb-item:hover, .tb-item:focus-visible { background: var(--pastel-blue) !important; }
  .tb-item[aria-current='page'] { background: var(--pastel-blue); }
  .tb-ico { flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 9px; background: var(--pastel-grey); font-size: 17px; font-weight: 700; }
  .tb-label { display: block; font-weight: 600; }
  .tb-desc { display: block; font-size: .82rem; color: var(--text-muted); line-height: 1.35; }
</style>

<script>
  import { load, levelFor, streak } from '../lib/progress';
  const paintXp = () => {
    const s = load();
    const chip = document.getElementById('xp-chip');
    if (!chip) return;
    const lv = levelFor(s.xp);
    const st = streak(s);
    chip.hidden = s.xp === 0;
    document.getElementById('xp-level')!.textContent = lv.icon;
    document.getElementById('xp-points')!.innerHTML = `${s.xp}<span class="xp-unit"> XP</span>`;
    const se = document.getElementById('xp-streak')!;
    se.textContent = `🔥 ${st}`;
    se.classList.toggle('hidden', st === 0);
  };
  paintXp();
  window.addEventListener('progress-change', paintXp);
  // Learning bar: course progress ring (lesson keys start with the exam slug).
  const prog = document.querySelector<HTMLElement>('[data-tb-prog]');
  const paintProg = () => {
    if (!prog) return;
    const total = Number(prog.dataset.total) || 1;
    const done = Object.keys(load().done).filter((k) => k.startsWith(`${prog.dataset.tbProg}/`)).length;
    const pct = Math.min(100, Math.round((done / total) * 100));
    prog.querySelector<HTMLElement>('.tb-ring')!.style.setProperty('--p', String(pct));
    prog.querySelector('[data-tb-pct]')!.textContent = `${pct}%`;
  };
  paintProg();
  window.addEventListener('progress-change', paintProg);

  // Phones: search toggle
  const header = document.querySelector<HTMLElement>('.site-header');
  const sBtn = document.getElementById('search-toggle');
  sBtn?.addEventListener('click', () => {
    const open = !header!.classList.contains('search-open');
    header!.classList.toggle('search-open', open);
    sBtn.setAttribute('aria-expanded', String(open));
    if (open) (document.getElementById('topic-q') as HTMLInputElement)?.focus();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header?.classList.contains('search-open')) { header.classList.remove('search-open'); sBtn?.setAttribute('aria-expanded', 'false'); } });

  // Top menu "more" hint
  const bar = document.querySelector<HTMLElement>('.topbar');
  const wrap = document.querySelector<HTMLElement>('.topbar-wrap');
  const more = () => wrap?.classList.toggle('more-right', !!bar && bar.scrollLeft + bar.clientWidth < bar.scrollWidth - 6);
  bar?.addEventListener('scroll', more, { passive: true });
  addEventListener('resize', more);
  more();
  // keep the active menu item in view on phones
  bar?.querySelector('[aria-current="page"], .tb-group[data-active]')?.scrollIntoView({ block: 'nearest', inline: 'center' });

  // Grouped top-bar menus
  const groups = [...document.querySelectorAll<HTMLButtonElement>('.tb-group')];
  const menuOf = (b: HTMLButtonElement) => document.getElementById(b.getAttribute('aria-controls')!)!;
  const closeAll = (except?: HTMLButtonElement) => groups.forEach((b) => { if (b !== except) { b.setAttribute('aria-expanded', 'false'); menuOf(b).hidden = true; } });
  const place = (b: HTMLButtonElement) => {
    const r = b.getBoundingClientRect(), m = menuOf(b);
    m.style.top = `${r.bottom + 4}px`;
    m.style.left = `${Math.max(8, Math.min(r.left, innerWidth - m.offsetWidth - 8))}px`;
  };
  groups.forEach((b) => {
    b.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = b.getAttribute('aria-expanded') !== 'true';
      closeAll(b);
      b.setAttribute('aria-expanded', String(open));
      menuOf(b).hidden = !open;
      if (open) { place(b); menuOf(b).querySelector<HTMLElement>('a')?.focus({ preventScroll: true }); }
    });
  });
  document.addEventListener('click', (e) => { if (!(e.target as HTMLElement).closest('.tb-menu')) closeAll(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const open = groups.find((b) => b.getAttribute('aria-expanded') === 'true'); closeAll(); open?.focus(); } });
  addEventListener('resize', () => closeAll());
  const follow = () => groups.forEach((b) => { if (b.getAttribute('aria-expanded') === 'true') place(b); });
  document.querySelector('.topbar')?.addEventListener('scroll', follow, { passive: true });
  addEventListener('scroll', follow, { passive: true });
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
  const form = document.getElementById('topic-search') as HTMLFormElement | null;
  const input = document.getElementById('topic-q') as HTMLInputElement | null;
  const go = () => {
    if (!input) return;
    const v = input.value.trim().toLowerCase();
    if (!v) return;
    const opts = [...document.querySelectorAll<HTMLOptionElement>('#topic-list option')];
    const hit = opts.find((o) => o.value.toLowerCase() === v) ?? opts.find((o) => o.value.toLowerCase().includes(v));
    if (hit?.dataset.url) location.href = hit.dataset.url;
  };
  input?.addEventListener('change', go);
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    go();
  });
</script>
