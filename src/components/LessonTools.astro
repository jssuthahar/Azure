---
/**
 * Lesson toolbar: Beginner/Full view switch and "Listen" (Nimbus reads the
 * visible lesson aloud, paragraph by paragraph, highlighting as it goes).
 */
import NimbusBot from './NimbusBot.astro';
import LessonNotes from './LessonNotes.astro';
import ReadingSettings from './ReadingSettings.astro';
interface Props {
  lessonKey: string;
}
const { lessonKey } = Astro.props;
---
<div class="lesson-tools mt-5 flex flex-wrap items-center gap-3" data-slide-skip>
  <div class="view-switch inline-flex rounded-full border border-default bg-[var(--pastel-grey)] p-1 text-sm font-semibold" role="group" aria-label="How much detail">
    <button type="button" data-view-btn="simple" class="rounded-full px-4 py-1.5">🧒 Beginner view</button>
    <button type="button" data-view-btn="full" class="rounded-full px-4 py-1.5">🎓 Full lesson</button>
  </div>
  <button type="button" data-present-open class="present-open inline-flex items-center gap-2 rounded-full bg-[#0078d4] px-4 py-2 text-sm font-bold text-white hover:bg-[#005a9e]" aria-label="Slide mode: read the lesson one part at a time, full screen">
    <span aria-hidden="true">▶</span> Slide mode
  </button>
  <button type="button" data-tutor-open class="inline-flex items-center gap-2 rounded-full border border-default bg-[var(--card)] px-4 py-2 text-sm font-bold hover:border-[var(--accent)]" aria-label="Lesson tutor: explain this lesson another way">
    <span aria-hidden="true">💬</span> Explain it another way
  </button>
  <button type="button" data-bookmark-btn aria-pressed="false" class="inline-flex items-center gap-2 rounded-full border border-default bg-[var(--card)] px-4 py-2 text-sm font-bold hover:border-[var(--accent)]">
    <span aria-hidden="true">🔖</span> <span data-bookmark-label>Bookmark</span>
  </button>
  <button type="button" data-notes-open class="inline-flex items-center gap-2 rounded-full border border-default bg-[var(--card)] px-4 py-2 text-sm font-bold hover:border-[var(--accent)]" aria-haspopup="dialog">
    <span aria-hidden="true">📝</span> My notes <span data-notes-count class="notes-count rounded-full bg-[#0078d4] px-2 text-xs text-white"></span>
  </button>
  <button type="button" data-read-open class="inline-flex items-center gap-2 rounded-full border border-default bg-[var(--card)] px-4 py-2 text-sm font-bold hover:border-[var(--accent)]" aria-haspopup="dialog" aria-label="Reading settings: text size, line spacing and font">
    <span aria-hidden="true" class="font-serif">Aa</span> Reading
  </button>
  <button type="button" id="listen-btn" class="voice-only inline-flex items-center gap-2 rounded-full bg-[#ffd75e] px-4 py-2 text-sm font-bold text-[#0b1020] hover:bg-[#ffcd2e]">
    <span aria-hidden="true">🎧</span> <span id="listen-label">Listen with Nimbus</span>
  </button>
  <label class="voice-only flex items-center gap-1.5 text-sm text-muted">Speed
    <select id="listen-rate" class="rounded-md border border-default bg-[var(--bg)] px-1.5 py-1">
      <option value="0.8">Slow</option>
      <option value="1">Normal</option>
      <option value="1.2">Fast</option>
    </select>
  </label>
</div>

<div id="reader" data-slide-skip class="reader hidden" role="region" aria-label="Lesson reader">
  <div class="reader-top">
    <div class="reader-nimbus"><NimbusBot size={54} mood="talk" tap /></div>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-bold" id="reader-state">Nimbus is reading…</p>
      <p id="reader-pos" class="text-xs text-muted"></p>
      <div class="reader-bar" aria-hidden="true"><span id="reader-progress"></span></div>
    </div>
  </div>
  <div class="reader-ctl">
    <button type="button" id="reader-replay" class="reader-b" aria-label="Repeat that sentence">⏮</button>
    <button type="button" id="reader-pause" class="reader-b reader-main">⏸ Pause</button>
    <button type="button" id="reader-speed" class="reader-b" aria-label="Reading speed">1×</button>
    <button type="button" id="reader-stop" class="reader-b" aria-label="Stop reading">⏹</button>
  </div>
  <div class="reader-cmds" role="group" aria-label="Ask Nimbus about this lesson">
    <button type="button" class="reader-cmd" data-tutor-cmd="simple">Explain it simply</button>
    <button type="button" class="reader-cmd" data-tutor-cmd="story">Tell me a story</button>
    <button type="button" class="reader-cmd" data-tutor-cmd="quiz">Ask me questions</button>
    <button type="button" class="reader-cmd" data-tutor-cmd="teach">Teach me</button>
  </div>
</div>

<LessonNotes lessonKey={lessonKey} />
<ReadingSettings />

<style is:global>
  [data-view='simple'] [data-view-btn='simple'],
  [data-view='full'] [data-view-btn='full'] {
    background: #0078d4;
    color: #fff;
  }
  .no-voice .voice-only,
  .no-voice .speak-btn {
    display: none !important;
  }
  .reading {
    background: var(--pastel-yellow);
    border-radius: 0.35rem;
    box-shadow: 0 0 0 6px var(--pastel-yellow);
    transition: background 0.2s;
  }
  .reader { position: fixed; z-index: 140; left: max(1rem, env(safe-area-inset-left)); bottom: calc(1rem + env(safe-area-inset-bottom)); width: min(400px, calc(100vw - 2rem)); padding: 10px 12px 12px; border-radius: 22px; border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--card-line)); background: var(--card); box-shadow: 0 30px 60px -22px rgb(0 25 60 / .55); display: flex; flex-direction: column; gap: 8px; }
  .reader.hidden { display: none; }
  .reader-top { display: flex; align-items: center; gap: 10px; }
  .reader-nimbus { flex: none; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, var(--accent-soft) 75%); box-shadow: 0 0 0 2.5px rgb(255 215 94 / .6); }
  .reader-nimbus .nb-shadow { display: none; }
  .reader-bar { height: 5px; margin-top: 6px; border-radius: 999px; background: color-mix(in srgb, var(--accent) 14%, var(--card)); overflow: hidden; }
  .reader-bar span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #0078d4, #62e6ff); transition: width .3s; }
  .reader-ctl { display: flex; gap: 6px; }
  .reader-b { min-width: 44px; min-height: 40px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--card-line); background: var(--bg); color: var(--text); font-weight: 700; font-size: .9rem; cursor: pointer; }
  .reader-main { flex: 1; border: 0; color: #fff; background: linear-gradient(135deg, #1a8cff, #0063b8 60%, #0a3d75); }
  .reader-cmds { display: flex; flex-wrap: wrap; gap: 6px; }
  .reader-cmd { min-height: 34px; padding: 0 11px; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--card-line)); background: var(--bg); color: var(--accent-deep); font-size: .78rem; font-weight: 700; cursor: pointer; }
  .reader-b:focus-visible, .reader-cmd:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  ::highlight(nimbus-reading) { background-color: #ffd75e; color: #0b1020; }
  @media (max-width: 640px) { .reader { left: .5rem; right: .5rem; width: auto; bottom: calc(5.4rem + env(safe-area-inset-bottom)); } }
  @media (max-width: 900px) { body:has(#ask.is-open) .reader { display: none; } }
  /* ---------- Slide mode (src/lib/present.ts) ---------- */
  .present-ui {
    display: none;
  }
  html.presenting {
    overflow: hidden;
  }
  html.presenting body {
    overflow: hidden;
  }
  html.presenting article[data-present-root] {
    position: fixed;
    inset: 0;
    z-index: 150;
    max-width: none;
    margin: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    padding: calc(4.25rem + env(safe-area-inset-top)) max(1rem, calc((100% - 920px) / 2), env(safe-area-inset-right))
      calc(5.5rem + env(safe-area-inset-bottom)) max(1rem, calc((100% - 920px) / 2), env(safe-area-inset-left));
  }
  html.presenting article[data-present-root] > .present-ui {
    display: block;
  }
  html.presenting [data-slide-off],
  html.presenting [data-slide-skip] {
    display: none !important;
  }
  /* No gap or divider line above the first part of a slide. */
  html.presenting article .present-first,
  html.presenting article .present-first > h2:first-child {
    margin-top: 0 !important;
    border-top: 0;
    padding-top: 0;
  }
  html.presenting article .lesson {
    font-size: 1.08rem;
  }
  html.presenting article [tabindex='-1']:focus {
    outline: none;
  }
  .present-in {
    animation: present-in 0.28s ease-out;
  }
  @keyframes present-in {
    from {
      opacity: 0;
      transform: translateX(14px);
    }
  }
  .present-top,
  .present-bottom {
    position: fixed;
    left: 0;
    right: 0;
    z-index: 151;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--card);
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
  }
  .present-top {
    top: 0;
    padding-top: calc(0.6rem + env(safe-area-inset-top));
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--card-line);
  }
  .present-bottom {
    bottom: 0;
    justify-content: space-between;
    padding-top: 0.75rem;
    padding-bottom: calc(0.75rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--card-line);
  }
  .present-pos {
    min-width: 0;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.95rem;
  }
  .present-count {
    font-weight: 800;
    color: var(--accent);
    margin-right: 0.35rem;
  }
  .present-title {
    font-weight: 600;
  }
  .present-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: transparent;
  }
  .present-bar span {
    display: block;
    height: 100%;
    background: #0078d4;
    transition: width 0.25s;
  }
  .present-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg);
    padding: 0.5rem 1.1rem;
    font-weight: 700;
    color: var(--text);
  }
  .present-btn:disabled {
    cursor: not-allowed;
    border-style: dashed;
    color: var(--text-muted);
  }
  .present-primary:not(:disabled) {
    background: #0078d4;
    border-color: #0078d4;
    color: #fff;
  }
  .present-primary:not(:disabled):hover {
    background: #005a9e;
  }
  .present-hint {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  @media (max-width: 480px) {
    .present-hint {
      display: none;
    }
  }
  @media (max-width: 360px) {
    .present-exit .present-word {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .present-in {
      animation: none;
    }
    .present-bar span {
      transition: none;
    }
  }
  @keyframes nimbus-talk {
    50% {
      transform: translateY(-3px) rotate(-3deg);
    }
  }
</style>

<script>
  import { canSpeak, speak, stopSpeaking, readableText, getRate, setRate } from '../lib/speech';
  import { initPresent } from '../lib/present';

  initPresent();

  /* ---------- Beginner / Full view ---------- */
  const setView = (v: string) => {
    document.documentElement.dataset.view = v;
    try {
      localStorage.setItem('lesson-view', v);
    } catch {}
  };
  document.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((b) =>
    b.addEventListener('click', () => {
      setView(b.dataset.viewBtn!);
      stop();
    }),
  );
  document.querySelectorAll<HTMLElement>('[data-go-full]').forEach((b) =>
    b.addEventListener('click', () => {
      setView('full');
      document.getElementById(b.dataset.goFull!)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  /* ---------- Listen with Nimbus: sentence by sentence, browser voice only ---------- */
  const reader = document.getElementById('reader')!;
  const label = document.getElementById('listen-label')!;
  const pauseBtn = document.getElementById('reader-pause')!;
  const speedBtn = document.getElementById('reader-speed')!;
  const stateEl = document.getElementById('reader-state')!;
  const progressEl = document.getElementById('reader-progress')!;
  const rate = document.getElementById('listen-rate') as HTMLSelectElement;
  const readerBot = reader.querySelector<SVGElement>('.nb');
  rate.value = String(getRate());
  const RATES = [0.8, 1, 1.2];
  const showRate = () => { speedBtn.textContent = `${Number(rate.value)}×`; };
  showRate();
  rate.addEventListener('change', () => { setRate(Number(rate.value)); showRate(); });
  speedBtn.addEventListener('click', () => {
    const i = RATES.indexOf(Number(rate.value));
    rate.value = String(RATES[(i + 1) % RATES.length]);
    setRate(Number(rate.value));
    showRate();
    if (playing && !paused) restartSentence();
  });

  let playing = false;
  let paused = false;
  let runId = 0;
  let curBlock = 0, curSent = 0;
  // CSS Custom Highlight API marks the sentence being read without touching the lesson's HTML.
  const canMark = typeof CSS !== 'undefined' && 'highlights' in CSS && typeof (window as any).Highlight === 'function';

  const blocks = () => {
    const root = document.querySelector('article');
    if (!root) return [];
    const sel = 'h1, .answer-box p, .lesson h2, .lesson h3, .lesson p, .lesson li, .lesson dd';
    return [...root.querySelectorAll<HTMLElement>(sel)].filter((el) => {
      if (el.offsetParent === null) return false; // hidden (e.g. full-only in Beginner view, closed details)
      if (el.closest('.opt, figure svg, .kc, .exercise-box, .ila, .la, details:not([open]), nav, .lesson-tools, table')) return false;
      if (el.matches('li') && el.querySelector('p')) return false; // read the inner <p> instead
      return readableText(el).length > 1;
    });
  };

  /** Split one block into sentences, each with a Range over its own text nodes. */
  type Sent = { text: string; range: Range | null };
  function sentences(el: HTMLElement): Sent[] {
    const nodes: { n: Text; start: number }[] = [];
    let full = '';
    const walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, {
      acceptNode: (n) => ((n.parentElement?.closest('button, .speak-btn, [aria-hidden="true"], .sr-only, svg, script, style')) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT),
    });
    for (let n = walk.nextNode() as Text | null; n; n = walk.nextNode() as Text | null) { nodes.push({ n, start: full.length }); full += n.data; }
    const parts: { s: number; e: number }[] = [];
    const Seg = (Intl as any).Segmenter;
    if (Seg) for (const p of new Seg('en', { granularity: 'sentence' }).segment(full)) parts.push({ s: p.index, e: p.index + p.segment.length });
    else { const re = /[^.!?]+[.!?]+["')\]]*\s*|[^.!?]+$/g; let m; while ((m = re.exec(full))) parts.push({ s: m.index, e: m.index + m[0].length }); }
    const at = (pos: number) => { for (let i = nodes.length - 1; i >= 0; i--) if (nodes[i].start <= pos) return { node: nodes[i].n, off: Math.min(pos - nodes[i].start, nodes[i].n.length) }; return null; };
    return parts.map(({ s, e }) => {
      const text = full.slice(s, e).trim();
      let range: Range | null = null;
      const a = at(s), b = at(Math.max(s, e - 1));
      if (a && b) { try { range = document.createRange(); range.setStart(a.node, a.off); range.setEnd(b.node, Math.min(b.off + 1, b.node.length)); } catch { range = null; } }
      return { text, range };
    }).filter((x) => /[\p{L}\p{N}]/u.test(x.text));
  }

  const clearMark = () => {
    document.querySelectorAll('.reading').forEach((e) => e.classList.remove('reading'));
    if (canMark) (CSS as any).highlights.delete('nimbus-reading');
  };
  const mood = (m: string) => { if (readerBot) readerBot.dataset.mood = m; };

  let list: HTMLElement[] = [];
  let sents: Sent[] = [];
  async function run(id: number) {
    for (; curBlock < list.length; curBlock++, curSent = 0) {
      if (id !== runId) return;
      const el = list[curBlock];
      sents = sentences(el);
      if (!sents.length) sents = [{ text: readableText(el), range: null }];
      document.querySelectorAll('.reading').forEach((e) => e.classList.remove('reading'));
      el.classList.add('reading');
      el.scrollIntoView({ block: 'center', behavior: 'smooth' });
      document.getElementById('reader-pos')!.textContent = `Part ${curBlock + 1} of ${list.length}`;
      progressEl.style.width = `${Math.round((curBlock / list.length) * 100)}%`;
      for (; curSent < sents.length; curSent++) {
        if (id !== runId) return;
        const s = sents[curSent];
        if (canMark && s.range) (CSS as any).highlights.set('nimbus-reading', new (window as any).Highlight(s.range));
        mood('talk');
        await speak(s.text, Number(rate.value));
        if (id !== runId) return;
        while (paused && id === runId) await new Promise((r) => setTimeout(r, 150));
        if (id !== runId) return;
      }
    }
    if (id === runId) { progressEl.style.width = '100%'; finish(); }
  }

  function play(from = 0) {
    list = blocks();
    curBlock = from; curSent = 0;
    playing = true;
    paused = false;
    reader.classList.remove('hidden');
    label.textContent = 'Stop listening';
    pauseBtn.textContent = '⏸ Pause';
    stateEl.textContent = 'Nimbus is reading…';
    run(++runId);
  }
  /** Re-read the current sentence (after a speed change, Replay or Resume). */
  function restartSentence() {
    stopSpeaking();
    paused = false;
    pauseBtn.textContent = '⏸ Pause';
    stateEl.textContent = 'Nimbus is reading…';
    run(++runId);
  }
  function finish() {
    stop();
    window.dispatchEvent(new CustomEvent('nimbus-chat', { detail: { say: 'That’s the whole lesson. Want me to ask you a few questions about it? Tap “Quiz me” below.' } }));
  }
  function stop() {
    runId++;
    playing = false;
    paused = false;
    stopSpeaking();
    clearMark();
    reader.classList.add('hidden');
    label.textContent = 'Listen with Nimbus';
  }
  document.getElementById('listen-btn')!.addEventListener('click', () => (playing ? stop() : play()));
  document.getElementById('reader-stop')!.addEventListener('click', stop);
  document.getElementById('reader-replay')!.addEventListener('click', () => { if (playing) restartSentence(); });
  pauseBtn.addEventListener('click', () => {
    if (!playing) return;
    if (!paused) {
      // Cancel and remember the sentence: pause() is unreliable on phones, re-reading the sentence always works.
      paused = true;
      runId++;
      stopSpeaking();
      pauseBtn.textContent = '▶ Resume';
      stateEl.textContent = 'Paused';
      mood('wave');
    } else restartSentence();
  });
  reader.querySelectorAll<HTMLElement>('[data-tutor-cmd]').forEach((b) => b.addEventListener('click', () => {
    if (playing && !paused) pauseBtn.click();
    window.dispatchEvent(new CustomEvent('nimbus-tutor', { detail: { action: b.dataset.tutorCmd } }));
  }));
  window.addEventListener('speech-stop-all', () => playing && stop());
  window.addEventListener('beforeunload', () => stopSpeaking());
  if (!canSpeak()) document.documentElement.classList.add('no-voice');
</script>
