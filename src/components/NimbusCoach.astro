---
/**
 * Nimbus Coach (owner's request, 26 Nov 2026): a personal study buddy that
 * keeps a learner on one exam at a time.
 *
 * - First time on an exam's course page, learn page or a lesson: offers to
 *   plan the exam (date + minutes a day), saved through src/lib/plan.ts, with
 *   calendar reminders (.ics). "Just looking" snoozes it for 3 days.
 * - Once a day: "welcome back, today's step is…" with a Continue button.
 * - On another exam's pages: a one-time nudge per exam per tab to go back,
 *   keep looking, or switch focus (the old exam is parked, never reset).
 * - When the focus exam is done (every lesson, or 80%+ in a full mock) or its
 *   date has passed: congratulates and suggests the next exam (next-exams.ts).
 * - "My plan" view on demand: any [data-coach-open] button (Ask Nimbus has one).
 *
 * Never on exams, labs, simulators, games, practice, the Architecture Builder
 * or embeds; never in slide mode, full screen, while typing or in a quiz;
 * never on top of the share/coffee card or the Ask panel. One card per page
 * view at most. Non-modal: Esc or ✕ closes it. State: src/lib/coach.ts.
 */
import NimbusBot from './NimbusBot.astro';
import { SITE } from '../config';
---
<aside id="nc" class="nc" data-coach data-site={SITE.url} hidden role="dialog" aria-modal="false" aria-labelledby="nc-h">
  <div class="nc-top">
    <span class="nc-face"><NimbusBot size={56} mood="wave" tap /></span>
    <h2 id="nc-h" class="nc-h" tabindex="-1"></h2>
    <button type="button" class="nc-x" data-nc-close aria-label="Close Nimbus">✕</button>
  </div>
  <div class="nc-dots" aria-hidden="true"><span></span><span></span><span></span></div>
  <div id="nc-body" class="nc-body" aria-live="polite"></div>
</aside>

<script>
  // The coach code (src/lib/coach-ui.ts) loads only where it may speak, after the page settles, or on "My plan".
  let loading: Promise<void> | null = null;
  const load = () => (loading ??= import('../lib/coach-ui').then((m) => { m.mountCoach(); document.removeEventListener('click', onOpen, true); }));
  const onOpen = (e: Event) => {
    const t = (e.target as Element)?.closest?.('[data-coach-open]') as HTMLElement | null;
    if (!t) return;
    e.stopImmediatePropagation();
    e.preventDefault();
    load().then(() => t.click());
  };
  document.addEventListener('click', onOpen, true);
  const focus = (() => { try { return JSON.parse(localStorage.getItem('msdb-azure-plan-v1') || '{}')._coach?.focus || null; } catch { return null; } })();
  const seg = location.pathname.split('/')[1] || '';
  const live = new Set<string>(JSON.parse(document.getElementById('ask')?.dataset.exams || '[]').map((x: { slug: string }) => x.slug));
  const quiet = (() => { try { return navigator.webdriver && localStorage.getItem('msdb-coach-qa') !== '1'; } catch { return true; } })();
  if (!quiet && (live.has(seg) || focus)) {
    const later = () => setTimeout(() => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(() => load(), { timeout: 3000 }) : load()), 2500);
    document.readyState === 'complete' ? later() : addEventListener('load', later, { once: true });
  }
</script>

<style is:global>
  .nc { position: fixed; z-index: 92; right: max(16px, env(safe-area-inset-right)); bottom: calc(76px + env(safe-area-inset-bottom)); width: min(380px, calc(100vw - 2rem)); max-height: calc(100dvh - 140px); overflow: auto; padding: 1.05rem 1rem 1rem; border-radius: 24px; border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--card-line)); color: var(--text); background: radial-gradient(120% 60% at 0% 0%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 60%), var(--card); box-shadow: 0 40px 90px -24px rgb(0 25 60 / .6), 0 12px 28px -18px rgb(0 60 140 / .45), inset 0 1px 0 rgb(255 255 255 / .5); opacity: 0; transform: translateY(14px); transition: opacity .22s, transform .22s; }
  .nc.is-in { opacity: 1; transform: none; }
  /* azure-to-gold hairline across the top */
  .nc::before { content: ''; position: absolute; top: 0; left: 18px; right: 18px; height: 3px; border-radius: 0 0 3px 3px; background: linear-gradient(90deg, #1a8cff, #62e6ff 45%, #ffd75e); }
  .nc[hidden] { display: none; }
  body:has(#ask.is-open) .nc, body:has(#xs:not([hidden])) .nc { display: none; }
  body:has(.install-banner) .nc { bottom: calc(156px + env(safe-area-inset-bottom)); }
  .nc-top { display: flex; align-items: center; gap: .6rem; padding-right: 2.2rem; }
  .nc-face { flex: none; display: grid; place-items: center; width: 60px; height: 60px; margin: -6px 0 -6px -6px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #fff, var(--accent-soft) 75%); box-shadow: 0 0 0 2.5px rgb(255 215 94 / .6), 0 8px 18px -8px rgb(0 60 140 / .55); }
  .nc .nb-in { animation: nb-pop .55s cubic-bezier(.3, .7, .4, 1.2); }
  @media (prefers-reduced-motion: reduce) { .nc .nb-in { animation: none; } }
  .nc-dots { display: none; gap: 5px; width: max-content; margin: .7rem 0 .2rem; padding: .6rem .8rem; border-radius: 14px 14px 14px 4px; background: var(--pastel-blue); }
  .nc-dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: nc-dot 1s ease-in-out infinite; }
  .nc-dots span:nth-child(2) { animation-delay: .15s; }
  .nc-dots span:nth-child(3) { animation-delay: .3s; }
  .nc.is-typing .nc-dots { display: flex; }
  .nc.is-typing .nc-body { display: none; }
  .nc-body > * { animation: nc-rise .35s ease-out both; }
  .nc-body > :nth-child(2) { animation-delay: .06s; }
  .nc-body > :nth-child(3) { animation-delay: .12s; }
  .nc-body > :nth-child(n+4) { animation-delay: .18s; }
  @keyframes nc-dot { 0%, 100% { transform: translateY(0); opacity: .45; } 50% { transform: translateY(-4px); opacity: 1; } }
  @keyframes nc-rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .nc-body > * { animation: none; } }
  .nc-h { font-size: 1.05rem; font-weight: 800; line-height: 1.3; outline: none; }
  .nc-x { position: absolute; top: .45rem; right: .45rem; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; color: var(--text-muted); }
  .nc-x:hover { background: var(--pastel-grey); }
  .nc-body p { margin-top: .55rem; font-size: .92rem; line-height: 1.55; }
  .nc-muted { color: var(--text-muted); font-size: .85rem !important; }
  .nc-warn { padding: .5rem .7rem; border-radius: 10px; border-left: 4px solid var(--warn); background: var(--warn-soft); }
  .nc-lbl { display: inline-block; margin-right: .35rem; font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-deep); }
  .nc-task { padding: .6rem .75rem; border-radius: 14px; background: linear-gradient(135deg, var(--pastel-blue), color-mix(in srgb, var(--pastel-blue) 70%, var(--accent-soft))); border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent); }
  .nc-btns { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .85rem; }
  .nc-btns .btn { min-height: 44px; }
  .nc-link { display: inline-block; margin-top: .6rem; min-height: 36px; padding: .35rem 0; font-size: .88rem; font-weight: 600; color: var(--accent-deep); text-decoration: underline; text-underline-offset: 3px; background: none; border: 0; cursor: pointer; }
  .nc-links { display: flex; flex-wrap: wrap; column-gap: 1rem; }
  .nc-opts { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: .5rem; margin-top: .8rem; }
  .nc-opt { display: flex; flex-direction: column; align-items: flex-start; gap: .15rem; min-height: 48px; padding: .55rem .7rem; border-radius: 12px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-weight: 700; text-align: left; cursor: pointer; }
  .nc-opt span { font-size: .8rem; font-weight: 500; color: var(--text-muted); }
  .nc-opt:hover, .nc-opt:focus-visible { border-color: var(--accent); background: var(--accent-soft); }
  .nc-opt-wide { grid-column: 1 / -1; }
  .nc-date { display: flex; flex-wrap: wrap; align-items: flex-end; gap: .5rem; margin-top: .7rem; }
  .nc-date label { display: flex; flex-direction: column; gap: .2rem; font-size: .85rem; font-weight: 600; }
  .nc-date input { min-height: 44px; padding: 0 .6rem; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 16px; }
  .nc-bar { height: 8px; margin-top: .6rem; border-radius: 999px; background: var(--pastel-grey); overflow: hidden; }
  .nc-bar span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #1a8cff, #62e6ff); box-shadow: 0 0 10px rgb(98 230 255 / .6); }
  .nc-park-h { margin-top: .8rem; }
  .nc-park li { display: flex; align-items: center; justify-content: space-between; gap: .5rem; font-size: .9rem; }
  .nc-park .nc-link { margin-top: 0; }
  @media (max-width: 640px) { .nc { right: .5rem; left: .5rem; width: auto; bottom: calc(76px + env(safe-area-inset-bottom)); } }
  @media (prefers-reduced-motion: reduce) { .nc { transition: none; } }
  @media print { .nc { display: none !important; } }
</style>
