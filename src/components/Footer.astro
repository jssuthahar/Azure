---
import { SITE } from '../config';
import SocialLinks from './SocialLinks.astro';
import { examFromPath } from '../data/exams';
const exam = examFromPath(Astro.url.pathname);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-default bg-[var(--bg)]/80">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
    <div>
      <p class="font-semibold"><span class="header-ms">MS</span>DEVBUILD <span class="font-normal text-muted">/ azure</span></p>
      <p class="text-xs text-muted">{SITE.tagline}</p>
      <div class="mt-3 flex items-center gap-3">
        <img src={SITE.authorImageSmall} alt="Suthahar Jegatheesan" width="48" height="48" loading="lazy" class="size-12 rounded-full object-cover" />
        <span class="text-sm leading-snug"><a href={SITE.profile} class="font-semibold hover:text-[var(--accent-deep)]">{SITE.author}</a><span class="block text-muted">{SITE.authorTitle} · {SITE.authorLocation}</span></span>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Free Azure certification tutorials and simulations. Feel Azure without an Azure account, then walk into the exam and the interview with confidence.
      </p>
      <SocialLinks class="mt-3" />
    </div>
    <div>
      <p class="text-sm font-semibold">Azure Tutorials</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-[var(--accent-deep)]" href={`/${exam.slug}/`}>{exam.code} Azure Fundamentals</a></li>
        {exam.modules.map((m) => <li><a class="hover:text-[var(--accent-deep)]" href={`/${exam.slug}/#${m.slug}`}>{m.shortTitle}</a></li>)}
        <li><a class="hover:text-[var(--accent-deep)]" href={`/${exam.slug}/mock-exam/`}>{exam.code} mock exam</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href={`/${exam.slug}/interview/`}>{exam.code} interview questions</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">MSDEVBUILD</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-[var(--accent-deep)]" href={SITE.blog}>Programming tutorials &amp; blog</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/about/">About</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href={SITE.profile}>About Suthahar</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="https://www.youtube.com/@MSDEVBUILD?sub_confirmation=1" target="_blank" rel="noopener">YouTube channel</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="https://blog.msdevbuild.com/contact/">Contact</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">Site index</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-[var(--accent-deep)]" href="/app/">📲 Install the app (works offline)</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/sitemap/">Site map (all pages)</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/sitemap-index.xml">XML sitemap</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/llms.txt">llms.txt <span class="text-xs">(for AI assistants)</span></a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/llms-full.txt">llms-full.txt</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/robots.txt">robots.txt</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">Legal</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-[var(--accent-deep)]" href="/privacy/">Privacy Policy</a></li>
        <li><a class="hover:text-[var(--accent-deep)]" href="/terms/">Terms and Conditions</a></li>
      </ul>
      <p class="mt-4 text-xs leading-relaxed text-muted">
        Independent learning resource. Not affiliated with or endorsed by Microsoft. Practice questions are original and are not actual exam questions.
      </p>
    </div>
  </div>
  <div class="border-t border-default py-5 text-center text-xs text-muted">© {year} {SITE.org}. Microsoft, Azure and related marks are trademarks of the Microsoft group of companies.</div>
</footer>
