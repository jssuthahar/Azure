---
/** Predict before you learn: the situation, a guess, instant feedback, then the reveal (with an optional animated picture). */
import type { PredictActivity } from '../../data/activities';
import { inlineMd } from '../../lib/learn';
interface Props { a: PredictActivity }
const { a } = Astro.props;
const letters = 'ABCDEFGH';
const students = Array.from({ length: 12 }, (_, i) => ({ x: 22 + (i % 3) * 18, y: 38 + Math.floor(i / 3) * 24 }));
const reqs = Array.from({ length: 9 }, (_, i) => ({ y: 44 + (i % 5) * 18, d: (i * 0.23).toFixed(2) }));
---
<div class="ila-scenario"><span class="ila-label">The situation</span><p>{a.scenario}</p></div>

{a.visual === 'overload' && (
  <figure class="pr-vis" data-phase="idle">
    <svg viewBox="0 0 400 160" role="img" aria-label="Students sending login requests to the website's servers">
      {students.map((s) => <g class="pr-student"><circle cx={s.x} cy={s.y - 5} r="4" /><path d={`M${s.x - 6} ${s.y + 7} q6 -9 12 0`} /></g>)}
      <text x="40" y="150" text-anchor="middle" class="pr-txt">10,000 students</text>
      <g class="pr-reqs">{reqs.map((r) => <circle class="pr-req" cx="78" cy={r.y} r="4" style={`--d:${r.d}s`} />)}</g>
      <g class="pr-one">
        <rect class="pr-server" x="250" y="36" width="64" height="92" rx="7" />
        <line x1="260" y1="58" x2="304" y2="58" /><line x1="260" y1="76" x2="304" y2="76" /><line x1="260" y1="94" x2="304" y2="94" />
        <circle class="pr-led" cx="296" cy="114" r="4" />
        <text x="282" y="150" text-anchor="middle" class="pr-txt">1 server</text>
        <text x="282" y="28" text-anchor="middle" class="pr-crash">⚠ 503 errors</text>
      </g>
      <g class="pr-cloud">
        <path class="pr-cloudshape" d="M228 132 h150 a24 24 0 0 0 -6 -47 a34 34 0 0 0 -62 -22 a28 28 0 0 0 -50 18 a26 26 0 0 0 -32 51 z" />
        {[0, 1, 2, 3].map((i) => <rect class="pr-mini" x={252 + (i % 2) * 52} y={78 + Math.floor(i / 2) * 26} width="40" height="20" rx="4" />)}
        <text x="304" y="150" text-anchor="middle" class="pr-txt">4 cloud servers</text>
      </g>
    </svg>
    <figcaption class="pr-status" aria-live="polite">10,000 students. 1 server. The clock says 8:59.</figcaption>
  </figure>
)}

<p class="ila-q">{a.question}</p>
<div class="ila-opts" role="group" aria-label={a.question}>
  {a.options.map((o, i) => (
    <button type="button" class="ila-opt" data-i={i}>
      <span class="ila-letter" aria-hidden="true">{letters[i]}</span>
      <span class="min-w-0 flex-1"><span class="block">{o.text}</span><span class="ila-why" hidden>{o.why}</span></span>
    </button>
  ))}
</div>
<div class="pr-reveal ila-feedback" hidden>
  <p class="ila-verdict" aria-live="polite"></p>
  <p class="mt-2"><span class="ila-label">What really happens</span></p>
  <p set:html={inlineMd(a.reveal)} />
  {a.visual && (
    <div class="mt-3 flex flex-wrap gap-2">
      <button type="button" class="btn btn-accent btn-sm pr-play">▶ Replay 9:00 AM</button>
      <button type="button" class="btn btn-outline btn-sm pr-fix">☁️ Show the cloud fix</button>
    </div>
  )}
</div>

<script>
  import { config, finishActivity, nudge, reducedMotion } from '../../lib/activities';
  import type { PredictActivity } from '../../data/activities';

  document.querySelectorAll<HTMLElement>('[data-kind="predict"]').forEach((root) => {
    const a = config<PredictActivity>(root);
    const fig = root.querySelector<HTMLElement>('.pr-vis');
    const status = root.querySelector<HTMLElement>('.pr-status');
    const reveal = root.querySelector<HTMLElement>('.pr-reveal')!;
    const verdict = root.querySelector<HTMLElement>('.ila-verdict')!;
    let timer = 0;

    const phase = (p: string, text: string) => {
      if (!fig || !status) return;
      fig.dataset.phase = p;
      status.textContent = text;
    };
    const playCrash = () => {
      clearTimeout(timer);
      phase('flood', '9:00. Thousands of login requests arrive in the same second. The server queues them up…');
      timer = window.setTimeout(() => phase('crash', 'CPU at 100%. The server stops answering. Students see errors and the exam is delayed.'), reducedMotion() ? 0 : 2200);
    };

    root.querySelectorAll<HTMLButtonElement>('.ila-opt').forEach((btn) =>
      btn.addEventListener('click', () => {
        const pick = Number(btn.dataset.i);
        const ok = pick === a.answer;
        root.querySelectorAll<HTMLButtonElement>('.ila-opt').forEach((b) => {
          const i = Number(b.dataset.i);
          b.disabled = true;
          b.dataset.state = i === a.answer ? (i === pick ? 'correct' : 'missed') : i === pick ? 'wrong' : '';
          b.querySelector<HTMLElement>('.ila-why')!.hidden = false;
        });
        nudge(btn, ok);
        reveal.hidden = false;
        verdict.textContent = ok ? '✓ Good prediction. That is exactly what happens.' : `✕ Not quite. The answer is ${'ABCDEFGH'[a.answer]}. Read why under each option.`;
        verdict.className = `ila-verdict ${ok ? 'verdict-ok' : 'verdict-bad'}`;
        playCrash();
        // Predicting is the point, right or wrong, so the attempt itself completes the activity.
        finishActivity(root, 1, 1);
      }),
    );
    root.querySelector('.pr-play')?.addEventListener('click', playCrash);
    root.querySelector('.pr-fix')?.addEventListener('click', () => {
      clearTimeout(timer);
      phase('cloud', 'Cloud: 4 servers share the logins, so every student gets in. After the exam, 3 are handed back and stop costing money.');
    });
  });
</script>

<style>
  .pr-vis { margin-top: 1rem; border-radius: 0.75rem; border: 1px solid var(--card-line); background: linear-gradient(160deg, var(--pastel-blue), var(--card)); padding: 0.5rem 0.75rem 0.75rem; }
  .pr-vis svg { display: block; width: 100%; height: auto; max-height: 220px; }
  .pr-student circle { fill: var(--accent); }
  .pr-student path { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; }
  .pr-txt { font-size: 12px; font-weight: 650; fill: var(--text); }
  .pr-server, .pr-mini { fill: var(--card); stroke: var(--text-muted); stroke-width: 2; transition: fill 0.4s, stroke 0.4s; }
  .pr-one line { stroke: var(--text-muted); stroke-width: 2; }
  .pr-led { fill: var(--ok); }
  .pr-crash { font-size: 13px; font-weight: 800; fill: var(--bad); opacity: 0; }
  .pr-req { fill: #ffb900; opacity: 0; }
  .pr-cloud { opacity: 0; transition: opacity 0.4s; }
  .pr-cloudshape { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 2; }
  .pr-mini { stroke: var(--ok); fill: var(--ok-soft); }
  .pr-status { margin-top: 0.4rem; font-size: 0.92rem; font-weight: 600; line-height: 1.5; }

  [data-phase='flood'] .pr-req, [data-phase='crash'] .pr-req, [data-phase='cloud'] .pr-req { opacity: 1; animation: pr-fly 1.1s linear var(--d) infinite; }
  [data-phase='flood'] .pr-server { stroke: #c19c00; animation: pr-shake 0.3s linear infinite; }
  [data-phase='crash'] .pr-server { stroke: var(--bad); fill: var(--bad-soft); }
  [data-phase='crash'] .pr-led { fill: var(--bad); }
  [data-phase='crash'] .pr-crash { opacity: 1; }
  [data-phase='crash'] .pr-req { animation-name: pr-pile; }
  [data-phase='cloud'] .pr-one { opacity: 0; }
  [data-phase='cloud'] .pr-cloud { opacity: 1; }
  [data-phase='cloud'] .pr-req { fill: var(--ok); }
  @keyframes pr-fly { from { transform: translateX(0); opacity: 1; } 90% { opacity: 1; } to { transform: translateX(170px); opacity: 0; } }
  @keyframes pr-pile { from { transform: translateX(0); } to { transform: translateX(160px); } }
  @keyframes pr-shake { 50% { transform: translateX(1px); } }
  @media (prefers-reduced-motion: reduce) {
    .pr-vis * { animation: none !important; transition: none !important; }
    [data-phase] .pr-req { transform: translateX(120px); }
  }
</style>
