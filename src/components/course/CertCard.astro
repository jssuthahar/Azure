---
/**
 * Course card for one certification. Live exams link to their course details
 * page; planned exams say so plainly and point to Microsoft Learn instead of
 * an empty page.
 */
import CertIcon from './CertIcon.astro';
import { difficulty, type Certification } from '../../data/certifications';
interface Props { cert: Certification; lessons?: number; questions?: number; headingLevel?: 'h3' | 'h4' }
const { cert: c, lessons = 0, questions = 0, headingLevel = 'h3' } = Astro.props;
const live = c.status === 'active';
const H = headingLevel;
const features = live
  ? [`${lessons} lessons`, `${questions} practice questions`, '3D + portal simulations', 'Labs, mock exam, interview prep']
  : ['Lessons and quizzes', 'Simulations and labs', 'Mock exam', 'Interview prep'];
---
<article class={`cc cc-${c.level.toLowerCase()}`} data-cert={c.slug} data-level={c.level}>
  <div class="cc-art">
    <CertIcon icon={c.icon} size={44} />
    <span class="cc-code" aria-hidden="true">{c.code}</span>
  </div>
  <div class="cc-body">
    <p class="cc-meta">
      <span class="cc-pill">{difficulty(c)}</span>
      <span class={live ? 'cc-live' : 'cc-soon'}>{live ? '● Available now' : 'Coming soon'}</span>
    </p>
    <H class="cc-title"><span class="cc-exam">{c.code}</span> {c.name}</H>
    <p class="cc-text">{c.blurb}</p>
    <ul class="cc-feat" aria-label={live ? 'Included' : 'Planned'}>
      {features.map((f) => <li><span aria-hidden="true">{live ? '✓' : '○'}</span>{f}</li>)}
    </ul>
    <div class="cc-foot">
      {live ? (
        <a href={`/${c.slug}/`} class="btn btn-accent cc-btn">View course details <span aria-hidden="true">→</span></a>
      ) : (
        <a class="btn btn-outline cc-btn" target="_blank" rel="noopener">Coming Soon<span class="sr-only">on Microsoft Learn (opens in a new tab)</span><span aria-hidden="true">↗</span></a>
      )}
    </div>
  </div>
</article>

<style is:global>
  @layer components {
    .cc { display: flex; flex-direction: column; overflow: hidden; border-radius: 18px; border: 1px solid var(--card-line); background: var(--card); box-shadow: 0 1px 2px rgb(11 16 32 / .05); transition: transform .2s, box-shadow .2s, border-color .2s; height: 100%; }
    .cc:hover, .cc:focus-within { transform: translateY(-3px); box-shadow: 0 18px 40px -16px rgb(0 60 120 / .35); border-color: var(--accent); }
    .cc-art { position: relative; display: flex; align-items: flex-end; justify-content: space-between; height: 118px; padding: 18px 20px; color: #fff; background: linear-gradient(135deg, #0078d4, #004e8c); }
    .cc-art::after { content: ''; position: absolute; inset: 0; background: radial-gradient(120px 90px at 85% 15%, rgb(255 255 255 / .22), transparent 70%), radial-gradient(160px 120px at 10% 120%, rgb(255 255 255 / .14), transparent 70%); pointer-events: none; }
    .cc-associate .cc-art { background: linear-gradient(135deg, #5b3fb8, #2b5fd9); }
    .cc-expert .cc-art { background: linear-gradient(135deg, #0b5563, #106ebe); }
    .cc-specialty .cc-art { background: linear-gradient(135deg, #8a3b12, #c2410c); }
    .cc-code { font-size: 1.9rem; font-weight: 800; letter-spacing: -.02em; line-height: 1; text-shadow: 0 2px 10px rgb(0 0 0 / .2); }
    .cc-body { display: flex; flex: 1; flex-direction: column; padding: 18px 20px 20px; }
    .cc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: .78rem; font-weight: 600; }
    .cc-pill { border-radius: 999px; background: var(--pastel-blue); color: var(--accent-deep); padding: 3px 10px; }
    .cc-live { color: var(--ok); }
    .cc-soon { color: var(--text-muted); }
    .cc-title { margin-top: 10px; font-size: 1.12rem; font-weight: 700; line-height: 1.3; }
    .cc-exam { color: var(--accent-deep); }
    .cc-text { margin-top: 6px; font-size: .92rem; line-height: 1.55; color: var(--text-muted); }
    .cc-feat { margin-top: 12px; display: grid; gap: 4px; font-size: .86rem; }
    .cc-feat li { display: flex; gap: 8px; }
    .cc-feat span { color: var(--accent); font-weight: 700; }
    .cc-foot { margin-top: auto; padding-top: 16px; }
    .cc-btn { width: 100%; justify-content: center; min-height: 42px; }
  }
</style>
