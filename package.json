{
  "name": "azure-msdevbuild",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Azure certification learning platform (azure.msdevbuild.com) — starting with AZ-900.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:meta": "node scripts/check-meta.mjs",
    "check:questions": "node scripts/check-questions.mjs",
    "check:human": "node scripts/check-human.mjs",
    "check:all": "npm run check:meta && npm run check:questions && npm run check:human && astro build",
    "qa:seo": "python3 scripts/qa/seo-audit.py",
    "qa": "node scripts/qa/run.mjs",
    "verify": "npm run check:all && npm run qa:seo && npm run qa",
    "og": "node scripts/make-og.mjs",
    "icons": "node scripts/make-icons.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "5.18.2",
    "tailwindcss": "4.3.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/three": "0.185.4",
    "axe-core": "4.10.3",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  }
}
